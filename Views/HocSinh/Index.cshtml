<script>
    document.getElementById('studentProfileModal').addEventListener('show.bs.modal', function (event) {
        const source = event.relatedTarget;
        const setText = (id, value) => document.getElementById(id).textContent = value || 'Chưa cập nhật';

        document.getElementById('studentModalAvatar').src = source.dataset.avatar;
        document.getElementById('studentModalAvatar').alt = `Ảnh ${source.dataset.name}`;
        setText('studentProfileModalLabel', source.dataset.name);
        setText('studentModalClass', source.dataset.class);
        setText('studentModalClassDetail', source.dataset.class);
        setText('studentModalBirth', source.dataset.birth);
        setText('studentModalGender', source.dataset.gender);
        setText('studentModalAccount', source.dataset.account);
        setText('studentModalPhone', source.dataset.phone);
        setText('studentModalEmail', source.dataset.email);
        setText('studentModalAddress', source.dataset.address);

        const status = document.getElementById('studentModalStatus');
        status.textContent = source.dataset.status;
        status.classList.toggle('active', source.dataset.statusClass === 'active');
        status.classList.toggle('inactive', source.dataset.statusClass === 'inactive');
    });
</script>
