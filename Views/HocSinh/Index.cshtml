@model List<eSchool.ViewModels.HocSinhViewModel>

@{
    var roleId = Context.Session.GetInt32("RoleId");
    var isAdmin = roleId == SystemRoleIds.SystemAdmin;

Layout = isAdmin
    ? "~/Views/Shared/_AdminLayout.cshtml"
    : "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Quản lý học sinh";

    var danhSach = Model ?? new List<eSchool.ViewModels.HocSinhViewModel>();
    var dangHoc = danhSach.Count(x => x.TrangThai);
    var nghiHoc = danhSach.Count(x => !x.TrangThai && !x.DaTotNghiep);
    var soLop = danhSach.Where(x => !string.IsNullOrWhiteSpace(x.TenLop)).Select(x => x.TenLop).Distinct().Count();
    var coTaiKhoan = danhSach.Count(x => !string.IsNullOrWhiteSpace(x.TenTaiKhoan));
    var lopHocs = ViewBag.LopHocs as IEnumerable<eSchool.Models.LopHoc> ?? Enumerable.Empty<eSchool.Models.LopHoc>();
    int? selectedLopId = ViewBag.LopId is int lopId ? lopId : null;
    bool? selectedTrangThai = ViewBag.TrangThai is bool trangThai ? trangThai : null;
    string keyword = ViewBag.Keyword as string ?? string.Empty;
    var createForm = ViewBag.CreateHocSinhForm as eSchool.ViewModels.HocSinhViewModel
        ?? new eSchool.ViewModels.HocSinhViewModel();
}

<div class="student-management-page">
    @if (isAdmin)
    {
        <div class="student-admin-page">
            <div class="student-admin-hero">
                <div>
                    <span class="student-admin-eyebrow">Học sinh</span>
                    <h2>Quản lý học sinh</h2>
                    <p>Theo dõi hồ sơ, lớp học, trạng thái và tài khoản liên kết của học sinh trong hệ thống.</p>
                </div>

                <div class="d-none">
                    <!-- Nút Thêm đã được dời xuống phần .page-tools phía dưới bảng -->
                </div>
            </div>

            <div class="student-admin-stats">
                <div class="student-admin-stat-card">
                    <div class="student-admin-stat-icon blue">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div>
                        <span>Tổng học sinh</span>
                        <strong>@danhSach.Count</strong>
                    </div>
                </div>

                <div class="student-admin-stat-card">
                    <div class="student-admin-stat-icon green">
                        <i class="bi bi-person-check-fill"></i>
                    </div>
                    <div>
                        <span>Đang học</span>
                        <strong>@dangHoc</strong>
                    </div>
                </div>

                <div class="student-admin-stat-card">
                    <div class="student-admin-stat-icon red">
                        <i class="bi bi-person-x-fill"></i>
                    </div>
                    <div>
                        <span>Nghỉ học</span>
                        <strong>@nghiHoc</strong>
                    </div>
                </div>

                <div class="student-admin-stat-card">
                    <div class="student-admin-stat-icon purple">
                        <i class="bi bi-link-45deg"></i>
                    </div>
                    <div>
                        <span>Đã gắn tài khoản</span>
                        <strong>@coTaiKhoan</strong>
                    </div>
                </div>
            </div>

            <div class="collapse mb-4" id="createStudentForm">
                <div class="student-admin-card">
                    <div class="student-admin-card-head">
                        <div>
                            <h3>Thêm học sinh</h3>
                            <p>Nhập thông tin hồ sơ học sinh mới.</p>
                        </div>
                    </div>

                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        @await Html.PartialAsync("_Form", createForm)

                        <button class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>
                            Lưu học sinh
                        </button>
                    </form>
                </div>
            </div>

            <div class="modal fade" id="importStudentModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content student-admin-card p-0">
                        <form asp-action="ImportExcel" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <div class="modal-header border-0 pb-0">
                                <h5 class="modal-title">Nhập học sinh từ Excel</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p class="mb-3 text-muted">Vui lòng tải file mẫu để xem định dạng chuẩn trước khi nhập dữ liệu.</p>
                                <a asp-action="DownloadTemplate" class="btn btn-outline-success mb-4">
                                    <i class="bi bi-download me-1"></i> Tải file mẫu
                                </a>
                                
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Chọn file Excel (.xlsx)</label>
                                    <input type="file" name="file" class="form-control" accept=".xlsx" required />
                                </div>
                            </div>
                            <div class="modal-footer border-0 pt-0">
                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-upload me-1"></i> Nhập dữ liệu
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="student-admin-card">
                <div class="student-admin-card-head">
                    <div>
                        <h3>Danh sách học sinh</h3>
                        <p>@danhSach.Count hồ sơ đang có trong hệ thống</p>
                    </div>
                </div>

                <div class="page-tools d-flex justify-content-between align-items-center mb-4">
                    <form method="get" class="m-0 shadow-none border-0 bg-transparent p-0 flex-grow-1 d-flex gap-2">
                        <div class="input-group flex-grow-1">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                            <input name="keyword"
                                   value="@keyword"
                                   class="form-control border-start-0 ps-0"
                                   placeholder="Tìm theo họ tên, email hoặc số điện thoại..." />
                        </div>

                        @await Html.PartialAsync("_ExportDropdown")
                        <div class="dropdown filter-dropdown">
                            <button type="button" class="btn btn-outline-secondary h-100 px-3" data-bs-toggle="dropdown" data-bs-auto-close="outside">
                                <i class="bi bi-funnel"></i>
                            </button>
                            <div class="dropdown-menu shadow">
                                <h6 class="fw-bold mb-3 px-1">Bộ lọc</h6>
                                
                                <div class="mb-3">
                                    <label class="form-label small text-muted mb-1">Lớp</label>
                                    <select name="lopId" class="form-select form-select-sm">
                                        <option value="">Tất cả lớp</option>
                                        @foreach (var lop in lopHocs)
                                        {
                                            <option value="@lop.IdLop" selected="@(selectedLopId == lop.IdLop ? "selected" : null)">@lop.TenLop</option>
                                        }
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small text-muted mb-1">Trạng thái</label>
                                    <select name="trangThai" class="form-select form-select-sm">
                                        <option value="">Tất cả trạng thái</option>
                                        <option value="true" selected="@(selectedTrangThai == true ? "selected" : null)">Đang học</option>
                                        <option value="false" selected="@(selectedTrangThai == false ? "selected" : null)">Nghỉ học</option>
                                    </select>
                                </div>

                                <div class="d-flex justify-content-between gap-2 mt-4">
                                    <a asp-action="Index" class="btn btn-light btn-sm flex-grow-1">Đặt lại</a>
                                    <button type="submit" class="btn btn-primary btn-sm flex-grow-1">Áp dụng</button>
                                </div>
                            </div>
                        </div>
                    </form>

                    <div class="d-flex gap-2 ms-auto">
                        <button class="btn btn-success" type="button" data-bs-toggle="modal" data-bs-target="#importStudentModal">
                            <i class="bi bi-file-earmark-excel"></i>
                            Nhập từ Excel
                        </button>
                        <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#createStudentForm"
                                aria-expanded="false" aria-controls="createStudentForm">
                            <i class="bi bi-plus-lg"></i>
                            Thêm học sinh
                        </button>
                    </div>
                </div>

                <div class="app-table-wrapper">
                    <table class="table table-hover align-middle mb-0 app-table">
                        <thead class="app-table-header">
                            <tr>
                                <th class="text-center" style="width: 60px;">STT</th>
                                <th>Học sinh</th>
                                <th>Tài khoản</th>
                                <th>Ngày sinh</th>
                                <th>Giới tính</th>
                                <th>Lớp</th>
                                <th>Trạng thái</th>
                                <th class="text-center" style="width: 140px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!danhSach.Any())
                            {
                                <tr>
                                    <td colspan="8">
                                        <div class="student-admin-empty">
                                            <i class="bi bi-person-lines-fill"></i>
                                            <strong>Chưa có học sinh</strong>
                                            <span>Bạn có thể thêm hồ sơ học sinh mới từ nút phía trên.</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                int stt = 1;
                                @foreach (var item in danhSach)
                                {
                                    <tr>
                                        <td class="text-center text-muted fw-medium">@stt</td>
                                        <td>
                                            <button type="button" class="student-profile-link" title="Xem hồ sơ @item.HoTen"
                                                    data-bs-toggle="modal" data-bs-target="#studentProfileModal"
                                                    data-name="@item.HoTen"
                                                    data-avatar="@(string.IsNullOrWhiteSpace(item.AnhDaiDien) ? Url.Content("~/image/default-avatar.svg") : item.AnhDaiDien)"
                                                    data-birth="@item.NgaySinh.ToString("dd/MM/yyyy")"
                                                    data-gender="@(string.IsNullOrWhiteSpace(item.GioiTinh) ? "Chưa cập nhật" : item.GioiTinh)"
                                                    data-class="@(item.TenLop ?? "Chưa xếp lớp")"
                                                    data-phone="@(item.SDT ?? "Chưa cập nhật")"
                                                    data-email="@(item.Email ?? "Chưa cập nhật")"
                                                    data-address="@(item.DiaChi ?? "Chưa cập nhật")"
                                                    data-account="@(item.TenTaiKhoan ?? "Chưa liên kết")"
                                                    data-status="@(item.DaTotNghiep ? "Đã tốt nghiệp" : item.TrangThai ? "Đang học" : "Nghỉ học")"
                                                    data-status-class="@(item.TrangThai ? "active" : "inactive")">
                                                <div class="student-admin-profile">
                                                    <img src="@(string.IsNullOrWhiteSpace(item.AnhDaiDien) ? Url.Content("~/image/default-avatar.svg") : item.AnhDaiDien)"
                                                         alt="Ảnh @item.HoTen" />
                                                    <div>
                                                        <strong>@item.HoTen</strong>
                                                        <small>@(string.IsNullOrWhiteSpace(item.Email) ? "Chưa có email" : item.Email)</small>
                                                    </div>
                                                </div>
                                            </button>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(item.TenTaiKhoan))
                                            {
                                                <span class="badge bg-success">@item.TenTaiKhoan</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Chưa gắn</span>
                                            }
                                        </td>
                                        <td>@item.NgaySinh.ToString("dd/MM/yyyy")</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.GioiTinh) ? "-" : item.GioiTinh)</td>
                                        <td>
                                            <span class="badge bg-primary">
                                                @(item.TenLop ?? "Chưa xếp lớp")
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.DaTotNghiep) { <span class="badge bg-success">Đã tốt nghiệp</span> } else if (item.TrangThai)
                                            {
                                                <span class="badge bg-success">Đang học</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Nghỉ học</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="student-admin-actions">
                                                <a asp-action="Edit" asp-route-id="@item.IdHocSinh" class="student-admin-action edit" title="Sửa">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-controller="ChuyenLop" asp-action="Create" asp-route-id="@item.IdHocSinh" class="student-admin-action transfer" title="Chuyển lớp">
                                                    <i class="bi bi-arrow-left-right"></i>
                                                </a>
                                                <form asp-action="Delete" method="post" class="d-inline m-0 p-0"
                                                      onsubmit="return confirm('Bạn có chắc muốn chuyển học sinh này sang trạng thái nghỉ học?')">
                                                    <input type="hidden" name="id" value="@item.IdHocSinh" />
                                                    <button type="submit" class="student-admin-action delete" title="Nghỉ học">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    stt++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="student-hero">
            <div>
                <span class="student-eyebrow">Học sinh</span>
                <h2>Quản lý học sinh</h2>
                <p>Theo dõi hồ sơ, lớp học, trạng thái và thông tin liên hệ của học sinh trong hệ thống.</p>
            </div>
        </div>

        <div class="student-stat-grid">
            <div class="student-stat-card blue">
                <div class="student-stat-icon"><i class="bi bi-people-fill"></i></div>
                <div>
                    <span>Tổng học sinh</span>
                    <strong>@danhSach.Count</strong>
                </div>
            </div>

            <div class="student-stat-card green">
                <div class="student-stat-icon"><i class="bi bi-person-check-fill"></i></div>
                <div>
                    <span>Đang học</span>
                    <strong>@dangHoc</strong>
                </div>
            </div>

            <div class="student-stat-card red">
                <div class="student-stat-icon"><i class="bi bi-person-x-fill"></i></div>
                <div>
                    <span>Nghỉ học</span>
                    <strong>@nghiHoc</strong>
                </div>
            </div>

            <div class="student-stat-card purple">
                <div class="student-stat-icon"><i class="bi bi-building"></i></div>
                <div>
                    <span>Số lớp</span>
                    <strong>@soLop</strong>
                </div>
            </div>
        </div>

        <div class="student-list-card">
            <div class="student-list-head">
                <div>
                    <h3>Danh sách học sinh</h3>
                    <p>@danhSach.Count hồ sơ được tìm thấy</p>
                </div>
            </div>

            <form method="get" class="student-filter-bar">
                <div class="student-filter-search">
                    <i class="bi bi-search"></i>
                    <input name="keyword"
                           value="@keyword"
                           placeholder="Tìm theo họ tên, email hoặc số điện thoại..." />
                </div>

                <select name="lopId" class="student-filter-select">
                    <option value="">Tất cả lớp</option>
                    @foreach (var lop in lopHocs)
                    {
                        <option value="@lop.IdLop" selected="@(selectedLopId == lop.IdLop ? "selected" : null)">@lop.TenLop</option>
                    }
                </select>

                <select name="trangThai" class="student-filter-select">
                    <option value="">Tất cả trạng thái</option>
                    <option value="true" selected="@(selectedTrangThai == true ? "selected" : null)">Đang học</option>
                    <option value="false" selected="@(selectedTrangThai == false ? "selected" : null)">Nghỉ học</option>
                </select>

                <button type="submit" class="student-filter-btn">
                    <i class="bi bi-funnel"></i>
                    Lọc
                </button>

                <a asp-action="Index" class="student-reset-btn">Làm mới</a>
            </form>

            <div class="student-table-wrap">
                <table class="student-modern-table">
                    <thead>
                        <tr>
                            <th>Học sinh</th>
                            <th>Tài khoản</th>
                            <th>Ngày sinh</th>
                            <th>Giới tính</th>
                            <th>Lớp</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!danhSach.Any())
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="student-empty-state">
                                        <i class="bi bi-person-lines-fill"></i>
                                        <strong>Không có học sinh nào</strong>
                                        <span>Thử đổi bộ lọc hoặc thêm hồ sơ học sinh mới.</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in danhSach)
                            {
                                <tr>
                                    <td>
                                        <button type="button" class="student-profile-link" title="Xem hồ sơ @item.HoTen"
                                                data-bs-toggle="modal" data-bs-target="#studentProfileModal"
                                                data-name="@item.HoTen"
                                                data-avatar="@(string.IsNullOrWhiteSpace(item.AnhDaiDien) ? Url.Content("~/image/default-avatar.svg") : item.AnhDaiDien)"
                                                data-birth="@item.NgaySinh.ToString("dd/MM/yyyy")"
                                                data-gender="@(string.IsNullOrWhiteSpace(item.GioiTinh) ? "Chưa cập nhật" : item.GioiTinh)"
                                                data-class="@(item.TenLop ?? "Chưa xếp lớp")"
                                                data-phone="@(item.SDT ?? "Chưa cập nhật")"
                                                data-email="@(item.Email ?? "Chưa cập nhật")"
                                                data-address="@(item.DiaChi ?? "Chưa cập nhật")"
                                                data-account="@(item.TenTaiKhoan ?? "Chưa liên kết")"
                                                data-status="@(item.DaTotNghiep ? "Đã tốt nghiệp" : item.TrangThai ? "Đang học" : "Nghỉ học")"
                                                data-status-class="@(item.TrangThai ? "active" : "inactive")">
                                            <div class="student-profile-cell">
                                                <img src="@(string.IsNullOrWhiteSpace(item.AnhDaiDien) ? Url.Content("~/image/default-avatar.svg") : item.AnhDaiDien)"
                                                     alt="Ảnh @item.HoTen" />
                                                <div>
                                                    <strong>@item.HoTen</strong>
                                                    <span>@(string.IsNullOrWhiteSpace(item.Email) ? "Chưa có email" : item.Email)</span>
                                                </div>
                                            </div>
                                        </button>
                                    </td>
                                    <td>@(item.TenTaiKhoan ?? "Chưa gắn")</td>
                                    <td>@item.NgaySinh.ToString("dd/MM/yyyy")</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.GioiTinh) ? "-" : item.GioiTinh)</td>
                                    <td><span class="student-class-pill">@(item.TenLop ?? "Chưa xếp lớp")</span></td>
                                    <td>
                                        @if (item.DaTotNghiep) { <span class="badge bg-success">Đã tốt nghiệp</span> } else if (item.TrangThai)
                                        {
                                            <span class="student-status-pill active">Đang học</span>
                                        }
                                        else
                                        {
                                            <span class="student-status-pill inactive">Nghỉ học</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="studentProfileModal" tabindex="-1" aria-labelledby="studentProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content student-profile-modal">
            <div class="student-profile-modal-head">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                <img id="studentModalAvatar" src="@Url.Content("~/image/default-avatar.svg")" alt="Ảnh học sinh" />
                <div>
                    <span>Hồ sơ học sinh</span>
                    <h2 id="studentProfileModalLabel">Học sinh</h2>
                    <p id="studentModalClass">Chưa xếp lớp</p>
                </div>
                <strong id="studentModalStatus" class="student-modal-status active">Đang học</strong>
            </div>
            <div class="modal-body p-4">
                <div class="student-modal-grid">
                    <section>
                        <h3><i class="bi bi-person-vcard"></i> Thông tin cơ bản</h3>
                        <dl>
                            <div><dt>Ngày sinh</dt><dd id="studentModalBirth"></dd></div>
                            <div><dt>Giới tính</dt><dd id="studentModalGender"></dd></div>
                            <div><dt>Lớp học</dt><dd id="studentModalClassDetail"></dd></div>
                            <div><dt>Tài khoản</dt><dd id="studentModalAccount"></dd></div>
                        </dl>
                    </section>
                    <section>
                        <h3><i class="bi bi-telephone"></i> Liên hệ</h3>
                        <dl>
                            <div><dt>Số điện thoại</dt><dd id="studentModalPhone"></dd></div>
                            <div><dt>Email</dt><dd id="studentModalEmail"></dd></div>
                            <div class="student-modal-address"><dt>Địa chỉ</dt><dd id="studentModalAddress"></dd></div>
                        </dl>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .student-profile-link { display: block; width: 100%; padding: 0; color: inherit; border: 0; border-radius: 12px; background: transparent; font: inherit; text-align: left; text-decoration: none; cursor: pointer; transition: background-color .18s ease; }
    .student-profile-link:hover { color: inherit; background: rgba(37, 99, 235, .07); }
    .student-profile-link:focus-visible { outline: 3px solid rgba(59, 130, 246, .45); outline-offset: 2px; }
    .student-profile-modal { overflow: hidden; border: 0; border-radius: 18px; }
    .student-profile-modal-head { position: relative; display: flex; align-items: center; gap: 16px; padding: 24px 28px; color: #fff; background: linear-gradient(125deg, #1d4ed8, #2563eb 60%, #38bdf8); }
    .student-profile-modal-head .btn-close { position: absolute; top: 16px; right: 16px; opacity: .9; }
    .student-profile-modal-head img { width: 78px; height: 78px; border: 3px solid rgba(255,255,255,.75); border-radius: 50%; object-fit: cover; background: #fff; }
