@model List<eSchool.Models.KyLuat>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Kỷ luật học sinh";
    var lopHocs = ViewBag.LopHocs as List<eSchool.Models.LopHoc> ?? new List<eSchool.Models.LopHoc>();
    int? selectedLopId = ViewBag.LopId as int?;
    string keyword = ViewBag.Keyword as string ?? "";
}

<style>
    .filter-wrapper {
        min-height: 70vh;
        background: radial-gradient(circle at top right, rgba(238, 242, 247, 0.6), transparent),
                    radial-gradient(circle at bottom left, rgba(226, 232, 240, 0.4), transparent);
        border-radius: 1.5rem;
        margin-bottom: 2rem;
    }
    .filter-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 20px 40px rgba(0,0,0,0.04), 0 1px 3px rgba(0,0,0,0.02);
        border-radius: 24px;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .filter-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 25px 50px rgba(0,0,0,0.07), 0 5px 15px rgba(0,0,0,0.03);
    }
    .icon-wrapper {
        width: 85px; 
        height: 85px; 
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 25px;
        box-shadow: 0 10px 25px rgba(118, 75, 162, 0.3);
        transform: rotate(-3deg);
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .filter-card:hover .icon-wrapper {
        transform: rotate(0deg) scale(1.05);
    }
    .icon-wrapper i {
        color: #fff;
        font-size: 2.2rem;
        text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }
    .custom-floating > .form-select {
        height: 3.8rem;
        border-radius: 14px;
        border: 2px solid #e2e8f0;
        background-color: #f8fafc;
        font-weight: 500;
        color: #334155;
        transition: all 0.3s ease;
        padding-top: 1.625rem;
        padding-bottom: 0.625rem;
    }
    .custom-floating > .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.15);
        background-color: #ffffff;
    }
    .custom-floating > label {
        color: #64748b;
        font-weight: 500;
        padding-left: 1rem;
    }
    .btn-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        border-radius: 14px;
        padding: 14px 20px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        font-size: 0.95rem;
    }
    .btn-gradient:hover {
        background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
        box-shadow: 0 8px 20px rgba(118, 75, 162, 0.35);
        transform: translateY(-2px);
        color: white;
    }
    .btn-gradient:active {
        transform: translateY(0);
        box-shadow: 0 4px 10px rgba(118, 75, 162, 0.3);
    }
</style>

    <div class="d-flex align-items-center justify-content-center filter-wrapper py-5" style="@(ViewBag.FilterLopId != null ? "min-height: auto;" : "")">
        <div class="filter-card p-5 text-center" style="max-width: 800px; width: 100%; margin: 0 15px;">
            <div class="icon-wrapper">
                <i class="bi bi-shield-exclamation"></i>
            </div>
            <h3 class="fw-bolder text-dark mb-2" style="letter-spacing: -0.5px;">Kỷ Luật Học Sinh</h3>
            <p class="text-muted mb-4 pb-2" style="font-size: 0.95rem;">Lựa chọn thông tin để hiển thị danh sách kỷ luật của học sinh.</p>

            <form method="get">
                <div class="row g-3 text-start mb-4">
                    <div class="col-md-4">
                        <div class="form-floating custom-floating">
                            <select name="namHoc" asp-items="ViewBag.NamHocs" class="form-select" id="namHocSelect" required>
                                <option value="" disabled selected>-- Chọn năm học --</option>
                            </select>
                            <label for="namHocSelect"><i class="bi bi-clock-history me-1 text-primary"></i> Năm học</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating custom-floating">
                            <select name="hocKy" asp-items="ViewBag.HocKys" class="form-select" id="hocKySelect" required>
                                <option value="" disabled selected>-- Chọn học kỳ --</option>
                            </select>
                            <label for="hocKySelect"><i class="bi bi-calendar-check me-1 text-primary"></i> Học kỳ</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating custom-floating">
                            <select name="lopId" asp-items="ViewBag.LopHocs" class="form-select" id="lopSelect" required>
                                <option value="" disabled selected>-- Chọn lớp học --</option>
                            </select>
                            <label for="lopSelect"><i class="bi bi-people-fill me-1 text-primary"></i> Lớp học</label>
                        </div>
                    </div>
                </div>
                
                <button type="submit" class="btn btn-gradient btn-lg w-100 mt-2">
                    <i class="bi bi-search me-2"></i> Hiển thị danh sách
                </button>
            </form>
        </div>
    </div>
@if (ViewBag.FilterLopId != null && !string.IsNullOrEmpty(ViewBag.FilterNamHoc) && !string.IsNullOrEmpty(ViewBag.FilterHocKy))
{
    <div class="student-management-page">
        <div class="student-admin-page">
            <div class="student-admin-hero">
                <div>
                    <span class="student-admin-eyebrow">Học sinh</span>
                    <h2>Kỷ luật học sinh</h2>
                    @{
                        var selectedLop = (ViewBag.LopHocs as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)?.FirstOrDefault(x => x.Value == ViewBag.FilterLopId?.ToString());
                    }
                    <p>Đang hiển thị danh sách kỷ luật của lớp <strong>@(selectedLop?.Text ?? "")</strong> (Năm học @ViewBag.FilterNamHoc, @ViewBag.FilterHocKy).</p>
                </div>
            </div>

            <div class="student-admin-card">
                <div class="student-admin-card-head d-flex justify-content-between align-items-center w-100">
                    <div>
                        <h3>Danh sách kỷ luật</h3>
                        <p>@Model.Count bản ghi được tìm thấy</p>
                    </div>
                    <a href="/HocSinh/KyLuat" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i> Chọn lớp khác
                    </a>
                </div>

                <form method="get" class="student-admin-filter">
                    <input type="hidden" name="namHoc" value="@ViewBag.FilterNamHoc" />
                    <input type="hidden" name="hocKy" value="@ViewBag.FilterHocKy" />
                    <input type="hidden" name="lopId" value="@ViewBag.FilterLopId" />
                    
                    <div class="student-admin-search">
                        <i class="bi bi-search"></i>
                        <input name="keyword"
                               value="@keyword"
                               placeholder="Tìm theo mã HS, tên HS, lý do..." />
                    </div>

                    <button type="submit" class="student-admin-filter-btn">
                        <i class="bi bi-funnel"></i>
                        Lọc
                    </button>

                    <a href="/HocSinh/KyLuat?namHoc=@ViewBag.FilterNamHoc&hocKy=@ViewBag.FilterHocKy&lopId=@ViewBag.FilterLopId" class="student-admin-reset-btn">Làm mới</a>
                </form>

                <div class="student-admin-table-wrap">
                <table class="student-admin-table">
                    <thead>
                        <tr>
                            <th>Học sinh</th>
                            <th>Mã HS</th>
                            <th>Lớp</th>
                            <th>Ngày vi phạm</th>
                            <th>Hình thức</th>
                            <th>Lý do</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="student-admin-empty">
                                        <i class="bi bi-shield-check"></i>
                                        <strong>Không có kỷ luật nào</strong>
                                        <span>Không tìm thấy biên bản kỷ luật phù hợp với bộ lọc.</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="student-admin-profile">
                                            <img src="@(string.IsNullOrWhiteSpace(item.HocSinh?.AnhDaiDien) ? Url.Content("~/image/default-avatar.svg") : item.HocSinh.AnhDaiDien)"
                                                 alt="Ảnh @item.HocSinh?.HoTen" />
                                            <div>
                                                <strong>@item.HocSinh?.HoTen</strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="student-admin-code">@item.HocSinh?.MaHS</span></td>
                                    <td><span class="student-admin-class">@(item.HocSinh?.LopHoc?.TenLop ?? "")</span></td>
                                    <td>@item.NgayViPham.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @{
                                            var badgeClass = item.HinhThuc.Contains("Đình chỉ") ? "student-admin-badge unlinked" : 
                                                            item.HinhThuc.Contains("Cảnh cáo") ? "student-admin-badge" : "student-admin-badge linked";
                                        }
                                        <span class="@badgeClass">@item.HinhThuc</span>
                                    </td>
                                    <td style="max-width: 250px;" class="text-truncate" title="@item.LyDo">@item.LyDo</td>
                                    <td>
                                        <div class="student-admin-actions justify-content-center">
                                            <form asp-action="XoaKyLuat" method="post" class="d-inline"
                                                  onsubmit="return confirm('Bạn có chắc muốn xóa biên bản kỷ luật này?')">
                                                <input type="hidden" name="id" value="@item.IdKyLuat" />
                                                <button type="submit" class="student-admin-action delete" title="Xóa">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
}
