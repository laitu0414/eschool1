@model List<eSchool.Models.KyLuat>

@{
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    ViewData["Title"] = "Quản lý Kỷ luật";
    var dsHocSinh = ViewBag.DanhSachHocSinh as List<SelectListItem> ?? new List<SelectListItem>();
    var dsLopCN = ViewBag.DanhSachLop as List<eSchool.Models.LopHoc> ?? new List<eSchool.Models.LopHoc>();
}

<div class="page-card mb-4">
    <div class="page-tools d-flex justify-content-between align-items-center">
        <div>
            <h5 class="mb-0 text-primary"><i class="bi bi-shield-exclamation"></i> Kỷ luật lớp chủ nhiệm</h5>
            <small class="text-muted">
                Bạn đang chủ nhiệm: @if(dsLopCN.Any()) { string.Join(", ", dsLopCN.Select(x => x.TenLop)); } else { <span>Không có lớp chủ nhiệm</span> }
            </small>
        </div>
        <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#createKyLuat" @(dsHocSinh.Any() ? "" : "disabled")>
            <i class="bi bi-plus-circle"></i> Thêm biên bản kỷ luật
        </button>
    </div>
</div>

<div class="table-responsive bg-white rounded shadow-sm border border-light">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th class="ps-4">Học sinh</th>
                <th>Lớp</th>
                <th>Ngày vi phạm</th>
                <th>Hình thức</th>
                <th>Lý do</th>
                <th class="text-end pe-4">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="6" class="text-center text-muted py-5">Không có bản ghi kỷ luật nào trong lớp chủ nhiệm của bạn.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="ps-4">
                        <div class="fw-bold text-dark">@(item.HocSinh?.HoTen ?? "N/A")</div>
                        <small class="text-muted">@(item.HocSinh?.MaHS)</small>
                    </td>
                    <td>
                        <span class="badge bg-secondary">@(item.HocSinh?.LopHoc?.TenLop ?? "")</span>
                    </td>
                    <td>@item.NgayViPham.ToString("dd/MM/yyyy")</td>
                    <td>
                        @{
                            var badgeClass = item.HinhThuc.Contains("Đình chỉ") ? "bg-danger" : 
                                            item.HinhThuc.Contains("Cảnh cáo") ? "bg-warning text-dark" : "bg-info text-dark";
                        }
                        <span class="badge @badgeClass">@item.HinhThuc</span>
                    </td>
                    <td style="max-width: 250px;" class="text-truncate" title="@item.LyDo">@item.LyDo</td>
                    <td class="text-end pe-4">
                        <form asp-action="XoaKyLuat" asp-route-id="@item.IdKyLuat" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa biên bản kỷ luật này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Xóa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Thêm -->
<div class="modal fade" id="createKyLuat" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="ThemKyLuat" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i>Lập biên bản kỷ luật</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label fw-medium">Chọn Học sinh vi phạm <span class="text-danger">*</span></label>
                            <select name="IdHocSinh" asp-items="dsHocSinh" class="form-select" required>
                                <option value="">-- Chọn học sinh --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Ngày vi phạm <span class="text-danger">*</span></label>
                            <input type="date" name="NgayViPham" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Hình thức kỷ luật <span class="text-danger">*</span></label>
                            <select name="HinhThuc" class="form-select" required>
                                <option value="Khiển trách trước lớp">Khiển trách trước lớp</option>
                                <option value="Khiển trách trước hội đồng">Khiển trách trước hội đồng kỷ luật</option>
                                <option value="Cảnh cáo toàn trường">Cảnh cáo toàn trường</option>
                                <option value="Đình chỉ học tập (có thời hạn)">Đình chỉ học tập (có thời hạn)</option>
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-medium">Lý do vi phạm <span class="text-danger">*</span></label>
                            <textarea name="LyDo" class="form-control" rows="3" placeholder="Ghi rõ hành vi vi phạm..." required></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger">Lưu biên bản</button>
                </div>
            </form>
        </div>
    </div>
</div>
