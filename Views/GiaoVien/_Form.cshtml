@model eSchool.ViewModels.GiaoVienFormViewModel

<div class="row g-3 teacher-admin-form">
    <div class="col-md-4">
        <label class="form-label">Mã giáo viên <span class="text-danger">*</span></label>
        <input asp-for="MaGV" class="form-control" required maxlength="20" placeholder="VD: GV001" />
        <span asp-validation-for="MaGV" class="text-danger"></span>
    </div>

    <div class="col-md-8">
        <label class="form-label">Họ tên <span class="text-danger">*</span></label>
        <input asp-for="HoTen" class="form-control" required maxlength="100" placeholder="Nhập họ tên giáo viên" />
        <span asp-validation-for="HoTen" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label class="form-label">Ngày sinh <span class="text-danger">*</span></label>
        <input asp-for="NgaySinh"
               type="date"
               class="form-control"
               required
               max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="NgaySinh" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label class="form-label">Giới tính</label>
        <select asp-for="GioiTinh" class="form-select">
            <option value="">-- Chọn giới tính --</option>
            <option value="Nam">Nam</option>
            <option value="Nữ">Nữ</option>
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label">Số điện thoại</label>
        <input asp-for="SDT" class="form-control" maxlength="15" placeholder="0xxxxxxxxx" />
        <span asp-validation-for="SDT" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label class="form-label">Email</label>
        <input asp-for="Email" type="email" class="form-control" maxlength="100" placeholder="giaovien@email.com" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label class="form-label">Địa chỉ</label>
        <input asp-for="DiaChi" class="form-control" maxlength="255" placeholder="Nhập địa chỉ liên hệ" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Môn dạy <span class="text-danger">*</span></label>
        <select asp-for="IdMonHoc" asp-items="ViewBag.MonHocs" class="form-select">
            <option value="">-- Chọn môn dạy --</option>
        </select>
        <span asp-validation-for="IdMonHoc" class="text-danger"></span>
    </div>
</div>
