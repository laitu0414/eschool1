@model eSchool.ViewModels.GiaoVienFormViewModel

<div class="row g-3 teacher-admin-form">
    <div class="col-12 text-center mb-2">
        @{
            var teacherPreview = string.IsNullOrWhiteSpace(Model.AnhDaiDien)
                ? Url.Content("~/image/default-avatar.svg")
                : Model.AnhDaiDien;
        }
        <img src="@teacherPreview"
             data-teacher-image-preview
             alt="Ảnh giáo viên"
             style="width:120px;height:120px;border-radius:50%;object-fit:cover;border:3px solid #dbeafe;background:#fff;" />
        <div class="mx-auto mt-3" style="max-width:520px;">
            <label asp-for="AnhTaiLen" class="form-label">Ảnh giáo viên</label>
            <input asp-for="AnhTaiLen"
                   type="file"
                   class="form-control"
                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                   onchange="if(this.files && this.files[0]) this.closest('.teacher-admin-form').querySelector('[data-teacher-image-preview]').src = URL.createObjectURL(this.files[0])" />
            <span asp-validation-for="AnhTaiLen" class="text-danger"></span>
            <small class="text-muted d-block mt-1">JPG, PNG hoặc WebP, tối đa 5 MB.</small>
        </div>
    </div>

    <div class="col-md-4">
        <label class="form-label">Họ tên <span class="text-danger">*</span></label>
        <input asp-for="HoTen" class="form-control" required maxlength="100" placeholder="Nhập họ tên giáo viên" />
        <span asp-validation-for="HoTen" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label class="form-label">Ngày sinh <span class="text-danger">*</span></label>
        <input asp-for="NgaySinh"
               type="date"
               class="form-control"
               required
               max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="NgaySinh" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label class="form-label">Giới tính</label>
        <select asp-for="GioiTinh" class="form-select">
            <option value="">-- Chọn giới tính --</option>
            <option value="Nam">Nam</option>
            <option value="Nữ">Nữ</option>
        </select>
    </div>

    <div class="col-md-4">
        <label class="form-label">Số điện thoại đăng nhập <span class="text-danger">*</span></label>
        <input asp-for="SDT" type="tel" class="form-control" inputmode="numeric" pattern="0[0-9]{9}" minlength="10" maxlength="10" autocomplete="tel" required placeholder="0xxxxxxxxx" oninput="this.value = this.value.replace(/\D/g, '').slice(0, 10)" />
        <span asp-validation-for="SDT" class="text-danger"></span>
        <small class="text-muted">Gồm đúng 10 chữ số, bắt đầu bằng 0.</small>
    </div>

    <div class="col-md-4">
        <label class="form-label">Email <span class="text-danger">*</span></label>
        <input asp-for="Email" type="email" class="form-control" maxlength="100" autocomplete="email" required placeholder="giaovien@email.com" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label class="form-label">Địa chỉ</label>
        <input asp-for="DiaChi" class="form-control" maxlength="255" placeholder="Nhập địa chỉ liên hệ" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Môn dạy <span class="text-danger">*</span></label>
        <select asp-for="IdMonHoc" asp-items="ViewBag.MonHocs" class="form-select">
            <option value="">-- Chọn môn dạy --</option>
        </select>
        <span asp-validation-for="IdMonHoc" class="text-danger"></span>
    </div>
</div>
