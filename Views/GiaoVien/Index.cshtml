@model List<eSchool.Models.GiaoVien>

@{
      var roleId = Context.Session.GetInt32("RoleId");
    var isAdmin = roleId == SystemRoleIds.SystemAdmin;

Layout = isAdmin
    ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_TeacherLayout.cshtml";
    ViewData["Title"] = "Quản lý giáo viên";

    var danhSach = Model ?? new List<eSchool.Models.GiaoVien>();
    var tongGiaoVien = danhSach.Count;
    var coEmail = danhSach.Count(x => !string.IsNullOrWhiteSpace(x.Email));
    var coSoDienThoai = danhSach.Count(x => !string.IsNullOrWhiteSpace(x.SDT));
    var daLienKetTaiKhoan = danhSach.Count(x => x.IdTaiKhoan.HasValue);
}

<div class="modal fade" id="teacherProfileModal" tabindex="-1" aria-labelledby="teacherProfileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content teacher-profile-modal">
            <div class="teacher-profile-modal-head">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
                <img id="teacherModalAvatar" class="teacher-modal-avatar" src="@Url.Content("~/image/default-avatar.svg")" alt="Ảnh giáo viên" />
                <div class="teacher-modal-heading">
                    <span>Hồ sơ giáo viên</span>
                    <h2 id="teacherProfileModalLabel">Giáo viên</h2>
                    <p id="teacherModalSubject">Chưa phân môn</p>
                </div>
                <strong id="teacherModalAccountStatus" class="teacher-modal-account linked">Đã liên kết</strong>
            </div>
            <div class="modal-body p-4">
                <div class="teacher-modal-grid">
                    <section>
                        <h3><i class="bi bi-person-vcard"></i> Thông tin cơ bản</h3>
                        <dl>
                            <div><dt>Ngày sinh</dt><dd id="teacherModalBirth"></dd></div>
                            <div><dt>Giới tính</dt><dd id="teacherModalGender"></dd></div>
                            <div><dt>Môn giảng dạy</dt><dd id="teacherModalSubjectDetail"></dd></div>
                        </dl>
                    </section>
                    <section>
                        <h3><i class="bi bi-telephone"></i> Thông tin liên hệ</h3>
                        <dl>
                            <div><dt>Số điện thoại</dt><dd id="teacherModalPhone"></dd></div>
                            <div><dt>Email</dt><dd id="teacherModalEmail"></dd></div>
                            <div class="teacher-modal-address"><dt>Địa chỉ</dt><dd id="teacherModalAddress"></dd></div>
                        </dl>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .teacher-profile-trigger { display: block; width: 100%; padding: 0; color: inherit; border: 0; border-radius: 12px; background: transparent; font: inherit; text-align: left; cursor: pointer; transition: background-color .18s ease; }
    .teacher-profile-trigger:hover { color: inherit; background: rgba(37, 99, 235, .07); }
    .teacher-profile-trigger:focus-visible { outline: 3px solid rgba(59, 130, 246, .42); outline-offset: 2px; }
    .teacher-admin-profile img { width: 42px; height: 42px; flex: 0 0 42px; border-radius: 14px; object-fit: cover; background: #dbeafe; }
    .teacher-name img { width: 38px; height: 38px; flex: 0 0 38px; border-radius: 11px; object-fit: cover; background: #ccfbf1; }
    .teacher-profile-modal { overflow: hidden; border: 0; border-radius: 18px; box-shadow: 0 24px 60px rgba(15, 23, 42, .2); }
    .teacher-profile-modal-head { position: relative; display: flex; align-items: center; gap: 17px; padding: 25px 28px; color: #fff; background: linear-gradient(125deg, #4338ca, #2563eb 58%, #06b6d4); }
    .teacher-profile-modal-head .btn-close { position: absolute; top: 16px; right: 16px; opacity: .9; }
    .teacher-modal-avatar { flex: 0 0 78px; width: 78px; height: 78px; border: 3px solid rgba(255,255,255,.78); border-radius: 50%; background: #fff; object-fit: cover; }
    .teacher-modal-heading > span { font-size: .76rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; opacity: .78; }
    .teacher-modal-heading h2 { margin: 3px 0; font-size: 1.5rem; font-weight: 750; }
    .teacher-modal-heading p { margin: 0; opacity: .88; }
    .teacher-modal-account { margin-left: auto; padding: 7px 12px; border-radius: 999px; background: rgba(255,255,255,.21); white-space: nowrap; }
    .teacher-modal-account.unlinked { background: rgba(127,29,29,.45); }
    .teacher-modal-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
    .teacher-modal-grid h3 { margin: 0 0 13px; color: #1e3a8a; font-size: 1rem; font-weight: 750; }
    .teacher-modal-grid h3 i { margin-right: 6px; color: #2563eb; }
    .teacher-modal-grid dl { margin: 0; }
    .teacher-modal-grid dl > div { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 12px; padding: 10px 0; border-bottom: 1px solid #eef2f7; }
    .teacher-modal-grid dl > div:last-child { border-bottom: 0; }
    .teacher-modal-grid dt { color: #64748b; font-weight: 600; }
    .teacher-modal-grid dd { margin: 0; color: #172554; font-weight: 650; overflow-wrap: anywhere; }
    .teacher-modal-address dd { font-weight: 500; }
    @@media (max-width: 600px) { .teacher-profile-modal-head { align-items: flex-start; padding: 22px 20px 54px; } .teacher-modal-avatar { flex-basis: 64px; width: 64px; height: 64px; } .teacher-modal-account { position: absolute; right: 18px; bottom: 14px; } .teacher-modal-grid { grid-template-columns: 1fr; gap: 20px; } .teacher-modal-grid dl > div { grid-template-columns: 1fr; gap: 3px; } }
</style>

<script>
    document.getElementById('teacherProfileModal').addEventListener('show.bs.modal', function (event) {
        const source = event.relatedTarget;
        if (!source) return;

        const setText = (id, value) => {
            document.getElementById(id).textContent = value || 'Chưa cập nhật';
        };

        const avatar = document.getElementById('teacherModalAvatar');
        avatar.src = source.dataset.avatar;
        avatar.alt = `Ảnh ${source.dataset.name}`;
        setText('teacherProfileModalLabel', source.dataset.name);
        setText('teacherModalSubject', source.dataset.subject);
        setText('teacherModalSubjectDetail', source.dataset.subject);
        setText('teacherModalBirth', source.dataset.birth);
        setText('teacherModalGender', source.dataset.gender);
        setText('teacherModalPhone', source.dataset.phone);
        setText('teacherModalEmail', source.dataset.email);
        setText('teacherModalAddress', source.dataset.address);

        const accountStatus = document.getElementById('teacherModalAccountStatus');
        accountStatus.textContent = source.dataset.account;
        accountStatus.classList.toggle('linked', source.dataset.account === 'Đã liên kết');
        accountStatus.classList.toggle('unlinked', source.dataset.account !== 'Đã liên kết');
    });
</script>

@if (isAdmin)
{
    <div class="teacher-admin-page">
        <div class="teacher-admin-hero">
            <div>
                <span class="teacher-admin-eyebrow">Giáo viên</span>
                <h2>Quản lý giáo viên</h2>
                <p>Theo dõi hồ sơ, thông tin liên hệ và tài khoản liên kết của đội ngũ giáo viên.</p>
            </div>

            <div class="d-flex gap-2">
                <button class="teacher-admin-primary" data-bs-toggle="modal" data-bs-target="#createTeacherModal">
                    <i class="bi bi-plus-lg"></i>
                    Thêm giáo viên
                </button>
                <button class="teacher-admin-primary bg-success border-success" data-bs-toggle="modal" data-bs-target="#importTeacherModal">
                    <i class="bi bi-file-earmark-excel"></i>
                    Nhập từ Excel
                </button>
            </div>
        </div>

        <div class="teacher-admin-stats">
            <div class="teacher-admin-stat-card">
                <div class="teacher-admin-stat-icon blue">
                    <i class="bi bi-person-video3"></i>
                </div>
                <div>
                    <span>Tổng giáo viên</span>
                    <strong>@tongGiaoVien</strong>
                </div>
            </div>

            <div class="teacher-admin-stat-card">
                <div class="teacher-admin-stat-icon green">
                    <i class="bi bi-envelope-check"></i>
                </div>
                <div>
                    <span>Có email</span>
                    <strong>@coEmail</strong>
                </div>
            </div>

            <div class="teacher-admin-stat-card">
                <div class="teacher-admin-stat-icon orange">
                    <i class="bi bi-telephone"></i>
                </div>
                <div>
                    <span>Có số điện thoại</span>
                    <strong>@coSoDienThoai</strong>
                </div>
            </div>

            <div class="teacher-admin-stat-card">
                <div class="teacher-admin-stat-icon purple">
                    <i class="bi bi-link-45deg"></i>
                </div>
                <div>
                    <span>Đã liên kết tài khoản</span>
                    <strong>@daLienKetTaiKhoan</strong>
                </div>
            </div>
        </div>

        <div class="teacher-admin-card">
            <div class="teacher-admin-card-head">
                <div>
                    <h3>Danh sách giáo viên</h3>
                    <p>@tongGiaoVien hồ sơ đang có trong hệ thống</p>
                </div>
            </div>

            <form method="get" class="teacher-admin-filter">
                <div class="teacher-admin-search">
                    <i class="bi bi-search"></i>
                    <input name="keyword"
                           value="@ViewBag.Keyword"
                           placeholder="Tìm theo họ tên, email hoặc số điện thoại..." />
                </div>

                <button class="teacher-admin-filter-btn">
                    <i class="bi bi-funnel"></i>
                    Tìm
                </button>

                <a asp-action="Index" class="teacher-admin-reset-btn">Làm mới</a>
            </form>

            <div class="teacher-admin-table-wrap">
                <table class="teacher-admin-table">
                    <thead>
                        <tr>
                            <th>Giáo viên</th>
                            <th>Môn dạy</th>
                            <th>Ngày sinh</th>
                            <th>Giới tính</th>
                            <th>Tài khoản</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!danhSach.Any())
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="teacher-admin-empty">
                                        <i class="bi bi-person-workspace"></i>
                                        <strong>Chưa có giáo viên</strong>
                                        <span>Bạn có thể thêm hồ sơ giáo viên mới từ nút phía trên.</span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in danhSach)
                            {
                                <tr>
                                    <td>
                                        <button type="button" class="teacher-profile-trigger" title="Xem hồ sơ @item.HoTen"
                                                data-bs-toggle="modal" data-bs-target="#teacherProfileModal"
                                                data-name="@item.HoTen"
                                                data-avatar="@(string.IsNullOrWhiteSpace(item.AnhDaiDien) ? Url.Content("~/image/default-avatar.svg") : item.AnhDaiDien)"
                                                data-subject="@(item.MonHoc?.TenMon ?? "Chưa phân môn")"
                                                data-birth="@item.NgaySinh.ToString("dd/MM/yyyy")"
                                                data-gender="@(string.IsNullOrWhiteSpace(item.GioiTinh) ? "Chưa cập nhật" : item.GioiTinh)"
                                                data-phone="@(item.SDT ?? "Chưa cập nhật")"
                                                data-email="@(item.Email ?? "Chưa cập nhật")"
                                                data-address="@(item.DiaChi ?? "Chưa cập nhật")"
                                                data-account="@(item.IdTaiKhoan.HasValue ? "Đã liên kết" : "Chưa liên kết")">
                                            <div class="teacher-admin-profile">
                                                <img src="@(string.IsNullOrWhiteSpace(item.AnhDaiDien) ? Url.Content("~/image/default-avatar.svg") : item.AnhDaiDien)" alt="Ảnh @item.HoTen" />
                                                <div>
                                                    <strong>@item.HoTen</strong>
                                                    <small>@(string.IsNullOrWhiteSpace(item.Email) ? "Chưa có email" : item.Email)</small>
                                                </div>
                                            </div>
                                        </button>
                                    </td>
                                    <td><span class="badge bg-info text-dark">@(item.MonHoc?.TenMon ?? "Chưa phân môn")</span></td>
                                    <td>@item.NgaySinh.ToString("dd/MM/yyyy")</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.GioiTinh) ? "-" : item.GioiTinh)</td>
                                    <td>
                                        @if (item.IdTaiKhoan.HasValue)
                                        {
                                            <span class="teacher-admin-badge linked">Đã liên kết</span>
                                        }
                                        else
                                        {
                                            <span class="teacher-admin-badge unlinked">Chưa liên kết</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="teacher-admin-actions">
                                            <button type="button"
                                                    class="teacher-admin-action edit"
                                                    title="Sửa"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editTeacherModal-@item.IdGiaoVien">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form asp-action="Delete"
                                                  asp-route-id="@item.IdGiaoVien"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Xóa giáo viên này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="teacher-admin-action delete" title="Xóa">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>

                                <div class="modal fade" id="editTeacherModal-@item.IdGiaoVien" tabindex="-1">
                                    <div class="modal-dialog modal-lg modal-dialog-centered">
                                        <div class="modal-content teacher-admin-modal">
                                            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="IdGiaoVien" value="@item.IdGiaoVien" />
                                                <div class="modal-header">
                                                    <div>
                                                        <h5 class="modal-title">Sửa giáo viên</h5>
                                                        <small>Cập nhật lại thông tin hồ sơ giáo viên.</small>
                                                    </div>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    @await Html.PartialAsync("_Form", new eSchool.ViewModels.GiaoVienFormViewModel
                                                    {
                                                        IdGiaoVien = item.IdGiaoVien,
                                                        MaGV = item.MaGV,
                                                        HoTen = item.HoTen,
                                                        NgaySinh = item.NgaySinh,
                                                        GioiTinh = item.GioiTinh,
                                                        SDT = item.SDT,
                                                        Email = item.Email,
                                                        DiaChi = item.DiaChi,
                                                        AnhDaiDien = item.AnhDaiDien,
                                                        IdMonHoc = item.IdMonHoc
                                                    })
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                                                    <button class="btn btn-primary">Cập nhật</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal fade" id="createTeacherModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content teacher-admin-modal">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title">Thêm giáo viên</h5>
                            <small>Tạo mới hồ sơ giáo viên trong hệ thống.</small>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        @await Html.PartialAsync("_Form", new eSchool.ViewModels.GiaoVienFormViewModel())
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                        <button class="btn btn-primary">Thêm giáo viên</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="importTeacherModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content teacher-admin-modal p-0">
                <form asp-action="ImportExcel" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title">Nhập giáo viên từ Excel</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-3 text-muted">Vui lòng tải file mẫu để xem định dạng chuẩn trước khi nhập dữ liệu.</p>
                        <a asp-action="DownloadTemplate" class="btn btn-outline-success mb-4">
                            <i class="bi bi-download me-1"></i> Tải file mẫu
                        </a>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Chọn file Excel (.xlsx)</label>
                            <input type="file" name="file" class="form-control" accept=".xlsx" required />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-upload me-1"></i> Nhập dữ liệu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
else
{
    <div class="page-card">
        <div class="page-tools">
            <form method="get">
                <input name="keyword" value="@ViewBag.Keyword" class="form-control"
                       placeholder="Tìm theo họ tên, email hoặc số điện thoại..." />
                <button class="btn btn-outline-secondary"><i class="bi bi-search"></i> Tìm</button>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Giáo viên</th>
                        <th>Môn dạy</th>
                        <th>Ngày sinh</th>
                        <th>Giới tính</th>
                        <th>Địa chỉ</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!danhSach.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">Chưa có giáo viên</td></tr>
                    }
                    @foreach (var item in danhSach)
                    {
                        <tr>
                            <td>
                                <button type="button" class="teacher-profile-trigger" title="Xem hồ sơ @item.HoTen"
                                        data-bs-toggle="modal" data-bs-target="#teacherProfileModal"
                                        data-name="@item.HoTen"
                                        data-avatar="@(string.IsNullOrWhiteSpace(item.AnhDaiDien) ? Url.Content("~/image/default-avatar.svg") : item.AnhDaiDien)"
                                        data-subject="@(item.MonHoc?.TenMon ?? "Chưa phân môn")"
                                        data-birth="@item.NgaySinh.ToString("dd/MM/yyyy")"
                                        data-gender="@(string.IsNullOrWhiteSpace(item.GioiTinh) ? "Chưa cập nhật" : item.GioiTinh)"
                                        data-phone="@(item.SDT ?? "Chưa cập nhật")"
                                        data-email="@(item.Email ?? "Chưa cập nhật")"
                                        data-address="@(item.DiaChi ?? "Chưa cập nhật")"
                                        data-account="@(item.IdTaiKhoan.HasValue ? "Đã liên kết" : "Chưa liên kết")">
                                    <div class="teacher-name">
                                        <img src="@(string.IsNullOrWhiteSpace(item.AnhDaiDien) ? Url.Content("~/image/default-avatar.svg") : item.AnhDaiDien)" alt="Ảnh @item.HoTen" />
                                        <div>
                                            <strong>@item.HoTen</strong>
                                            <small class="d-block text-muted">@item.Email</small>
                                        </div>
                                    </div>
                                </button>
                            </td>
                            <td><span class="badge bg-info text-dark">@(item.MonHoc?.TenMon ?? "Chưa phân môn")</span></td>
                            <td>@item.NgaySinh.ToString("dd/MM/yyyy")</td>
                            <td>@item.GioiTinh</td>
                            <td>@item.DiaChi</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
