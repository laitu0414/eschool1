@model eSchool.ViewModels.ChuNhiemViewModel

@{
    Layout = Context.Session.GetInt32("RoleId") == SystemRoleIds.SystemAdmin
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_TeacherLayout.cshtml";
    ViewData["Title"] = "Chủ nhiệm lớp";
}

<div class="page-card">
    <div class="mb-4">
        <h5 class="mb-1">Phân công giáo viên chủ nhiệm</h5>
        <p class="text-muted mb-0">Chọn giáo viên chủ nhiệm cho từng lớp và năm học.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]</div>
    }

    <form asp-action="TuDongGanChuNhiem" method="post" class="d-flex flex-wrap align-items-center gap-2 mb-4 p-3 rounded border bg-light">
        @Html.AntiForgeryToken()
        <div>
            <strong class="d-block">Phân công tự động</strong>
            <small class="text-muted">Ưu tiên giáo viên của lớp tiền nhiệm, sau đó cân bằng số lớp chủ nhiệm.</small>
        </div>
        <select name="namHoc" class="form-select ms-md-auto" style="max-width: 190px;" required>
            <option value="">-- Chọn năm học --</option>
            @foreach (var namHoc in Model.NamHocs)
            {
                <option value="@namHoc.Value">@namHoc.Text</option>
            }
        </select>
        <button type="submit" class="btn btn-success" onclick="return confirm('Tự động phân công giáo viên chủ nhiệm cho các lớp chưa có phân công trong năm học đã chọn?');">
            <i class="bi bi-magic me-1"></i>Phân công tự động
        </button>
    </form>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Tên lớp</th>
                    <th>Khối</th>
                    <th>Năm học</th>
                    <th style="min-width: 320px;">Giáo viên chủ nhiệm</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.LopHocs.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">Chưa có lớp học</td></tr>
                }
                @foreach (var lop in Model.LopHocs)
                {
                    <tr>
                        <td><strong>@lop.TenLop</strong></td>
                        <td>@lop.Khoi</td>
                        <td>@lop.NamHoc</td>
                        <td>
                            <form asp-action="GanChuNhiem" method="post" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idLop" value="@lop.IdLop" />
                                <select name="idGiaoVien" class="form-select">
                                    <option value="">-- Chưa phân công --</option>
                                    @foreach (var giaoVien in Model.GiaoViens)
                                    {
                                        <option value="@giaoVien.Value"
                                                selected="@(lop.IdGiaoVienCN?.ToString() == giaoVien.Value)">
                                            @giaoVien.Text
                                        </option>
                                    }
                                </select>
                                <button class="btn btn-primary">Lưu</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
