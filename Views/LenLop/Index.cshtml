<script>
    document.addEventListener("DOMContentLoaded", function() {
        const tenNamHocInput = document.getElementById('autoTenNamHoc');
        const ngayBatDauInput = document.getElementById('autoNgayBatDau');
        const ngayKetThucInput = document.getElementById('autoNgayKetThuc');

        if (tenNamHocInput && ngayBatDauInput && ngayKetThucInput) {
            tenNamHocInput.addEventListener('input', function(e) {
                const val = e.target.value.trim();
                const match = val.match(/^(\d{4})-(\d{4})$/);
                if (match) {
                    const startYear = match[1];
                    const endYear = match[2];
                    
                    // Năm học thường bắt đầu vào 05/09 và kết thúc vào 31/05
                    ngayBatDauInput.value = `${startYear}-09-05`;
                    ngayKetThucInput.value = `${endYear}-05-31`;
                }
            });
        }
    });
</script>

