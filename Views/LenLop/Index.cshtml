                            <thead><tr><th>Mã HS</th><th>Họ tên</th><th>Lớp đăng ký</th><th>Năm học</th></tr></thead>
                            <tbody>
                            @foreach (var registration in (ViewBag.NextYearRegistrations as List<eSchool.Models.DangKyLop> ?? new()))
                            {
                                <tr><td>@registration.HocSinh?.MaHS</td><td>@registration.HocSinh?.HoTen</td><td>@registration.LopHoc?.TenLop</td><td>@registration.LopHoc?.NamHoc</td></tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

