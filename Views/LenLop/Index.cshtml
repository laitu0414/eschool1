                        <div class="col-sm-8">
                            <input type="date" name="NgayBatDau" id="autoNgayBatDau" class="form-control" required />
                        </div>
                    </div>
                    
                    <div class="row mb-3 align-items-center">
                        <label class="col-sm-4 form-label-custom mb-0">Ngày kết thúc (dự kiến) <span class="text-danger-custom">*</span></label>
                        <div class="col-sm-8">
                            <input type="date" name="NgayKetThuc" id="autoNgayKetThuc" class="form-control" required />
                        </div>
                    </div>
                    
                    <div class="row mb-4">
                        <label class="col-sm-4 form-label-custom mb-0 pt-2" style="align-self: flex-start;">Mô tả</label>
                        <div class="col-sm-8">
                            <textarea class="form-control" rows="3" placeholder="Nhập mô tả (nếu có)..."></textarea>
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer border-top-0 px-4 pb-4">
                    <button type="button" class="btn btn-white border px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4" style="background-color: #1d4ed8;">
                        <i class="bi bi-calendar-plus me-1"></i> Tạo năm học mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const tenNamHocInput = document.getElementById('autoTenNamHoc');
        const ngayBatDauInput = document.getElementById('autoNgayBatDau');
        const ngayKetThucInput = document.getElementById('autoNgayKetThuc');

        if (tenNamHocInput && ngayBatDauInput && ngayKetThucInput) {
            tenNamHocInput.addEventListener('input', function(e) {
                const val = e.target.value.trim();
                const match = val.match(/^(\d{4})-(\d{4})$/);
                if (match) {
                    const startYear = match[1];
                    const endYear = match[2];
                    
                    // Năm học thường bắt đầu vào 05/09 và kết thúc vào 31/05
                    ngayBatDauInput.value = `${startYear}-09-05`;
                    ngayKetThucInput.value = `${endYear}-05-31`;
                }
            });
        }
    });
</script>

<!-- MODAL XẾP LỚP NĂM HỌC MỚI -->
<div class="modal fade" id="assignClassModal" tabindex="-1">
