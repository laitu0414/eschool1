                    <button type="submit" class="btn btn-primary px-4" style="background-color: #1d4ed8;">
                        <i class="bi bi-printer me-1"></i> Tạo và in
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL XUẤT EXCEL -->
<div class="modal fade" id="exportExcelModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content border-0 shadow">
            <form action="/LenLop/ExportExcel" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom-0 pt-4 pb-2 px-4">
                    <h5 class="modal-title fw-bold fs-5" style="color: #166534 !important;">
                        <i class="bi bi-file-earmark-excel-fill me-2" style="color: #16a34a;"></i> XUẤT EXCEL
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body px-4 pb-4">
                    <div class="alert alert-custom-info d-flex align-items-center py-2 mb-4 rounded-3">
                        <i class="bi bi-info-circle text-primary me-2 fs-6"></i>
                        Xuất dữ liệu kết quả xét lên lớp / tốt nghiệp ra file Excel.
                    </div>
                    
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="border rounded-3 p-4 h-100">
                                <h6 class="fw-bold mb-4" style="color: #334155;">Thông tin xuất</h6>
                                <div class="row mb-3 align-items-center">
                                    <label class="col-sm-4 form-label-custom mb-0">Năm học</label>
                                    <div class="col-sm-8">
                                        <select name="NamHoc" class="form-select">
                                            <option>2025 - 2026</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="row mb-3 align-items-center">
                                    <label class="col-sm-4 form-label-custom mb-0">Khối</label>
                                    <div class="col-sm-8">
                                        <select name="Khoi" class="form-select">
                                            <option value="">Tất cả</option>
                                            @foreach(var k in khoiStats)
                                            {
                                                <option value="@k.Khoi">@k.Khoi</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="row mb-3 align-items-center">
                                    <label class="col-sm-4 form-label-custom mb-0">Lớp</label>
                                    <div class="col-sm-8">
                                        <select name="Lop" class="form-select">
                                            <option value="">Tất cả</option>
                                            @foreach(var l in lopStats)
                                            {
                                                <option value="@l.TenLop">@l.TenLop</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="row mb-3 align-items-center">
                                    <label class="col-sm-4 form-label-custom mb-0">Loại dữ liệu</label>
                                    <div class="col-sm-8">
                                        <select name="LoaiDuLieu" class="form-select"><option>Kết quả xét lên lớp</option></select>
                                    </div>
                                </div>
                                <div class="row mb-0 align-items-center">
                                    <label class="col-sm-4 form-label-custom mb-0">Định dạng file</label>
                                    <div class="col-sm-8">
                                        <select name="DinhDangFile" class="form-select"><option>.xlsx (Excel 2007 trở lên)</option></select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="border rounded-3 p-4 h-100">
                                <h6 class="fw-bold mb-4" style="color: #334155;">Bao gồm các thông tin</h6>
                                <div class="d-flex flex-column gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input bg-primary border-primary" type="checkbox" name="BaoGom" value="Thông tin học sinh" id="chk1" checked>
                                        <label class="form-check-label text-dark" for="chk1">Thông tin học sinh</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input bg-primary border-primary" type="checkbox" name="BaoGom" value="Kết quả học tập" id="chk2" checked>
                                        <label class="form-check-label text-dark" for="chk2">Kết quả học tập</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input bg-primary border-primary" type="checkbox" name="BaoGom" value="Kết quả rèn luyện" id="chk3" checked>
                                        <label class="form-check-label text-dark" for="chk3">Kết quả rèn luyện</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input bg-primary border-primary" type="checkbox" name="BaoGom" value="Điều kiện xét" id="chk4" checked>
                                        <label class="form-check-label text-dark" for="chk4">Điều kiện xét</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input bg-primary border-primary" type="checkbox" name="BaoGom" value="Kết quả xét" id="chk5" checked>
                                        <label class="form-check-label text-dark" for="chk5">Kết quả xét</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input bg-primary border-primary" type="checkbox" name="BaoGom" value="Ghi chú" id="chk6" checked>
                                        <label class="form-check-label text-dark" for="chk6">Ghi chú</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="modal-footer border-top-0 px-4 pb-4">
                    <button type="submit" class="btn btn-primary px-4" style="background-color: #1d4ed8;">
                        <i class="bi bi-download me-1"></i> Xuất Excel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
