@inject eSchool.Models.AppDbContext DbContext
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var thongBaoGiaoVien = DbContext.ThongBaos
        .Where(x => x.DoiTuongNhan == 0 || x.DoiTuongNhan == 1)
        .OrderByDescending(x => x.NgayTao)
        .Take(5)
        .ToList();
    var soThongBaoGiaoVien = DbContext.ThongBaos.Count(x => x.DoiTuongNhan == 0 || x.DoiTuongNhan == 1);

    string MenuClass(params string[] actions)
    {
        return actions.Any(x => string.Equals(x, currentAction, StringComparison.OrdinalIgnoreCase))
            ? "menu-item active"
            : "menu-item";
    }

    string HienThiThoiGian(DateTime ngayTao)
    {
        var khoangCach = DateTime.Now - ngayTao;

        if (khoangCach.TotalMinutes < 1) return "Vừa xong";
        if (khoangCach.TotalHours < 1) return $"{(int)khoangCach.TotalMinutes} phút trước";
        if (khoangCach.TotalDays < 1) return $"{(int)khoangCach.TotalHours} giờ trước";
        if (khoangCach.TotalDays < 30) return $"{(int)khoangCach.TotalDays} ngày trước";

        return ngayTao.ToString("dd/MM/yyyy HH:mm");
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eSchool</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/teacher.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/footer.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <div class="teacher-app">
        <aside class="sidebar">
            <div class="brand">
                <span class="brand-icon"><i class="bi bi-mortarboard-fill"></i></span>
                <span><strong>eSchool</strong><small>Quản lý giáo viên</small></span>
            </div>

            <div class="menu-title">GIÁO VIÊN</div>
            <nav class="sidebar-menu">
                <a asp-controller="GiaoVien" asp-action="HoSoCaNhan" class="@MenuClass("HoSoCaNhan", "HoSo")">
                    <i class="bi bi-person-vcard"></i><span>Hồ sơ giáo viên</span>
                </a>
                <a asp-controller="GiaoVien" asp-action="ThoiKhoaBieu" class="@MenuClass("ThoiKhoaBieu")">
                    <i class="bi bi-calendar3"></i><span>Thời khóa biểu giáo viên</span>
                </a>
                <a asp-controller="KetQuaHocTap" asp-action="GiaoVienDiemDanh" class="@MenuClass("GiaoVienDiemDanh")">
                    <i class="bi bi-person-check"></i><span>Điểm danh lớp</span>
                </a>
                <a asp-controller="KetQuaHocTap" asp-action="Diem" class="@MenuClass("Diem")">
                    <i class="bi bi-bar-chart-fill"></i><span>Quản lý điểm</span>
                </a>
                <a asp-controller="GiaoVien" asp-action="QuanLyKyLuat" class="@MenuClass("QuanLyKyLuat")">
                    <i class="bi bi-shield-exclamation"></i><span>Kỷ luật lớp CN</span>
                </a>
                <a asp-controller="GiaoVien" asp-action="QuanLyHocPhi" class="@MenuClass("QuanLyHocPhi")">
                    <i class="bi bi-cash-stack"></i><span>Học phí lớp</span>
                </a>
                <a asp-controller="GiaoVien" asp-action="YeuCauBaoTri" class="@MenuClass("YeuCauBaoTri")">
                    <i class="bi bi-tools"></i><span>Yêu cầu bảo trì thiết bị</span>
                </a>
            </nav>

            <div class="sidebar-bottom">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="menu-item logout border-0 w-100 text-start">
                        <i class="bi bi-box-arrow-right"></i><span>Đăng xuất</span>
                    </button>
                </form>
            </div>
        </aside>

        <main class="main">
            <header class="topbar">
                <div>
                    <small>Hệ thống quản lý nhà trường</small>
                    <h1>@ViewData["Title"]</h1>
                </div>
                                <div class="teacher-topbar-actions">
                    <div class="dropdown portal-notification">
                        <button class="portal-bell" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Thông báo">
                            <i class="bi bi-bell-fill"></i>
                            @if (soThongBaoGiaoVien > 0)
                            {
                                <span>@soThongBaoGiaoVien</span>
                            }
                        </button>
                        <div class="dropdown-menu dropdown-menu-end portal-notification-menu">
                            <div class="portal-notification-title">Thông báo</div>
                            @if (thongBaoGiaoVien.Any())
                            {
                                foreach (var thongBao in thongBaoGiaoVien)
                                {
                                    <div class="portal-notification-item">
                                        <strong>@thongBao.TieuDe</strong>
                                        <small>@HienThiThoiGian(thongBao.NgayTao)</small>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="portal-notification-empty">Chưa có thông báo</div>
                            }
                        </div>
                    </div>

                    <div class="dropdown">
                        <button class="teacher-user teacher-user-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span><i class="bi bi-person-fill"></i></span>
                            <strong>@(Context.Session.GetString("Username") ?? "Giáo viên")</strong>
                            <i class="bi bi-chevron-down user-chevron"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end portal-user-menu">
                            <li>
                                <a class="dropdown-item" asp-controller="GiaoVien" asp-action="HoSoCaNhan">
                                    <i class="bi bi-person-vcard me-2"></i>Hồ sơ giáo viên
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="GiaoVien" asp-action="ThoiKhoaBieu">
                                    <i class="bi bi-calendar3 me-2"></i>Thời khóa biểu
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="KetQuaHocTap" asp-action="GiaoVienDiemDanh">
                                    <i class="bi bi-person-check me-2"></i>Điểm danh lớp
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="GiaoVien" asp-action="QuanLyKyLuat">
                                    <i class="bi bi-shield-exclamation me-2"></i>Kỷ luật lớp CN
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="GiaoVien" asp-action="QuanLyHocPhi">
                                    <i class="bi bi-cash-stack me-2"></i>Học phí lớp CN
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="GiaoVien" asp-action="YeuCauBaoTri">
                                    <i class="bi bi-tools me-2"></i>Yêu cầu bảo trì thiết bị
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <section class="page">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
                @RenderBody()
            </section>
            @await Html.PartialAsync("_SiteFooter")
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/required-fields.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

