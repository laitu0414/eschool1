@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string MenuClass(string action) =>
        string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
            ? "menu-item active"
            : "menu-item";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eSchool</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/academic.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/footer.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <div class="academic-app">
        <aside class="sidebar">
            <div class="brand">
                <span class="brand-icon"><i class="bi bi-journal-bookmark-fill"></i></span>
                <span><strong>eSchool</strong><small>Quản lý học vụ</small></span>
            </div>

            <div class="menu-title">HỌC VỤ</div>
            <nav class="sidebar-menu">
                <a asp-controller="HocVu" asp-action="LopHoc" class="@MenuClass("LopHoc")">
                    <i class="bi bi-building"></i><span>Quản lý lớp</span>
                </a>
                <a asp-controller="HocVu" asp-action="PhongHoc" class="@MenuClass("PhongHoc")">
                    <i class="bi bi-door-open-fill"></i><span>Quản lý phòng học</span>
                </a>
                <a asp-controller="HocVu" asp-action="MonHoc" class="@MenuClass("MonHoc")">
                    <i class="bi bi-book-fill"></i><span>Quản lý môn học</span>
                </a>
                <a asp-controller="HocVu" asp-action="ThoiKhoaBieu" class="@MenuClass("ThoiKhoaBieu")">
                    <i class="bi bi-calendar-week-fill"></i><span>Thời khóa biểu</span>
                </a>
                <a asp-controller="HocVu" asp-action="NamHoc" class="@MenuClass("NamHoc")">
                    <i class="bi bi-calendar-range"></i><span>Năm học</span>
                </a>
                <a asp-controller="HocVu" asp-action="HocKy" class="@MenuClass("HocKy")">
                    <i class="bi bi-calendar2-check"></i><span>Học kỳ</span>
                </a>
                <a asp-controller="ChuyenLop" asp-action="Index" class="@MenuClass("Index")">
                    <i class="bi bi-arrow-left-right"></i><span>Chuyển lớp</span>
                </a>
            </nav>

            <div class="sidebar-bottom">
                <a asp-controller="Admin" asp-action="Index" class="menu-item">
                    <i class="bi bi-arrow-left"></i><span>Về trang quản trị</span>
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="menu-item logout border-0 w-100 text-start">
                        <i class="bi bi-box-arrow-right"></i><span>Đăng xuất</span>
                    </button>
                </form>
            </div>
        </aside>

        <main class="main">
            <header class="topbar">
                <div>
                    <small>Hệ thống quản lý nhà trường</small>
                    <h1>@ViewData["Title"]</h1>
                </div>
                <div class="academic-user">
                    <span><i class="bi bi-person-fill"></i></span>
                    <strong>@(Context.Session.GetString("Username") ?? "Quản trị")</strong>
                </div>
            </header>

            <section class="page">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }
                @RenderBody()
            </section>
            @await Html.PartialAsync("_SiteFooter")
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/required-fields.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
