<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4" style="background: #ffffff; border: 1px solid #e2e8f0 !important;">
    <div class="card-header bg-gradient py-3 px-3 border-0" style="background: linear-gradient(135deg, #0d47a1 0%, #1e40af 100%); color: #ffffff;">
        <h5 class="m-0 fw-bold d-flex align-items-center gap-2" style="font-size: 0.92rem; letter-spacing: 0.3px; font-family: 'Plus Jakarta Sans', sans-serif;">
            <i class="bi bi-grid-fill text-warning"></i>
            DANH MỤC GIỚI THIỆU
        </h5>
    </div>
    <div class="p-2 d-flex flex-column gap-1" style="font-size: 13.5px; font-family: 'Be Vietnam Pro', sans-serif;">
        <a asp-controller="Home" asp-action="ThongDiepHieuTruong" 
           class="d-flex align-items-center justify-content-between p-2 rounded-3 text-decoration-none transition-all @(ViewData["ActiveMenu"] as string == "ThongDiep" ? "bg-primary text-white fw-bold shadow-sm" : "text-secondary hover-bg-light")">
            <span class="d-flex align-items-center gap-2">
                <i class="bi bi-chat-quote-fill @(ViewData["ActiveMenu"] as string == "ThongDiep" ? "text-white" : "text-primary")"></i>
                <span>Thông điệp Hiệu trưởng</span>
            </span>
            <i class="bi bi-chevron-right @(ViewData["ActiveMenu"] as string == "ThongDiep" ? "text-white" : "text-muted")" style="font-size: 11px;"></i>
        </a>

        <a asp-controller="Home" asp-action="TamNhin" 
           class="d-flex align-items-center justify-content-between p-2 rounded-3 text-decoration-none transition-all @(ViewData["ActiveMenu"] as string == "TamNhin" ? "bg-primary text-white fw-bold shadow-sm" : "text-secondary hover-bg-light")">
            <span class="d-flex align-items-center gap-2">
                <i class="bi bi-compass-fill @(ViewData["ActiveMenu"] as string == "TamNhin" ? "text-white" : "text-primary")"></i>
                <span>Tầm nhìn & Sứ mệnh</span>
            </span>
            <i class="bi bi-chevron-right @(ViewData["ActiveMenu"] as string == "TamNhin" ? "text-white" : "text-muted")" style="font-size: 11px;"></i>
        </a>

        <a asp-controller="Home" asp-action="DoiNguGiaoVien" 
           class="d-flex align-items-center justify-content-between p-2 rounded-3 text-decoration-none transition-all @(ViewData["ActiveMenu"] as string == "DoiNguGiaoVien" ? "bg-primary text-white fw-bold shadow-sm" : "text-secondary hover-bg-light")">
            <span class="d-flex align-items-center gap-2">
                <i class="bi bi-person-workspace @(ViewData["ActiveMenu"] as string == "DoiNguGiaoVien" ? "text-white" : "text-primary")"></i>
                <span>Đội ngũ giáo viên</span>
            </span>
            <i class="bi bi-chevron-right @(ViewData["ActiveMenu"] as string == "DoiNguGiaoVien" ? "text-white" : "text-muted")" style="font-size: 11px;"></i>
        </a>

        <a asp-controller="Home" asp-action="CoSoVatChat" 
           class="d-flex align-items-center justify-content-between p-2 rounded-3 text-decoration-none transition-all @(ViewData["ActiveMenu"] as string == "CoSoVatChat" ? "bg-primary text-white fw-bold shadow-sm" : "text-secondary hover-bg-light")">
            <span class="d-flex align-items-center gap-2">
                <i class="bi bi-building-fill-check @(ViewData["ActiveMenu"] as string == "CoSoVatChat" ? "text-white" : "text-primary")"></i>
                <span>Cơ sở vật chất</span>
            </span>
            <i class="bi bi-chevron-right @(ViewData["ActiveMenu"] as string == "CoSoVatChat" ? "text-white" : "text-muted")" style="font-size: 11px;"></i>
        </a>

        <a asp-controller="Home" asp-action="MoHinhDaoTao" 
           class="d-flex align-items-center justify-content-between p-2 rounded-3 text-decoration-none transition-all @(ViewData["ActiveMenu"] as string == "MoHinhDaoTao" ? "bg-primary text-white fw-bold shadow-sm" : "text-secondary hover-bg-light")">
            <span class="d-flex align-items-center gap-2">
                <i class="bi bi-mortarboard-fill @(ViewData["ActiveMenu"] as string == "MoHinhDaoTao" ? "text-white" : "text-primary")"></i>
                <span>Mô hình đào tạo</span>
            </span>
            <i class="bi bi-chevron-right @(ViewData["ActiveMenu"] as string == "MoHinhDaoTao" ? "text-white" : "text-muted")" style="font-size: 11px;"></i>
        </a>
    </div>
</div>

<style>
    .hover-bg-light:hover {
        background-color: #eff6ff;
        color: #1a56db !important;
        transform: translateX(3px);
    }
    .transition-all {
        transition: all 0.2s ease;
    }
</style>
