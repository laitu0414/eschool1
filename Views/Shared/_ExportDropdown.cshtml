<div class="dropdown me-2">
    <button type="button" class="btn btn-outline-secondary h-100 px-3" data-bs-toggle="dropdown" aria-expanded="false" title="Xuất dữ liệu">
        <i class="bi bi-download"></i>
    </button>
    <ul class="dropdown-menu shadow">
        <li>
            <a class="dropdown-item py-2" href="#" onclick="exportToExcel(event)">
                <i class="bi bi-file-earmark-excel me-2 text-success"></i> Excel (.xlsx)
            </a>
        </li>
        <li>
            <a class="dropdown-item py-2" href="#" onclick="exportToPdf(event)">
                <i class="bi bi-file-earmark-pdf me-2 text-danger"></i> PDF (.pdf)
            </a>
        </li>
    </ul>
</div>

<!-- Column Visibility Manager Dropdown (Shared for all tables) -->
<div class="dropdown column-manager-dropdown me-2">
    <button type="button" class="btn btn-outline-secondary h-100 px-3 d-inline-flex align-items-center justify-content-center" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="Quản lý hiển thị cột">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor">
            <path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2zm4.5 0v12h7V2h-7zM3.5 2H2a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h1.5V2zm9 0V14H14a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1h-1.5z"/>
        </svg>
    </button>
    <div class="dropdown-menu shadow column-manager-menu p-3" style="min-width: 275px; max-width: 320px; border-radius: 10px; font-size: 13.5px;">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
            <span class="fw-bold text-dark" style="font-size: 14px;">Quản lý hiển thị cột</span>
            <a href="javascript:void(0)" class="text-primary text-decoration-none small toggle-all-columns-btn" style="font-size: 12.5px; font-weight: 600;">Ẩn tất cả</a>
        </div>
        
        <!-- Search -->
        <div class="mb-2">
            <input type="text" class="form-control form-control-sm column-search-input" placeholder="Tìm kiếm cột..." style="font-size: 13px; border-radius: 6px; background-color: #f8fafc;" />
        </div>
        
        <!-- Checkbox List -->
        <div class="column-checkbox-list my-2" style="max-height: 230px; overflow-y: auto; display: flex; flex-direction: column; gap: 4px;">
            <!-- Dynamically populated -->
        </div>
        
        <!-- Footer: Reset Button -->
        <div class="pt-2 border-top mt-2">
            <button type="button" class="btn btn-outline-secondary btn-sm w-100 d-flex align-items-center justify-content-center gap-2 reset-columns-btn" style="font-size: 13px; border-radius: 6px; font-weight: 500;">
                <i class="bi bi-arrow-clockwise"></i> Đặt lại bố cục
            </button>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>

<script>
    // --- Export Logic ---
    function getTableDataForExport() {
        const table = document.querySelector('.content-card table, .page-card table, .card table, main table, table');
        if (!table) return null;
        
        const data = [];
        const headers = [];
        
        const ths = table.querySelectorAll('thead th');
        const skipCols = new Set();
        
        ths.forEach((th, index) => {
            const text = th.innerText.trim().toLowerCase();
            // Skip hidden columns or checkbox/action columns
            if (th.style.display === 'none' || th.classList.contains('d-none') || th.classList.contains('app-table-checkbox-col') || text === 'thao tác' || text === 'hành động') {
                skipCols.add(index);
            } else {
                headers.push(th.innerText.trim());
            }
        });
        
        data.push(headers);
        
        const trs = table.querySelectorAll('tbody tr:not(.app-table-empty-row)');
        trs.forEach(tr => {
            if (tr.style.display === 'none') return;
            const rowData = [];
            const tds = tr.querySelectorAll('td');
            tds.forEach((td, index) => {
                if (!skipCols.has(index)) {
                    rowData.push(td.innerText.trim());
                }
            });
            if (rowData.length > 0) {
                data.push(rowData);
            }
        });
        
        return data;
    }

    async function exportToExcel(e) {
        e.preventDefault();
        const data = getTableDataForExport();
        if (!data || data.length <= 1) {
            alert('Không có dữ liệu để xuất!');
            return;
        }
        
        const workbook = new ExcelJS.Workbook();
        const sheet = workbook.addWorksheet('Data');
        
        const headerRow = sheet.addRow(data[0]);
        headerRow.eachCell(cell => {
            cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF1F4E78' } };
            cell.font = { color: { argb: 'FFFFFFFF' }, bold: true };
            cell.alignment = { horizontal: 'center' };
            cell.border = {
                top: {style:'thin', color: {argb:'FF1F4E78'}},
                left: {style:'thin', color: {argb:'FF1F4E78'}},
                bottom: {style:'thin', color: {argb:'FF1F4E78'}},
                right: {style:'thin', color: {argb:'FF1F4E78'}}
            };
        });
        
        for (let i = 1; i < data.length; i++) {
            const row = sheet.addRow(data[i]);
            row.eachCell(cell => {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD9EAD3' } };
                cell.border = {
                    top: {style:'thin', color: {argb:'FF8FCE00'}},
                    left: {style:'thin', color: {argb:'FF8FCE00'}},
                    bottom: {style:'thin', color: {argb:'FF8FCE00'}},
                    right: {style:'thin', color: {argb:'FF8FCE00'}}
                };
            });
        }
        
        sheet.columns.forEach(column => {
            column.width = 20;
        });
        
        const buffer = await workbook.xlsx.writeBuffer();
        const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        let filename = document.title ? document.title.split('-')[0].trim() : "Export";
        link.download = filename + ".xlsx";
        link.click();
    }

    function exportToPdf(e) {
        e.preventDefault();
        const data = getTableDataForExport();
        if (!data || data.length <= 1) {
            alert('Không có dữ liệu để xuất!');
            return;
        }
        
        let html = '<table style="border-collapse: collapse; width: 100%; font-family: Arial, sans-serif; font-size: 14px;">';
        html += '<thead><tr>';
        data[0].forEach(h => {
            html += '<th style="background-color: #1f4e78; color: white; padding: 10px; border: 1px solid #8fce00;">' + h + '</th>';
        });
        html += '</tr></thead><tbody>';
        
        for (let i = 1; i < data.length; i++) {
            html += '<tr>';
            data[i].forEach(cell => {
                html += '<td style="background-color: #d9ead3; color: black; padding: 8px; border: 1px solid #8fce00;">' + cell + '</td>';
            });
            html += '</tr>';
        }
        html += '</tbody></table>';
        
        const printWindow = window.open('', '_blank');
        const pageTitle = (document.title || 'eSchool').split('-')[0].trim();
        printWindow.document.write('<' + '!DOCTYPE html><' + 'html><' + 'head><' + 'title>' + pageTitle + '<' + '/title><' + '/head><' + 'body>');
        printWindow.document.write('<' + 'h2 style="font-family: Arial, sans-serif; text-align: left; margin-bottom: 20px;">' + pageTitle + '<' + '/h2>');
        printWindow.document.write(html);
        printWindow.document.write('<' + 'script>window.onload = function() { window.print(); setTimeout(function() { window.close(); }, 500); };<' + '/script>');
        printWindow.document.write('<' + '/body><' + '/html>');
        printWindow.document.close();
    }

    // --- Column Visibility Manager Logic ---
    (function () {
        function getStorageKey() {
            return 'eschool_table_cols_' + window.location.pathname.replace(/\/+$/, '');
        }

        function getSavedHiddenCols() {
            try {
                const raw = localStorage.getItem(getStorageKey());
                return raw ? JSON.parse(raw) : [];
            } catch (e) {
                return [];
            }
        }

        function saveHiddenCols(hiddenCols) {
            try {
                localStorage.setItem(getStorageKey(), JSON.stringify(hiddenCols));
            } catch (e) {}
        }

        function findTable(managerEl) {
            // Find closest table in content-card, page-card, or document
            const card = managerEl.closest('.content-card, .page-card, .card, .student-admin-card, .teacher-admin-card') || document;
            return card.querySelector('table');
        }

        function initColumnManager(managerEl) {
            const table = findTable(managerEl);
            if (!table) return;

            const listContainer = managerEl.querySelector('.column-checkbox-list');
            const toggleAllBtn = managerEl.querySelector('.toggle-all-columns-btn');
            const searchInput = managerEl.querySelector('.column-search-input');
            const resetBtn = managerEl.querySelector('.reset-columns-btn');

            if (!listContainer) return;

            // Extract table headers
            const ths = Array.from(table.querySelectorAll('thead th'));
            const columns = [];

            ths.forEach((th, index) => {
                let name = th.innerText.trim();
                // Check if this th is a checkbox column without text
                if (!name && th.querySelector('input[type="checkbox"]')) {
                    return; // skip bulk-selection checkbox column
                }
                if (!name) {
                    name = 'Cột ' + (index + 1);
                }
                columns.push({
                    index: index,
                    name: name,
                    th: th
                });
            });

            const hiddenCols = getSavedHiddenCols();

            // Apply saved hidden state immediately to table
            columns.forEach(col => {
                const isHidden = hiddenCols.includes(col.name);
                setColumnVisibility(table, col.index, !isHidden);
            });

            // Build UI Checkbox List
            function renderList(filterTerm = '') {
                listContainer.innerHTML = '';
                const term = filterTerm.trim().toLowerCase();

                let visibleCount = 0;
                let totalCount = 0;

                columns.forEach(col => {
                    const matchesSearch = !term || col.name.toLowerCase().includes(term);
                    if (!matchesSearch) return;

                    totalCount++;
                    const isChecked = !hiddenCols.includes(col.name);
                    if (isChecked) visibleCount++;

                    const item = document.createElement('label');
                    item.className = 'column-manager-item d-flex align-items-center gap-2 py-1 px-2 rounded mb-1';
                    item.style.cssText = 'cursor: pointer; user-select: none; transition: background 0.15s;';
                    item.onmouseover = () => item.style.backgroundColor = '#f1f5f9';
                    item.onmouseout = () => item.style.backgroundColor = 'transparent';

                    item.innerHTML = `
                        <input type="checkbox" class="form-check-input mt-0 column-item-checkbox" data-col-name="${col.name}" data-col-idx="${col.index}" ${isChecked ? 'checked' : ''} style="cursor: pointer; width: 16px; height: 16px;" />
                        <span class="small text-dark fw-normal" style="line-height: 1.3;">${col.name}</span>
                    `;

                    const chk = item.querySelector('.column-item-checkbox');
                    chk.addEventListener('change', function () {
                        const colName = this.getAttribute('data-col-name');
                        const colIdx = parseInt(this.getAttribute('data-col-idx'), 10);
                        const isVisible = this.checked;

                        setColumnVisibility(table, colIdx, isVisible);

                        const curHidden = getSavedHiddenCols();
                        if (isVisible) {
                            const idx = curHidden.indexOf(colName);
                            if (idx > -1) curHidden.splice(idx, 1);
                        } else {
                            if (!curHidden.includes(colName)) curHidden.push(colName);
                        }
                        saveHiddenCols(curHidden);
                        updateToggleAllText();
                    });

                    listContainer.appendChild(item);
                });

                if (totalCount === 0) {
                    listContainer.innerHTML = '<div class="text-muted text-center py-2 small">Không tìm thấy cột</div>';
                }

                updateToggleAllText();
            }

            function updateToggleAllText() {
                if (!toggleAllBtn) return;
                const curHidden = getSavedHiddenCols();
                const allHidden = columns.every(c => curHidden.includes(c.name));
                toggleAllBtn.textContent = allHidden ? 'Hiện tất cả' : 'Ẩn tất cả';
            }

            function setColumnVisibility(tbl, colIdx, isVisible) {
                const headerTh = tbl.querySelectorAll('thead th')[colIdx];
                if (headerTh) {
                    headerTh.style.display = isVisible ? '' : 'none';
                }

                const rows = tbl.querySelectorAll('tbody tr');
                rows.forEach(tr => {
                    const td = tr.children[colIdx];
                    if (td) {
                        td.style.display = isVisible ? '' : 'none';
                    }
                });
            }

            // Event: Search columns
            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    renderList(this.value);
                });
            }

            // Event: Toggle All
            if (toggleAllBtn) {
                toggleAllBtn.addEventListener('click', function () {
                    const curHidden = getSavedHiddenCols();
                    const allHidden = columns.every(c => curHidden.includes(c.name));

                    if (allHidden) {
                        // Show all
                        saveHiddenCols([]);
                        columns.forEach(c => setColumnVisibility(table, c.index, true));
                    } else {
                        // Hide all
                        const newHidden = columns.map(c => c.name);
                        saveHiddenCols(newHidden);
                        columns.forEach(c => setColumnVisibility(table, c.index, false));
                    }

                    renderList(searchInput ? searchInput.value : '');
                });
            }

            // Event: Reset layout
            if (resetBtn) {
                resetBtn.addEventListener('click', function () {
                    localStorage.removeItem(getStorageKey());
                    localStorage.removeItem('eschool_table_widths_' + window.location.pathname.replace(/\/+$/, ''));
                    columns.forEach(c => {
                        setColumnVisibility(table, c.index, true);
                        if (c.th) {
                            c.th.style.width = '';
                            c.th.style.minWidth = '';
                        }
                    });
                    if (searchInput) searchInput.value = '';
                    renderList('');
                });
            }

            // Initial render
            renderList('');
        }

        // --- Table Column Resizer Logic ---
        function initTableColumnResizer(table) {
            if (!table || table.dataset.resizerReady) return;
            table.dataset.resizerReady = 'true';

            const storageWidthKey = 'eschool_table_widths_' + window.location.pathname.replace(/\/+$/, '');
            let savedWidths = {};
            try {
                savedWidths = JSON.parse(localStorage.getItem(storageWidthKey) || '{}');
            } catch (e) {}

            const ths = Array.from(table.querySelectorAll('thead th'));
            if (!ths.length) return;

            // Restore saved widths
            ths.forEach((th, idx) => {
                const name = th.innerText.trim() || ('col_' + idx);
                if (savedWidths[name]) {
                    th.style.width = savedWidths[name] + 'px';
                    th.style.minWidth = savedWidths[name] + 'px';
                }
            });

            ths.forEach((th, index) => {
                // Skip last column
                if (index === ths.length - 1) return;

                // Ensure position relative on th
                const computedPosition = window.getComputedStyle(th).position;
                if (!computedPosition || computedPosition === 'static') {
                    th.style.position = 'relative';
                }

                let resizer = th.querySelector('.th-column-resizer');
                if (!resizer) {
                    resizer = document.createElement('div');
                    resizer.className = 'th-column-resizer';
                    resizer.title = 'Kéo để thay đổi độ rộng cột (Nhấp đúp để đặt lại)';
                    th.appendChild(resizer);
                }

                let startX = 0;
                let startW = 0;
                let activeTh = null;

                const onMouseDown = function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    activeTh = th;
                    startX = e.pageX;
                    startW = activeTh.offsetWidth;
                    resizer.classList.add('is-resizing');
                    document.body.classList.add('table-column-resizing-active');

                    const onMouseMove = function (ev) {
                        if (!activeTh) return;
                        const diff = ev.pageX - startX;
                        const newW = Math.max(50, startW + diff);
                        activeTh.style.width = newW + 'px';
                        activeTh.style.minWidth = newW + 'px';
                    };

                    const onMouseUp = function () {
                        if (!activeTh) return;
                        resizer.classList.remove('is-resizing');
                        document.body.classList.remove('table-column-resizing-active');
                        document.removeEventListener('mousemove', onMouseMove);
                        document.removeEventListener('mouseup', onMouseUp);

                        // Save widths
                        const curWidths = {};
                        ths.forEach((t, i) => {
                            const colName = t.innerText.trim() || ('col_' + i);
                            if (t.style.width) {
                                curWidths[colName] = t.offsetWidth;
                            }
                        });
                        try {
                            localStorage.setItem(storageWidthKey, JSON.stringify(curWidths));
                        } catch (e) {}

                        activeTh = null;
                    };

                    document.addEventListener('mousemove', onMouseMove);
                    document.addEventListener('mouseup', onMouseUp);
                };

                resizer.addEventListener('mousedown', onMouseDown);

                // Double click to reset column width
                resizer.addEventListener('dblclick', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    th.style.width = '';
                    th.style.minWidth = '';

                    const curWidths = {};
                    ths.forEach((t, i) => {
                        const colName = t.innerText.trim() || ('col_' + i);
                        if (t.style.width) {
                            curWidths[colName] = t.offsetWidth;
                        }
                    });
                    try {
                        localStorage.setItem(storageWidthKey, JSON.stringify(curWidths));
                    } catch (e) {}
                });
            });
        }

        function initAll() {
            document.querySelectorAll('.column-manager-dropdown').forEach(initColumnManager);
            document.querySelectorAll('.content-card table, .page-card table, .card table, .table, table').forEach(initTableColumnResizer);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initAll);
        } else {
            initAll();
        }

        // Also init on dropdown show or dynamically added elements
        document.addEventListener('shown.bs.dropdown', function (e) {
            const dropdown = e.target.closest('.column-manager-dropdown');
            if (dropdown && !dropdown.dataset.initialized) {
                dropdown.dataset.initialized = 'true';
                initColumnManager(dropdown);
            }
        });
    })();
</script>

<style>
    /* Column Resizer Styles */
    .th-column-resizer {
        position: absolute;
        top: 0;
        right: 0;
        width: 10px;
        height: 100%;
        cursor: col-resize;
        user-select: none;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .th-column-resizer::after {
        content: '';
        display: block;
        width: 2px;
        height: 55%;
        background-color: transparent;
        border-radius: 2px;
        transition: background-color 0.15s, height 0.15s;
    }

    .th-column-resizer:hover::after,
    .th-column-resizer.is-resizing::after {
        background-color: #0284c7;
        height: 90%;
        box-shadow: 0 0 4px rgba(2, 132, 199, 0.5);
    }

    .table-column-resizing-active,
    .table-column-resizing-active * {
        cursor: col-resize !important;
        user-select: none !important;
    }
</style>

