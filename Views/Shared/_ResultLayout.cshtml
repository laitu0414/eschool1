@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string MenuClass(string action) => string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
        ? "menu-item active"
        : "menu-item";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eSchool</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/result.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/footer.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pagination.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/table-column-manager.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <aside class="sidebar">
        <div class="brand">
            <span class="brand-icon"><img src="~/images/logo.png" alt="THCS eSchool" /></span>
            <span>
                <strong>eSchool</strong>
                <small>Kết quả học tập</small>
            </span>
        </div>

        <div class="menu-title">HỌC SINH</div>

        <nav class="sidebar-menu">
            <a asp-controller="TongKet" asp-action="Index" class="menu-item"><i class="bi bi-calendar-check"></i><span>Điểm cả năm / Tổng kết</span></a>
            <a asp-controller="KetQuaHocTap" asp-action="Diem" class="@MenuClass("Diem")">
                <i class="bi bi-bar-chart-fill"></i><span>Quản lý điểm</span>
            </a>
            <a asp-controller="KetQuaHocTap" asp-action="DiemDanh" class="@MenuClass("DiemDanh")">
                <i class="bi bi-person-check-fill"></i><span>Điểm danh</span>
            </a>
            <a asp-controller="KetQuaHocTap" asp-action="HocPhi" class="@MenuClass("HocPhi")">
                <i class="bi bi-cash-coin"></i><span>Học phí</span>
            </a>
            <a asp-controller="KetQuaHocTap" asp-action="PhieuDiem" class="@MenuClass("PhieuDiem")">
                <i class="bi bi-printer-fill"></i><span>In phiếu điểm</span>
            </a>
        </nav>

        <div class="sidebar-bottom">
            <a asp-controller="Admin" asp-action="Index" class="menu-item">
                <i class="bi bi-arrow-left"></i><span>Về trang quản trị</span>
            </a>
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="menu-item logout border-0 w-100 text-start">
                    <i class="bi bi-box-arrow-right"></i><span>Đăng xuất</span>
                </button>
            </form>
        </div>
    </aside>

    <main class="main">
        <header class="topbar">
            <div>
                <small>Hệ thống quản lý nhà trường</small>
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="result-user">
                <i class="bi bi-person-fill"></i>
                <strong>@(Context.Session.GetString("Username") ?? "Quan tri")</strong>
            </div>
        </header>

        <section class="page">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            @RenderBody()
        </section>
        @await Html.PartialAsync("_SiteFooter")
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/required-fields.js" asp-append-version="true"></script>
    <script src="~/js/table-pagination.js" asp-append-version="true"></script>
    <script src="~/js/table-column-manager.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
