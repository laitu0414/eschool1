@inject eSchool.Models.AppDbContext DbContext
@{
    var title = ViewData["Title"] ?? "eSchool Admin";
    var thongBaoCount = DbContext.ThongBaos.Count();
    var thongBaoMoiNhat = DbContext.ThongBaos
        .OrderByDescending(tb => tb.NgayTao)
        .Take(5)
        .ToList();

    string HienThiThoiGian(DateTime ngayTao)
    {
        var khoangCach = DateTime.Now - ngayTao;

        if (khoangCach.TotalMinutes < 1) return "Vừa xong";
        if (khoangCach.TotalHours < 1) return $"{(int)khoangCach.TotalMinutes} phút trước";
        if (khoangCach.TotalDays < 1) return $"{(int)khoangCach.TotalHours} giờ trước";
        if (khoangCach.TotalDays < 30) return $"{(int)khoangCach.TotalDays} ngày trước";

        return ngayTao.ToString("dd/MM/yyyy HH:mm");
    }
}

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    bool IsCurrent(string controller, string? action = null) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
        (action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase));

    string SubMenuClass(string controller, string? action = null) =>
        IsCurrent(controller, action) ? "sidebar-submenu-item active" : "sidebar-submenu-item";

    var trangChuOpen = IsCurrent("Admin");
    var nguoiDungOpen = IsCurrent("TaiKhoan") || IsCurrent("HocSinh", "Index") || IsCurrent("GiaoVien") || IsCurrent("PhuHuynh");
    var hocVuOpen = IsCurrent("HocVu") || IsCurrent("ChuyenLop") || IsCurrent("LenLop");
    var ketQuaOpen = IsCurrent("KetQuaHocTap") || IsCurrent("HocSinh", "KyLuat");
    var truyenThongOpen = IsCurrent("ThongBao") || IsCurrent("TinTucSuKien");
    var heThongOpen = IsCurrent("NhatKy") || IsCurrent("ChucVu");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - eSchool</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <link rel="stylesheet" href="~/css/student.css" asp-append-version="true" />
    <script src="~/js/student.js" asp-append-version="true"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/admin.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/footer.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/pagination.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/table-column-manager.css" rel="stylesheet" asp-append-version="true" />
</head>

<body>
    <div class="app">
        <aside class="sidebar">
            <div class="brand">
                <div class="brand-logo"><img src="~/images/logo.png" alt="THCS eSchool" /></div>
                <div>
                    <h3>eSchool</h3>
                    <p>School System</p>
                </div>
            </div>
            <nav class="sidebar-menu-groups" aria-label="Điều hướng quản trị">
                <div class="menu-group">
                    <button class="menu-group-toggle @(trangChuOpen ? "active" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#menu-trang-chu" aria-expanded="@trangChuOpen" aria-controls="menu-trang-chu">
                        <i class="bi bi-house-door-fill"></i><span class="menu-group-label">Trang chủ</span><i class="bi bi-chevron-down menu-group-chevron"></i>
                    </button>
                    <div id="menu-trang-chu" class="menu-submenu collapse @(trangChuOpen ? "show" : "")">
                        <a asp-controller="Admin" asp-action="Index" class="@SubMenuClass("Admin", "Index")"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                        <a asp-controller="Admin" asp-action="Index" asp-fragment="tong-quan" class="sidebar-submenu-item"><i class="bi bi-bar-chart-line-fill"></i><span>Thống kê tổng quan</span></a>
                    </div>
                </div>

                <div class="menu-group">
                    <button class="menu-group-toggle @(nguoiDungOpen ? "active" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#menu-nguoi-dung" aria-expanded="@nguoiDungOpen" aria-controls="menu-nguoi-dung">
                        <i class="bi bi-people-fill"></i><span class="menu-group-label">Quản lý người dùng</span><i class="bi bi-chevron-down menu-group-chevron"></i>
                    </button>
                    <div id="menu-nguoi-dung" class="menu-submenu collapse @(nguoiDungOpen ? "show" : "")">
                        <a asp-controller="TaiKhoan" asp-action="Index" class="@SubMenuClass("TaiKhoan", "Index")"><i class="bi bi-person-badge-fill"></i><span>Tài khoản</span></a>
                        <a asp-controller="HocSinh" asp-action="Index" class="@SubMenuClass("HocSinh", "Index")"><i class="bi bi-mortarboard-fill"></i><span>Học sinh</span></a>
                        <a asp-controller="GiaoVien" asp-action="Index" class="@SubMenuClass("GiaoVien", "Index")"><i class="bi bi-person-workspace"></i><span>Giáo viên</span></a>
                        <a asp-controller="GiaoVien" asp-action="ChuNhiem" class="@SubMenuClass("GiaoVien", "ChuNhiem")"><i class="bi bi-person-check-fill"></i><span>Chủ nhiệm lớp</span></a>
                        <a asp-controller="PhuHuynh" asp-action="Index" class="@SubMenuClass("PhuHuynh", "Index")"><i class="bi bi-person-hearts"></i><span>Phụ huynh</span></a>
                    </div>
                </div>

                <div class="menu-group">
                    <button class="menu-group-toggle @(hocVuOpen ? "active" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#menu-hoc-vu" aria-expanded="@hocVuOpen" aria-controls="menu-hoc-vu">
                        <i class="bi bi-journal-bookmark-fill"></i><span class="menu-group-label">Quản lý học vụ</span><i class="bi bi-chevron-down menu-group-chevron"></i>
                    </button>
                    <div id="menu-hoc-vu" class="menu-submenu collapse @(hocVuOpen ? "show" : "")">
                        <a asp-controller="HocVu" asp-action="LopHoc" class="@SubMenuClass("HocVu", "LopHoc")"><i class="bi bi-building"></i><span>Lớp học</span></a>
                        <a asp-controller="HocVu" asp-action="PhongHoc" class="@SubMenuClass("HocVu", "PhongHoc")"><i class="bi bi-door-open-fill"></i><span>Phòng học</span></a>
                        <a asp-controller="HocVu" asp-action="MonHoc" class="@SubMenuClass("HocVu", "MonHoc")"><i class="bi bi-book-fill"></i><span>Môn học</span></a>
                        <a asp-controller="HocVu" asp-action="NamHoc" class="@SubMenuClass("HocVu", "NamHoc")"><i class="bi bi-calendar-range"></i><span>Năm học</span></a>
                        <a asp-controller="HocVu" asp-action="HocKy" class="@SubMenuClass("HocVu", "HocKy")"><i class="bi bi-calendar2-check"></i><span>Học kỳ</span></a>
                        <a asp-controller="HocVu" asp-action="PhanCongGiaoVien" class="@SubMenuClass("HocVu", "PhanCongGiaoVien")"><i class="bi bi-person-lines-fill"></i><span>Phân công giảng dạy</span></a>
                        <a asp-controller="HocVu" asp-action="ThoiKhoaBieu" class="@SubMenuClass("HocVu", "ThoiKhoaBieu")"><i class="bi bi-calendar-week-fill"></i><span>Thời khóa biểu</span></a>
                        <a asp-controller="HocVu" asp-action="ChuyenLich" class="@SubMenuClass("HocVu", "ChuyenLich")"><i class="bi bi-calendar2-range-fill"></i><span>Chuyển lịch</span></a>
                        <a asp-controller="ChuyenLop" asp-action="Index" class="@SubMenuClass("ChuyenLop", "Index")"><i class="bi bi-arrow-left-right"></i><span>Chuyển lớp</span></a>
                        <a asp-controller="LenLop" asp-action="Index" class="@SubMenuClass("LenLop", "Index")"><i class="bi bi-mortarboard-fill"></i><span>Xét lên lớp / Tốt nghiệp</span></a>
                    </div>
                </div>

                <div class="menu-group">
                    <button class="menu-group-toggle @(ketQuaOpen ? "active" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#menu-ket-qua" aria-expanded="@ketQuaOpen" aria-controls="menu-ket-qua">
                        <i class="bi bi-clipboard2-data-fill"></i><span class="menu-group-label">Kết quả học tập</span><i class="bi bi-chevron-down menu-group-chevron"></i>
                    </button>
                    <div id="menu-ket-qua" class="menu-submenu collapse @(ketQuaOpen ? "show" : "")">
                        <a asp-controller="KetQuaHocTap" asp-action="Diem" class="@SubMenuClass("KetQuaHocTap", "Diem")"><i class="bi bi-pencil-square"></i><span>Quản lý điểm</span></a>
                        <a asp-controller="KetQuaHocTap" asp-action="DiemDanh" class="@SubMenuClass("KetQuaHocTap", "DiemDanh")"><i class="bi bi-clipboard-check-fill"></i><span>Điểm danh</span></a>
                        <a asp-controller="HocSinh" asp-action="KyLuat" class="@SubMenuClass("HocSinh", "KyLuat")"><i class="bi bi-shield-exclamation"></i><span>Kỷ luật học sinh</span></a>
                        <a asp-controller="KetQuaHocTap" asp-action="HocPhi" class="@SubMenuClass("KetQuaHocTap", "HocPhi")"><i class="bi bi-cash-coin"></i><span>Học phí</span></a>
                        <a asp-controller="KetQuaHocTap" asp-action="PhieuDiem" class="@SubMenuClass("KetQuaHocTap", "PhieuDiem")"><i class="bi bi-printer-fill"></i><span>In phiếu điểm</span></a>
                    </div>
                </div>

                <div class="menu-group">
                    <button class="menu-group-toggle @(truyenThongOpen ? "active" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#menu-truyen-thong" aria-expanded="@truyenThongOpen" aria-controls="menu-truyen-thong">
                        <i class="bi bi-megaphone-fill"></i><span class="menu-group-label">Truyền thông</span><i class="bi bi-chevron-down menu-group-chevron"></i>
                    </button>
                    <div id="menu-truyen-thong" class="menu-submenu collapse @(truyenThongOpen ? "show" : "")">
                        <a asp-controller="ThongBao" asp-action="Index" class="@SubMenuClass("ThongBao", "Index")"><i class="bi bi-bell-fill"></i><span>Thông báo</span></a>
                        <a asp-controller="TinTucSuKien" asp-action="Index" class="@SubMenuClass("TinTucSuKien", "Index")"><i class="bi bi-newspaper"></i><span>Tin tức / Sự kiện</span></a>
                    </div>
                </div>

                <div class="menu-group">
                    <button class="menu-group-toggle @(heThongOpen ? "active" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#menu-he-thong" aria-expanded="@heThongOpen" aria-controls="menu-he-thong">
                        <i class="bi bi-gear-fill"></i><span class="menu-group-label">Hệ thống</span><i class="bi bi-chevron-down menu-group-chevron"></i>
                    </button>
                    <div id="menu-he-thong" class="menu-submenu collapse @(heThongOpen ? "show" : "")">
                        <a asp-controller="NhatKy" asp-action="Index" class="@SubMenuClass("NhatKy", "Index")"><i class="bi bi-clock-history"></i><span>Nhật ký hoạt động</span></a>
                        <a asp-controller="Admin" asp-action="Index" asp-fragment="tong-quan" class="sidebar-submenu-item"><i class="bi bi-graph-up-arrow"></i><span>Báo cáo / Thống kê</span></a>
                        <span class="sidebar-submenu-item disabled" aria-disabled="true"><i class="bi bi-sliders"></i><span>Cài đặt</span><small>Sắp có</small></span>
                    </div>
                </div>
            </nav>

