@model eSchool.ViewModels.PhuHuynhViewModel

@{
    var isAdmin = Context.Session.GetInt32("RoleId") == SystemRoleIds.SystemAdmin;
    Layout = isAdmin
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Sửa phụ huynh";
}

@if (isAdmin)
{
    <div class="teacher-admin-page">
        <div class="teacher-admin-hero parent-admin-hero">
            <div>
                <span class="teacher-admin-eyebrow">Phụ huynh</span>
                <h2>Sửa phụ huynh</h2>
                <p>Cập nhật thông tin hồ sơ phụ huynh trong hệ thống.</p>
            </div>
        </div>
        <div class="teacher-admin-card">
            <div class="teacher-admin-card-head">
                <div>
                    <h3>Thông tin phụ huynh</h3>
                    <p>Điều chỉnh các thông tin cần thiết rồi lưu thay đổi.</p>
                </div>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdPhuHuynh" />
                <input type="hidden" asp-for="IdHocSinh" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                @await Html.PartialAsync("_Form", Model)
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Cập nhật</button>
                    <a asp-action="Index" class="btn btn-light">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
}
else
{
    <div class="student-panel">
        <h3>Sửa phụ huynh</h3>
        <form asp-action="Edit" method="post" class="mt-3">
            <input type="hidden" asp-for="IdPhuHuynh" />
            <input type="hidden" asp-for="IdHocSinh" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @await Html.PartialAsync("_Form", Model)
            <button class="btn btn-primary">Cập nhật</button>
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
}

<style>
    .parent-admin-hero { background: linear-gradient(135deg, #312e81 0%, #6d28d9 55%, #c084fc 100%); }
</style>
