@model List<HocSinh>
@{
    Layout = "~/Views/Shared/_AcademicLayout.cshtml";
    ViewData["Title"] = "Chuyển lớp";
}

<style>
    .filter-wrapper {
        min-height: 70vh;
        background: radial-gradient(circle at top right, rgba(238, 242, 247, 0.6), transparent),
                    radial-gradient(circle at bottom left, rgba(226, 232, 240, 0.4), transparent);
        border-radius: 1.5rem;
        margin-bottom: 2rem;
    }
    .filter-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 20px 40px rgba(0,0,0,0.04), 0 1px 3px rgba(0,0,0,0.02);
        border-radius: 24px;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .filter-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 25px 50px rgba(0,0,0,0.07), 0 5px 15px rgba(0,0,0,0.03);
    }
    .icon-wrapper {
        width: 85px; 
        height: 85px; 
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 25px;
        box-shadow: 0 10px 25px rgba(118, 75, 162, 0.3);
        transform: rotate(-3deg);
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .filter-card:hover .icon-wrapper {
        transform: rotate(0deg) scale(1.05);
    }
    .icon-wrapper i {
        color: #fff;
        font-size: 2.2rem;
        text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }
    .custom-floating > .form-select {
        height: 3.8rem;
        border-radius: 14px;
        border: 2px solid #e2e8f0;
        background-color: #f8fafc;
        font-weight: 500;
        color: #334155;
        transition: all 0.3s ease;
        padding-top: 1.625rem;
        padding-bottom: 0.625rem;
    }
    .custom-floating > .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.15);
        background-color: #ffffff;
    }
    .custom-floating > label {
        color: #64748b;
        font-weight: 500;
        padding-left: 1rem;
    }
    .btn-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        border-radius: 14px;
        padding: 14px 20px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        font-size: 0.95rem;
    }
    .btn-gradient:hover {
        background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
        box-shadow: 0 8px 20px rgba(118, 75, 162, 0.35);
        transform: translateY(-2px);
        color: white;
    }
    .btn-gradient:active {
        transform: translateY(0);
        box-shadow: 0 4px 10px rgba(118, 75, 162, 0.3);
    }
</style>

    <div class="d-flex align-items-center justify-content-center filter-wrapper py-5" style="@(ViewBag.SelectedLopId != null ? "min-height: auto;" : "")">
        <div class="filter-card p-5 text-center" style="max-width: 700px; width: 100%; margin: 0 15px;">
            <div class="icon-wrapper">
                <i class="bi bi-arrow-left-right"></i>
            </div>
            <h3 class="fw-bolder text-dark mb-2" style="letter-spacing: -0.5px;">Quản Lý Chuyển Lớp</h3>
            <p class="text-muted mb-4 pb-2" style="font-size: 0.95rem;">Lựa chọn năm học và lớp học để tiến hành điều chuyển học sinh.</p>

            <form method="get" asp-action="Index">
                <div class="row g-3 text-start mb-4">
                    <div class="col-md-6">
                        <div class="form-floating custom-floating">
                            <select name="namHoc" class="form-select" id="namHocSelect" asp-items="ViewBag.NamHocs" required>
                                <option value="" disabled selected>-- Chọn năm học --</option>
                            </select>
                            <label for="namHocSelect"><i class="bi bi-clock-history me-1 text-primary"></i> Năm học</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating custom-floating">
                            <select name="lopId" class="form-select" id="lopSelect" asp-items="ViewBag.LopHocs" required>
                                <option value="" disabled selected>-- Chọn lớp học --</option>
                            </select>
                            <label for="lopSelect"><i class="bi bi-people-fill me-1 text-primary"></i> Lớp học</label>
                        </div>
                    </div>
                </div>
                
                <button type="submit" class="btn btn-gradient btn-lg w-100 mt-2">
                    <i class="bi bi-search me-2"></i> Hiển thị danh sách
                </button>
            </form>
        </div>
    </div>
@if (ViewBag.SelectedLopId != null)
{
    var selectedLopName = (ViewBag.LopHocs as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)?.FirstOrDefault(x => x.Value == ViewBag.SelectedLopId.ToString())?.Text;
    var selectedNamHoc = ViewBag.SelectedNamHoc?.ToString() ?? "N/A";

    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bold mb-1">Danh sách học sinh</h2>
            <div class="text-muted">
                Lớp: <span class="text-primary fw-semibold">@selectedLopName</span> | Năm học: <span class="text-primary fw-semibold">@selectedNamHoc</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="LichSu" class="btn btn-outline-info">
                <i class="bi bi-clock-history me-1"></i> Lịch sử chuyển lớp
            </a>
            <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#importExcelModal">
                <i class="bi bi-file-earmark-excel me-1"></i> Nhập từ Excel
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Chọn lớp khác
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width: 60px;">STT</th>
                        <th>Học sinh</th>
                        <th>Lớp</th>
                        <th>Ngày sinh</th>
                        <th class="text-center" style="width: 150px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;
                        foreach (var hs in Model)
                        {
                            <tr>
                                <td class="text-center">@stt</td>
                                <td>
                                    <div class="fw-bold">@hs.HoTen</div>
                                    <small class="text-muted">@hs.MaHS</small>
                                </td>
                                <td>@selectedLopName</td>
                                <td>@hs.NgaySinh.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <a asp-action="Create" asp-route-id="@hs.IdHocSinh" class="btn btn-sm btn-primary">
                                        <i class="bi bi-arrow-left-right"></i> Chuyển lớp
                                    </a>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Không có học sinh nào trong lớp này.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal Import Excel -->
    <div class="modal fade" id="importExcelModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="ImportExcel" method="post" enctype="multipart/form-data">
                    <div class="modal-header">
                        <h5 class="modal-title">Nhập danh sách chuyển lớp từ Excel</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Chọn file Excel (.xlsx)</label>
                            <input type="file" name="file" class="form-control" accept=".xlsx" required />
                        </div>
                        <div class="mb-3">
                            <a asp-action="DownloadTemplate" class="text-decoration-none">
                                <i class="bi bi-download"></i> Tải file mẫu
                            </a>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-upload"></i> Nhập dữ liệu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
