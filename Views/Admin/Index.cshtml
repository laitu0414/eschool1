@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Trang chủ Admin";

    var thongBaoMoi = ViewBag.ThongBaoMoi as List<eSchool.Models.ThongBao>;
}

<div class="page-title">
    <h1>Trang chủ</h1>
    <p>Chào mừng bạn đến với hệ thống quản lý trường học eSchool</p>
</div>

<div class="row g-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <h6>Tài khoản</h6>
                    <h2>@ViewBag.SoTaiKhoan</h2>
                    <small>Tổng số tài khoản</small>
                </div>

                <div class="stat-icon stat-blue">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <h6>Chức vụ</h6>
                    <h2>@ViewBag.SoChucVu</h2>
                    <small>Phân quyền hệ thống</small>
                </div>

                <div class="stat-icon stat-green">
                    <i class="bi bi-shield-check"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <h6>Thông báo</h6>
                    <h2>@ViewBag.SoThongBao</h2>
                    <small>Tổng thông báo đã tạo</small>
                </div>

                <div class="stat-icon stat-orange">
                    <i class="bi bi-megaphone-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-top">
                <div>
                    <h6>Hệ thống</h6>
                    <h2>OK</h2>
                    <small>Đang hoạt động</small>
                </div>

                <div class="stat-icon stat-purple">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-2">
    <div class="col-md-8">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5>Thống kê tổng thu học phí</h5>

                <select id="yearSelect" class="form-select w-auto" onchange="updateChart()">
                    @if (ViewBag.NamHocs != null)
                    {
                        foreach (var nam in ViewBag.NamHocs)
                        {
                            <option value="@nam.TenNamHoc">Năm học @nam.TenNamHoc</option>
                        }
                    }
                </select>
            </div>

            <div class="chart-container" style="position: relative; height: 280px; width: 100%;">
                <canvas id="tuitionChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="content-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5>Thông báo mới</h5>

                <a asp-controller="ThongBao"
                   asp-action="Index"
                   class="btn btn-sm btn-primary">
                    Xem tất cả
                </a>
            </div>

            @if (thongBaoMoi != null && thongBaoMoi.Any())
            {
                <div class="notice-list">
                    @foreach (var tb in thongBaoMoi)
                    {
                        <div class="notice">
                            <div class="notice-icon orange">
                                <i class="bi bi-megaphone-fill"></i>
                            </div>

                            <div>
                                <strong>@tb.TieuDe</strong>
                                <p>@tb.NgayTao.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-notice">
                    <i class="bi bi-inbox"></i>
                    <p>Chưa có thông báo nào</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .chart-container {
        background: #f8fafc;
        border-radius: 16px;
        padding: 16px;
    }

    .notice {
        display: flex;
        gap: 14px;
        padding: 14px;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        margin-bottom: 12px;
        background: #fff;
    }

    .notice-icon {
        min-width: 44px;
        height: 44px;
        border-radius: 13px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

        .notice-icon.orange {
            background: #ffedd5;
            color: #f97316;
        }

    .notice strong {
        display: block;
        color: #0f172a;
        font-size: 15px;
        line-height: 1.3;
    }

    .notice p {
        margin: 5px 0 0;
        color: #64748b;
        font-size: 13px;
    }

    .empty-notice {
        height: 190px;
        border: 2px dashed #cbd5e1;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: #64748b;
    }

        .empty-notice i {
            font-size: 40px;
            margin-bottom: 8px;
        }

        .empty-notice p {
            margin: 0;
        }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('tuitionChart').getContext('2d');
        let tuitionChart;

        const rawChartData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartData ?? new object[] {}));

        function initChart(data) {
            if (tuitionChart) {
                tuitionChart.destroy();
            }

            tuitionChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Học kỳ 1', 'Học kỳ 2'],
                    datasets: [{
                        label: 'Tổng thu học phí (VNĐ)',
                        data: data,
                        backgroundColor: [
                            'rgba(59, 130, 246, 0.8)',
                            'rgba(29, 78, 216, 0.8)'
                        ],
                        borderColor: [
                            'rgb(59, 130, 246)',
                            'rgb(29, 78, 216)'
                        ],
                        borderWidth: 1,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.parsed.y.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return value.toLocaleString('vi-VN') + ' đ';
                                }
                            }
                        }
                    }
                }
            });
        }

        function updateChart() {
            const selectEl = document.getElementById('yearSelect');
            if (!selectEl) return;
            const year = selectEl.value;
            const dataForYear = rawChartData.find(x => x.NamHoc === year);
            
            let data = [0, 0];
            if (dataForYear) {
                data = [dataForYear.HK1, dataForYear.HK2];
            }
            
            initChart(data);
        }

        document.addEventListener("DOMContentLoaded", function() {
            updateChart();
        });
    </script>
}