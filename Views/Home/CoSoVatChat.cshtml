@{
    ViewData["Title"] = "Cơ sở vật chất";
    ViewData["ActiveMenu"] = "CoSoVatChat";
}

<div class="container my-5">
    <div class="row">
        <div class="col-lg-3 mb-4">
            @await Html.PartialAsync("_SidebarGioiThieu")
        </div>
        <div class="col-lg-9">
            <div class="card rounded-0 border-1" style="border-color: #e0e0e0;">
                <div class="card-header rounded-0 text-white" style="background-color: #e66624; border-bottom: none; font-size: 14px;">
                    Trang chủ <i class="bi bi-chevron-right" style="font-size: 10px; margin: 0 5px;"></i> Cơ sở vật chất
                </div>
                <div class="card-body p-4 pt-3 bg-white">
                    <h1 class="mb-3 text-uppercase" style="color: #e66624; font-size: 26px;">Cơ sở vật chất</h1>
                    
                    <div style="text-align: center; margin-bottom: 20px;">
                        <img src="/image/csvc.png" alt="Cơ sở vật chất" style="max-width: 100%; height: auto; border: 1px solid #ddd; box-shadow: 0 4px 8px rgba(0,0,0,0.1);" />
                    </div>

                    <p style="font-family: Roboto, sans-serif; text-align: justify; line-height: 1.6;">
                        Được sự quan tâm của các cấp lãnh đạo, eSchool được đầu tư theo mô hình chất lượng cao, chương trình song bằng và trường học điện tử, với mục tiêu mang đến cho học sinh môi trường học tập an toàn, hiện đại và khang trang nhất.
                    </p>

                    <h4 class="mt-4 text-primary" style="color: #e66624 !important;">1. Quy mô và thiết kế phòng học</h4>
                    <p style="text-align: justify; line-height: 1.6;">
                        - Trường có tổng diện tích đất gần <strong>8000 m2</strong>, diện tích xây dựng: 3000 m2, tổng diện tích sàn: trên 11 nghìn m2; mật độ xây dựng 40%.<br>
                        - Xây dựng với quy mô 24 phòng học gồm 16 phòng học theo mô hình chất lượng cao, diện tích 65m2/phòng; 8 phòng học theo tiêu chuẩn hệ Cambridge diện tích 78m2/ phòng.<br>
                        - Mỗi phòng học được trang bị các thiết bị dạy học như: máy tính, ti vi tương tác, hệ thống bảng trượt từ chống lóa, bộ âm thanh... <br>
                        - Phòng học đảm bảo đủ ánh sáng quy chuẩn, có rèm che cửa sổ, có hệ thống điều hòa, quạt, có đủ bàn ghế giáo viên, bàn ghế học sinh (mỗi học sinh 1 bộ bàn ghế riêng), có 01 tủ đựng đồ riêng cho từng học sinh.
                    </p>

                    <h4 class="mt-4 text-primary" style="color: #e66624 !important;">2. Khu giáo dục thể chất</h4>
                    <p style="text-align: justify; line-height: 1.6;">
                        Nhà tập đa năng với tổng diện tích 696m2, có sân bóng đá, bóng rổ, đường chạy tiêu chuẩn và đầy đủ các dụng cụ luyện tập GDTC, đảm bảo các hoạt động giáo dục phát triển toàn diện cho học sinh cả về trí lực lẫn thể lực.
                    </p>

                    <h4 class="mt-4 text-primary" style="color: #e66624 !important;">3. Khu bếp, nhà ăn và khu bán trú</h4>
                    <p style="text-align: justify; line-height: 1.6;">
                        Trường có khu bếp và nhà ăn rộng rãi, đảm bảo quy định nghiêm ngặt về an toàn thực phẩm bếp ăn bán trú. Nhà ăn có thể phục vụ cho khoảng 500 học sinh. Có phòng nghỉ bán trú học sinh nam, nữ và giáo viên riêng biệt, đảm bảo cho học sinh chỗ học, chỗ ăn, chỗ nghỉ riệng biệt và tiện nghi, tất cả các phòng đều được lắp đặt máy điều hoà và các phương tiện chăm sóc sức khoẻ hiện đại.
                    </p>

                    <div style="text-align: center; margin-top: 30px; margin-bottom: 20px;">
                        <img src="/images/co-so-vat-chat.jpg" alt="Cơ sở vật chất eSchool" style="max-width: 100%; height: auto; border: 1px solid #ddd; padding: 5px;" onerror="this.src='https://via.placeholder.com/800x400?text=Hinh+Anh+Co+So+Vat+Chat'"/>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
