@{
    ViewData["Title"] = "Cơ sở vật chất";
    ViewData["ActiveMenu"] = "CoSoVatChat";
}

<style>
    .intro-page-card {
        border-radius: 1rem;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
        background: #ffffff;
        overflow: hidden;
    }
    .intro-breadcrumb-bar {
        background: linear-gradient(135deg, #0d47a1 0%, #1e40af 100%);
        color: #ffffff;
        padding: 12px 24px;
        font-size: 13.5px;
        font-weight: 500;
    }
    .intro-breadcrumb-bar a {
        color: #bfdbfe;
        text-decoration: none;
        transition: color 0.2s;
    }
    .intro-breadcrumb-bar a:hover {
        color: #ffffff;
    }
    .intro-title {
        font-size: 26px;
        font-weight: 800;
        color: #0f172a;
        position: relative;
        display: inline-block;
        letter-spacing: -0.5px;
    }
    .intro-title::after {
        content: '';
        position: absolute;
        bottom: -8px;
        left: 0;
        width: 60px;
        height: 4px;
        background: linear-gradient(90deg, #2563eb, #60a5fa);
        border-radius: 2px;
    }
    .facility-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 24px;
        transition: all 0.3s ease;
    }
    .facility-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);
        border-color: #93c5fd;
    }
    .facility-icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }
    .facility-stat-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px;
        text-align: center;
    }
    .facility-stat-card .stat-number {
        font-size: 22px;
        font-weight: 800;
        color: #1e40af;
    }
</style>

<div class="container my-5">
    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3">
            @await Html.PartialAsync("_SidebarGioiThieu")
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="intro-page-card">
                <!-- Breadcrumb Bar -->
                <div class="intro-breadcrumb-bar d-flex align-items-center">
                    <i class="bi bi-house-door-fill me-2"></i>
                    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                    <i class="bi bi-chevron-right mx-2 text-white-50" style="font-size: 11px;"></i>
                    <span class="text-white-50">Giới thiệu</span>
                    <i class="bi bi-chevron-right mx-2 text-white-50" style="font-size: 11px;"></i>
                    <span class="text-white fw-semibold">Cơ sở vật chất</span>
                </div>

                <div class="p-4 p-md-5">
                    <!-- Page Header -->
                    <div class="mb-4 pb-2">
                        <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-bold text-uppercase" style="font-size: 12px; letter-spacing: 1px;">
                            <i class="bi bi-building-fill-check"></i> Không gian học tập hiện đại
                        </div>
                        <h1 class="intro-title">Cơ Sở Vật Chất Chuẩn Quốc Tế</h1>
                    </div>

                    <!-- Showcase Image -->
                    <div class="text-center my-4">
                        <img src="/image/csvc.png" 
                             alt="Cơ sở vật chất eSchool" 
                             class="img-fluid rounded-4 shadow-sm border" 
                             style="max-height: 420px; width: 100%; object-fit: cover;"
                             onerror="this.src='/images/co-so-vat-chat.jpg'" />
                    </div>

                    <!-- Lead Paragraph -->
                    <p class="lead text-secondary mb-4" style="font-size: 15.5px; line-height: 1.8; text-align: justify;">
                        Được sự quan tâm của các cấp lãnh đạo và các chuyên gia kiến trúc học đường quốc tế, <strong>eSchool</strong> được quy hoạch và đầu tư đồng bộ theo mô hình chất lượng cao, tích hợp trường học thông minh (Smart School) nhằm kiến tạo không gian giáo dục an toàn, tiện nghi và truyền cảm hứng sáng tạo tối đa cho học sinh.
                    </p>

                    <!-- Key Stats Grid -->
                    <div class="row g-3 mb-4">
                        <div class="col-6 col-md-3">
                            <div class="facility-stat-card">
                                <div class="stat-number">~8.000 m²</div>
                                <div class="text-muted small mt-1">Tổng khuôn viên</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="facility-stat-card">
                                <div class="stat-number">>11.000 m²</div>
                                <div class="text-muted small mt-1">Diện tích sàn sử dụng</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="facility-stat-card">
                                <div class="stat-number">24 Phòng</div>
                                <div class="text-muted small mt-1">Quy chuẩn cao cấp</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="facility-stat-card">
                                <div class="stat-number">696 m²</div>
                                <div class="text-muted small mt-1">Nhà tập đa năng</div>
                            </div>
                        </div>
                    </div>

                    <!-- Facility Sections -->
                    <div class="d-flex flex-column gap-3 mb-4">
                        <!-- Facility 1: Smart Classrooms -->
                        <div class="facility-card">
                            <div class="d-flex align-items-start gap-3">
                                <div class="facility-icon-wrap bg-primary bg-opacity-10 text-primary">
                                    <i class="bi bi-display"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="fw-bold text-dark mb-2">1. Quy mô & Thiết kế Phòng học Thông minh</h5>
                                    <p class="text-secondary small mb-3" style="line-height: 1.7; text-align: justify;">
                                        Trường xây dựng quy mô 24 phòng học gồm 16 phòng học tiêu chuẩn chất lượng cao (65m²/phòng) và 8 phòng học tiêu chuẩn Quốc tế Cambridge (78m²/phòng).
                                    </p>
                                    <div class="row g-2 text-muted small">
                                        <div class="col-md-6 d-flex align-items-center gap-2">
                                            <i class="bi bi-check2-circle text-primary"></i> Màn hình tương tác thông minh & bảng trượt chống lóa
                                        </div>
                                        <div class="col-md-6 d-flex align-items-center gap-2">
                                            <i class="bi bi-check2-circle text-primary"></i> Điều hòa 2 chiều & lọc không khí quy chuẩn
                                        </div>
                                        <div class="col-md-6 d-flex align-items-center gap-2">
                                            <i class="bi bi-check2-circle text-primary"></i> Bàn ghế công thái học linh hoạt từng cá nhân
                                        </div>
                                        <div class="col-md-6 d-flex align-items-center gap-2">
                                            <i class="bi bi-check2-circle text-primary"></i> Tủ locker riêng biệt cho mỗi học sinh
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Facility 2: Sports Center -->
                        <div class="facility-card">
                            <div class="d-flex align-items-start gap-3">
                                <div class="facility-icon-wrap bg-success bg-opacity-10 text-success">
                                    <i class="bi bi-trophy"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="fw-bold text-dark mb-2">2. Khu Giáo Dục Thể Chất Toàn Diện</h5>
                                    <p class="text-secondary small mb-0" style="line-height: 1.7; text-align: justify;">
                                        Nhà thi đấu đa năng hiện đại diện tích <strong>696m²</strong>, tích hợp sân bóng đá mini cỏ nhân tạo, sân bóng rổ tiêu chuẩn thi đấu, đường chạy điền kinh đạt chuẩn và trang bị đầy đủ các dụng cụ rèn luyện thể chất, tạo điều kiện phát triển chiều cao và tầm vóc cho học sinh.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Facility 3: Cafeteria & Boarding -->
                        <div class="facility-card">
                            <div class="d-flex align-items-start gap-3">
                                <div class="facility-icon-wrap bg-warning bg-opacity-10 text-warning">
                                    <i class="bi bi-cup-straw"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="fw-bold text-dark mb-2">3. Khu Bếp, Nhà Ăn & Khu Bán Trú Tiện Nghi</h5>
                                    <p class="text-secondary small mb-0" style="line-height: 1.7; text-align: justify;">
                                        Nhà ăn bán trú thiết kế thông thoáng, vận hành theo quy trình bếp ăn 1 chiều nghiêm ngặt, phục vụ đồng thời cho <strong>500 học sinh</strong> với thực đơn dinh dưỡng cân bằng. Khu phòng nghỉ bán trú chia tách riêng biệt giữa học sinh Nam và Nữ, trang bị máy điều hòa và bộ phận y tế thường trực chăm sóc sức khỏe 24/7.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Secondary Photo -->
                    <div class="text-center my-4">
                        <img src="/images/co-so-vat-chat.jpg" 
                             alt="Cơ sở vật chất eSchool" 
                             class="img-fluid rounded-4 shadow-sm border" 
                             style="max-height: 380px; width: 100%; object-fit: cover;"
                             onerror="this.style.display='none'" />
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
