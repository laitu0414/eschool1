    <div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content portal-login-modal">
                <div class="modal-header border-0 pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-0 px-4 px-md-5 pb-4 pb-md-5">
                    <div class="portal-login-logo"><img src="~/images/logo.png" alt="THCS eSchool" style="width: 100%; height: 100%; object-fit: contain; border-radius: inherit;" /></div>
                    <h2>Đăng nhập eSchool</h2>
                    <p id="selectedLoginPortal">@selectedLoginPortalName</p>

                    @if (TempData["LoginError"] != null)
                    {
                        <div class="alert alert-danger">@TempData["LoginError"]</div>
                    }

                    @if (TempData["AuthSuccess"] != null)
                    {
                        <div class="alert alert-success">@TempData["AuthSuccess"]</div>
                    }

                    <form asp-controller="Account" asp-action="Login" method="post" class="portal-login-form">
                        @Html.AntiForgeryToken()
                        <input id="loginRole" name="loginRole" type="hidden" value="@Model.LoginRole" />
                        <div class="mb-3">
                            <label class="form-label">Số điện thoại hoặc email <span class="text-danger">*</span></label>
                            <input name="username" class="form-control" maxlength="100" autocomplete="username" required placeholder="SĐT hoặc email" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mật khẩu <span class="text-danger">*</span></label>
                            <input name="password" type="password" class="form-control" autocomplete="current-password" required />
                        </div>
                        <button id="loginSubmitButton" type="submit" class="btn portal-submit-btn w-100" disabled="@(Model.LoginRole == null ? "disabled" : null)">Đăng nhập</button>
                    </form>

                    <div class="text-center mt-3">
                        <button type="button"
                                class="portal-forgot-link portal-link-button"
                                data-bs-target="#forgotPasswordModal"
                                data-bs-toggle="modal"
                                data-bs-dismiss="modal">
                            Quên mật khẩu?
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="forgotPasswordModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content portal-login-modal">
                <div class="modal-header border-0 pb-0">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body pt-0 px-4 px-md-5 pb-4 pb-md-5">
                    <div class="portal-login-logo"><i class="bi bi-key-fill"></i></div>
                    <h2>Quên mật khẩu</h2>
                    <p>Nhập tên đăng nhập để hệ thống tạo mật khẩu mới và gửi về email đã lưu.</p>

                    @if (TempData["ForgotPasswordError"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ForgotPasswordError"]</div>
                    }

                    <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="portal-login-form">
                        @Html.AntiForgeryToken()
                        <input name="loginRole" type="hidden" value="@Model.LoginRole" />
                        <div class="mb-3">
                            <label class="form-label">Số điện thoại hoặc email <span class="text-danger">*</span></label>
                            <input name="username" class="form-control" maxlength="100" autocomplete="username" required />
                        </div>
                        <button type="submit" class="btn portal-submit-btn w-100">Gửi mật khẩu mới</button>
                    </form>

                    <div class="text-center mt-3">
                        <button type="button"
                                class="portal-forgot-link portal-link-button"
                                data-bs-target="#loginModal"
                                data-bs-toggle="modal"
                                data-bs-dismiss="modal">
                            Quay lại đăng nhập
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            function updateVietnameseDate() {
                var days = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
                var now = new Date();
                var dayName = days[now.getDay()];
                var day = String(now.getDate()).padStart(2, '0');
                var month = String(now.getMonth() + 1).padStart(2, '0');
                var year = now.getFullYear();
                var formatted = dayName + ', ' + day + '/' + month + '/' + year;
                var els = document.querySelectorAll('.header-current-date');
                els.forEach(function (el) { el.textContent = formatted; });
            }
            updateVietnameseDate();
        })();
    </script>
    @if (Model.OpenLogin || Model.OpenForgotPassword)
    {
        <script>
            window.addEventListener('load', function () {
                var modalElement = document.getElementById('@(Model.OpenForgotPassword ? "forgotPasswordModal" : "loginModal")');
                if (modalElement) {
                    bootstrap.Modal.getOrCreateInstance(modalElement).show();
                }
            });
        </script>
    }

</body>
</html>
