                                <div class="testimonial-avatar bg-info text-white">
                                    <i class="bi bi-mortarboard-fill"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold" style="font-size: 13.5px;">Em Trần Đức Minh</h6>
