                    <div class="col-lg-8">
                        <span class="badge bg-warning text-dark px-3 py-1.5 rounded-pill fw-bold text-uppercase mb-2" style="font-size: 11px; letter-spacing: 0.8px;">
                            Tuyển Sinh Năm Học Mới
                        </span>
