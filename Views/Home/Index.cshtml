                                        <div class="sub-news-title">@item.TieuDe</div>
                                        <div class="sub-news-date"><i class="bi bi-clock me-1"></i>@item.NgayTao.ToString("dd/MM/yyyy")</div>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                </div>

                <!-- Right: Bảng thông báo + Top tin đọc nhiều -->
                <div class="col-lg-4">
                    <!-- Notice Board Card -->
                    <div class="notice-board-card mb-4" id="cat-3">
                        <div class="notice-board-header">
                            <h4><i class="bi bi-bell-fill"></i> Bảng Thông Báo</h4>
                            <span class="badge bg-white text-primary rounded-pill px-2" style="font-size: 0.72rem; font-weight: 700;">Mới nhất</span>
                        </div>
                        <div class="notice-board-list">
                            @if (Model.ThongBaos != null && Model.ThongBaos.Any())
                            {
                                @foreach (var tb in Model.ThongBaos.Take(5))
                                {
                                    <div class="notice-board-item">
                                        <div class="notice-date-badge">
                                            <span class="day">@tb.NgayTao.ToString("dd")</span>
                                            <span class="month">Th@(tb.NgayTao.Month)</span>
                                        </div>
                                        <div class="notice-item-content">
                                            <div class="notice-item-title" title="@tb.TieuDe">
                                                @tb.TieuDe
                                            </div>
                                            <div class="text-muted" style="font-size: 0.72rem;">
                                                <i class="bi bi-people me-1"></i>@tb.TenDoiTuongNhan &nbsp;&middot;&nbsp; @tb.NgayTao.ToString("HH:mm")
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="p-4 text-center text-muted" style="font-size: 0.85rem;">
                                    <i class="bi bi-inbox fs-3 d-block mb-1 text-secondary"></i>
                                    Chưa có thông báo mới
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Top Viewed Card -->
                    <div class="top-view-card">
                        <div class="top-view-head">
                            <i class="bi bi-graph-up-arrow text-primary"></i> Đọc Nhiều Nhất
                        </div>
                        <div>
                            @{
                                var topViews = Model.TopTinTucHomNay.Any() ? Model.TopTinTucHomNay : Model.TinTucSuKiens.OrderByDescending(x => x.LuotXem).Take(5).ToList();
                                int rank = 1;
                            }
                            @if (topViews.Any())
                            {
                                @foreach (var topItem in topViews.Take(5))
                                {
                                    var rankClass = rank == 1 ? "rank-1" : rank == 2 ? "rank-2" : rank == 3 ? "rank-3" : "";
                                    <a href="@(string.IsNullOrWhiteSpace(topItem.DuongDan) ? "#" : topItem.DuongDan)" target="@(string.IsNullOrWhiteSpace(topItem.DuongDan) || topItem.DuongDan.StartsWith("#") ? "_self" : "_blank")" class="top-view-item">
                                        <span class="top-view-rank @rankClass">@rank</span>
                                        <div style="flex: 1; min-width: 0;">
                                            <div class="top-view-title">@topItem.TieuDe</div>
                                            <div class="text-muted mt-1" style="font-size: 0.72rem;">
                                                <i class="bi bi-eye me-1"></i>@topItem.LuotXem.ToString("N0") lượt xem
                                            </div>
                                        </div>
                                    </a>
                                    rank++;
                                }
                            }
                            else
                            {
                                <div class="py-3 text-center text-muted" style="font-size: 0.82rem;">
                                    Đang cập nhật danh sách...
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

