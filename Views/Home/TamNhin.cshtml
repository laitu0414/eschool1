@{
    ViewData["Title"] = "Tầm nhìn và sứ mệnh";
    ViewData["ActiveMenu"] = "TamNhin";
}

<style>
    .intro-page-card {
        border-radius: 1rem;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
        background: #ffffff;
        overflow: hidden;
    }
    .intro-breadcrumb-bar {
        background: linear-gradient(135deg, #0d47a1 0%, #1e40af 100%);
        color: #ffffff;
        padding: 12px 24px;
        font-size: 13.5px;
        font-weight: 500;
    }
    .intro-breadcrumb-bar a {
        color: #bfdbfe;
        text-decoration: none;
        transition: color 0.2s;
    }
    .intro-breadcrumb-bar a:hover {
        color: #ffffff;
    }
    .intro-title {
        font-size: 26px;
        font-weight: 800;
        color: #0f172a;
        position: relative;
        display: inline-block;
        letter-spacing: -0.5px;
    }
    .intro-title::after {
        content: '';
        position: absolute;
        bottom: -8px;
        left: 0;
        width: 60px;
        height: 4px;
        background: linear-gradient(90deg, #2563eb, #60a5fa);
        border-radius: 2px;
    }
    .section-badge-title {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f8fafc;
        border-left: 4px solid #2563eb;
        padding: 10px 16px;
        border-radius: 0 8px 8px 0;
        font-size: 18px;
        font-weight: 700;
        color: #1e293b;
        margin-top: 28px;
        margin-bottom: 16px;
    }
    .contact-info-card {
        background: linear-gradient(135deg, #f0f7ff 0%, #eef2ff 100%);
        border: 1px solid #bfdbfe;
        border-radius: 12px;
        padding: 20px 24px;
    }
    .core-value-card {
        border-radius: 12px;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .core-value-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 16px rgba(0,0,0,0.06);
    }
    .stat-pill {
        background: #f1f5f9;
        border-radius: 10px;
        padding: 12px;
        text-align: center;
        border: 1px solid #e2e8f0;
    }
    .stat-pill strong {
        font-size: 20px;
        color: #2563eb;
        display: block;
    }
    .feature-list-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 10px;
        line-height: 1.6;
    }
    .feature-list-item i {
        color: #2563eb;
        margin-top: 3px;
        flex-shrink: 0;
    }
    .signature-card {
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 12px;
        padding: 18px 24px;
        display: inline-block;
        text-align: center;
    }
</style>

<div class="container my-5">
    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3">
            @await Html.PartialAsync("_SidebarGioiThieu")
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <div class="intro-page-card">
                <!-- Breadcrumb Bar -->
                <div class="intro-breadcrumb-bar d-flex align-items-center">
                    <i class="bi bi-house-door-fill me-2"></i>
                    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                    <i class="bi bi-chevron-right mx-2 text-white-50" style="font-size: 11px;"></i>
                    <span class="text-white-50">Giới thiệu</span>
                    <i class="bi bi-chevron-right mx-2 text-white-50" style="font-size: 11px;"></i>
                    <span class="text-white fw-semibold">Tầm nhìn và sứ mệnh</span>
                </div>

                <div class="p-4 p-md-5">
                    <!-- Page Header -->
                    <div class="mb-4 pb-2">
                        <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-bold text-uppercase" style="font-size: 12px; letter-spacing: 1px;">
                            <i class="bi bi-compass-fill"></i> Định hướng phát triển
                        </div>
                        <h1 class="intro-title">Hệ Thống Giáo Dục eSchool</h1>
                    </div>

                    <!-- Introduction Paragraph -->
                    <p class="lead text-secondary" style="font-size: 16px; line-height: 1.8; text-align: justify;">
                        Hệ thống giáo dục eSchool ra đời với sứ mệnh mang lại môi trường học tập tiên tiến, hiện đại. Nhằm lan tỏa tinh thần hiếu học đến mọi thế hệ học trò, trên mảnh đất trải dài hình chữ S, eSchool tự hào là hệ thống giáo dục chất lượng cao, tiên phong trong việc ứng dụng công nghệ vào công tác giảng dạy và quản lý nhà trường. Thật vinh dự biết bao cho nền giáo dục nước nhà khi có một hệ thống giáo dục hiện đại và mang tầm cỡ quốc tế như eSchool.
                    </p>

                    <!-- Contact & Overview Box -->
                    <div class="contact-info-card my-4">
                        <h6 class="fw-bold text-primary text-uppercase mb-3">
                            <i class="bi bi-building me-2"></i> Thông tin liên hệ chung
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2 text-dark">
                                    <i class="bi bi-geo-alt-fill text-danger"></i>
                                    <span><strong>Địa chỉ:</strong> Khu công nghệ cao, Hà Nội</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2 text-dark">
                                    <i class="bi bi-globe2 text-primary"></i>
                                    <span><strong>Website:</strong> <a href="http://eschool.vn" class="text-decoration-none fw-semibold">eschool.vn</a></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2 text-dark">
                                    <i class="bi bi-envelope-fill text-warning"></i>
                                    <span><strong>Email:</strong> contact@eschool.vn</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2 text-dark">
                                    <i class="bi bi-telephone-fill text-success"></i>
                                    <span><strong>Điện thoại:</strong> 024 38 22 33 66</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 1. TẦM NHÌN VÀ SỨ MỆNH -->
                    <div class="section-badge-title">
                        <i class="bi bi-eye-fill text-primary"></i> 1. TẦM NHÌN VÀ SỨ MỆNH
                    </div>
                    
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <h6 class="fw-bold text-primary mb-2"><i class="bi bi-binoculars-fill me-1"></i> Tầm nhìn</h6>
                                <p class="text-muted small mb-0" style="line-height: 1.6;">
                                    eSchool hướng tới môi trường giáo dục chất lượng cao, hiện đại và thân thiện, giúp học sinh được phát triển toàn diện, thành công và trở thành công dân toàn cầu trong tương lai.
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border h-100">
                                <h6 class="fw-bold text-success mb-2"><i class="bi bi-flag-fill me-1"></i> Sứ mệnh</h6>
                                <ul class="list-unstyled text-muted small mb-0">
                                    <li class="mb-1"><i class="bi bi-check2 text-success me-1"></i> Đề cao tính tự giác, tích cực và ý thức cộng đồng.</li>
                                    <li class="mb-1"><i class="bi bi-check2 text-success me-1"></i> Tôn trọng tư duy độc lập, sáng tạo, tự tin.</li>
                                    <li><i class="bi bi-check2 text-success me-1"></i> Phát huy chuẩn mực GD Việt Nam kết hợp phương pháp hiện đại.</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-white rounded-3 border">
                        <h6 class="fw-bold text-dark mb-2">
                            <i class="bi bi-gem text-warning me-1"></i> Giá trị cốt lõi: 
                            <span class="text-primary">“Chất lượng – Trách nhiệm – Đoàn kết – Sáng tạo – Cống hiến”</span>
                        </h6>
                        <div class="row g-2 mt-2">
                            <div class="col-md-6">
                                <div class="p-2.5 rounded bg-light border-start border-3 border-primary small">
                                    <strong>Môi trường thân thiện:</strong> Quan hệ Thầy - Trò - Phụ huynh cởi mở, tôn trọng sự khác biệt cá nhân.
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-2.5 rounded bg-light border-start border-3 border-success small">
                                    <strong>Sự công bằng:</strong> Mọi học sinh đều có quyền và cơ hội bình đẳng trong mọi hoạt động giáo dục.
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-2.5 rounded bg-light border-start border-3 border-warning small">
                                    <strong>Sự ưu tú:</strong> Hướng từng cá nhân tới đỉnh cao thông qua rèn luyện và ý chí tạo khác biệt.
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-2.5 rounded bg-light border-start border-3 border-info small">
                                    <strong>Sự tự tin:</strong> Tự trọng, tôn trọng người khác, sáng tạo và không ngừng khát vọng vươn lên.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. MÔ HÌNH HOẠT ĐỘNG -->
                    <div class="section-badge-title">
                        <i class="bi bi-diagram-3-fill text-primary"></i> 2. MÔ HÌNH HOẠT ĐỘNG
                    </div>
                    <p class="text-muted" style="line-height: 1.7;">
                        eSchool hoạt động theo mô hình trường chất lượng cao, tích hợp lớp song bằng chuẩn Quốc tế Cambridge:
                    </p>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border text-center h-100">
                                <i class="bi bi-mortarboard-fill text-primary fs-3 mb-2 d-block"></i>
                                <h6 class="fw-bold mb-1">Lớp Song Bằng</h6>
                                <p class="small text-muted mb-0">Khối 6: 2 lớp (25 HS/lớp), thi tuyển toàn thành phố theo chuẩn Cambridge.</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border text-center h-100">
                                <i class="bi bi-award-fill text-success fs-3 mb-2 d-block"></i>
                                <h6 class="fw-bold mb-1">Chất Lượng Cao</h6>
                                <p class="small text-muted mb-0">Khối 6, 7, 8 sĩ số dưới 40 HS/lớp theo hình thức xét tuyển chọn lọc.</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border text-center h-100">
                                <i class="bi bi-graph-up-arrow text-warning fs-3 mb-2 d-block"></i>
                                <h6 class="fw-bold mb-1">Quy Mô Phát Triển</h6>
                                <p class="small text-muted mb-0">Mở rộng đồng bộ tới 24 lớp học tiêu chuẩn cao đáp ứng nhu cầu học tập.</p>
                            </div>
                        </div>
                    </div>

                    <!-- 3. CƠ SỞ VẬT CHẤT -->
                    <div class="section-badge-title">
                        <i class="bi bi-building-check text-primary"></i> 3. CƠ SỞ VẬT CHẤT ĐỒNG BỘ
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6 col-md-3">
                            <div class="stat-pill">
                                <strong>8.000 m²</strong>
                                <span class="small text-muted">Tổng diện tích đất</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-pill">
                                <strong>11.000 m²</strong>
                                <span class="small text-muted">Tổng diện tích sàn</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-pill">
                                <strong>24 Phòng</strong>
                                <span class="small text-muted">Phòng học thông minh</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-pill">
                                <strong>696 m²</strong>
                                <span class="small text-muted">Nhà thi đấu đa năng</span>
                            </div>
                        </div>
                    </div>
                    <div class="feature-list-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span class="text-secondary"><strong>Phòng học chuẩn quốc tế:</strong> Máy tính, tivi tương tác, bảng trượt từ chống lóa, hệ thống máy lạnh, ánh sáng quy chuẩn, bàn ghế cá nhân và tủ locker riêng cho từng học sinh.</span>
                    </div>
                    <div class="feature-list-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span class="text-secondary"><strong>Khu giáo dục thể chất:</strong> Sân bóng đá mini, sân bóng rổ, đường chạy tiêu chuẩn cùng đầy đủ dụng cụ thể thao phát triển tầm vóc học sinh.</span>
                    </div>
                    <div class="feature-list-item">
                        <i class="bi bi-check-circle-fill"></i>
                        <span class="text-secondary"><strong>Khu bếp & Bán trú hiện đại:</strong> Bếp ăn một chiều an toàn thực phẩm, phục vụ trên 500 học sinh; phòng nghỉ nam/nữ riêng biệt lắp điều hòa tiện nghi.</span>
                    </div>

                    <!-- 4. ĐỘI NGŨ CÁN BỘ - GIÁO VIÊN -->
                    <div class="section-badge-title">
                        <i class="bi bi-people-fill text-primary"></i> 4. ĐỘI NGŨ CÁN BỘ - GIÁO VIÊN
                    </div>
                    <p class="text-muted">Đội ngũ nhà giáo hội tụ <strong>Tâm - Tầm - Tài</strong> với năng lực chuyên môn và sư phạm vượt trội:</p>
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <div class="p-3 bg-primary bg-opacity-10 rounded-3 border border-primary border-opacity-25 text-center">
                                <div class="fs-4 fw-bold text-primary">100%</div>
                                <div class="small fw-semibold text-dark">Tốt nghiệp Đại học trở lên</div>
                                <div class="text-muted" style="font-size: 12px;">Hơn 30% có trình độ Thạc sĩ</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-success bg-opacity-10 rounded-3 border border-success border-opacity-25 text-center">
                                <div class="fs-4 fw-bold text-success">70%</div>
                                <div class="small fw-semibold text-dark">Giáo viên dạy giỏi cấp Quận/TP</div>
                                <div class="text-muted" style="font-size: 12px;">Kinh nghiệm bồi dưỡng HSG</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-warning bg-opacity-10 rounded-3 border border-warning border-opacity-25 text-center">
                                <div class="fs-4 fw-bold text-warning">30%</div>
                                <div class="small fw-semibold text-dark">Giáo viên tài năng trẻ</div>
                                <div class="text-muted" style="font-size: 12px;">Đào tạo song bằng & Thủ khoa ĐH</div>
                            </div>
                        </div>
                    </div>

                    <!-- 5. MỤC TIÊU ĐÀO TẠO -->
                    <div class="section-badge-title">
                        <i class="bi bi-bullseye text-primary"></i> 5. MỤC TIÊU ĐÀO TẠO & HỘI NHẬP
                    </div>
                    <div class="feature-list-item">
                        <i class="bi bi-arrow-right-circle-fill"></i>
                        <span class="text-secondary">Đào tạo chất lượng cao, giúp học sinh phát triển toàn diện năng lực, kiến tạo nền tảng vững vàng thi đỗ vào các trường THPT Chuyên và công lập hàng đầu.</span>
                    </div>
                    <div class="feature-list-item">
                        <i class="bi bi-arrow-right-circle-fill"></i>
                        <span class="text-secondary">Học sinh hệ song bằng tự tin đạt chuẩn IGCSE Cambridge quốc tế, mở rộng cơ hội học tiếp A-Level hoặc du học tại các trường đại học danh tiếng thế giới.</span>
                    </div>

                    <!-- 6. PHƯƠNG PHÁP GIẢNG DẠY -->
                    <div class="section-badge-title">
                        <i class="bi bi-lightbulb text-primary"></i> 6. PHƯƠNG PHÁP GIẢNG DẠY TIÊN TIẾN
                    </div>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <div class="p-2.5 rounded bg-light border small d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-primary"></i> Lấy người học làm trung tâm, thúc đẩy làm việc nhóm & thuyết trình.
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-2.5 rounded bg-light border small d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-primary"></i> Học đi đôi với hành, tăng cường thực hành và ứng dụng thực tiễn.
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-2.5 rounded bg-light border small d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-primary"></i> Tăng cường giao lưu quốc tế, rèn luyện kỹ năng công dân toàn cầu.
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-2.5 rounded bg-light border small d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-primary"></i> Tư vấn tâm lý học đường, xây dựng tinh thần học tập hạnh phúc.
                            </div>
                        </div>
                    </div>

                    <!-- 7. CHƯƠNG TRÌNH GIÁO DỤC -->
                    <div class="section-badge-title">
                        <i class="bi bi-journals text-primary"></i> 7. CHƯƠNG TRÌNH GIÁO DỤC TOÀN DIỆN
                    </div>
                    <div class="p-3 bg-light rounded-3 border">
                        <p class="small text-secondary mb-2"><strong>3 Hệ đào tạo song hành:</strong> Chương trình Bộ GD&ĐT • Chương trình Chất lượng cao • Chương trình Song bằng Quốc tế Cambridge.</p>
                        <p class="small text-secondary mb-0"><strong>Hệ sinh thái CLB đa dạng:</strong> CLB Thể thao (Bóng đá, Bóng rổ, Cầu lông), CLB Nghệ thuật (Guitar, Âm nhạc, Hội họa), CLB Khoa học & STEM (Robotics, Nhiếp ảnh, MC nhí).</p>
                    </div>

                    <!-- 8. DỊCH VỤ CHẤT LƯỢNG CAO -->
                    <div class="section-badge-title">
                        <i class="bi bi-shield-check text-primary"></i> 8. DỊCH VỤ CHĂM SÓC CHẤT LƯỢNG CAO
                    </div>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border text-center h-100">
                                <i class="bi bi-bus-front-fill text-primary fs-4 mb-1 d-block"></i>
                                <span class="small fw-bold">Xe Buýt Đưa Đón</span>
                                <p class="text-muted mb-0" style="font-size: 12px;">Đưa đón an toàn theo tuyến linh hoạt.</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border text-center h-100">
                                <i class="bi bi-cup-hot-fill text-success fs-4 mb-1 d-block"></i>
                                <span class="small fw-bold">Bán Trú Dinh Dưỡng</span>
                                <p class="text-muted mb-0" style="font-size: 12px;">Bữa ăn chuẩn khoa học & an toàn.</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border text-center h-100">
                                <i class="bi bi-heart-fill text-danger fs-4 mb-1 d-block"></i>
                                <span class="small fw-bold">Tư Vấn Học Đường</span>
                                <p class="text-muted mb-0" style="font-size: 12px;">Đồng hành cùng phụ huynh & học sinh.</p>
                            </div>
                        </div>
                    </div>

