@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Đổi mật khẩu - eSchool</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/footer.css" rel="stylesheet" asp-append-version="true" />
</head>

<body style="background: linear-gradient(120deg,#2563eb,#06b6d4);">
    <div class="container d-flex justify-content-center align-items-center" style="min-height:100vh;">
        <div class="card shadow p-4" style="width:430px; border-radius:18px;">
            <h2 class="text-center text-primary">eSchool</h2>
            <p class="text-center text-muted">Bạn cần đổi mật khẩu trước khi tiếp tục</p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="Account" asp-action="ForceChangePassword" method="post">
                <div class="mb-3">
                    <label>Mật khẩu cũ <span class="text-danger">*</span></label>
                    <input name="oldPassword"
                           type="password"
                           class="form-control"
                           autocomplete="current-password"
                           required />
                    <small class="text-muted">Nhập mật khẩu tạm thời đã được gửi về email.</small>
                </div>

                <div class="mb-3">
                    <label>Mật khẩu mới <span class="text-danger">*</span></label>
                    <input name="newPassword"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           minlength="6"
                           required />
                </div>

                <div class="mb-3">
                    <label>Nhập lại mật khẩu mới <span class="text-danger">*</span></label>
                    <input name="confirmPassword"
                           type="password"
                           class="form-control"
                           autocomplete="new-password"
                           minlength="6"
                           required />
                </div>

                <button class="btn btn-primary w-100">
                    Đổi mật khẩu
                </button>
            </form>

            <form asp-controller="Account" asp-action="Logout" method="post" class="text-center mt-3">
                <button type="submit" class="btn btn-link text-decoration-none">
                    Đăng xuất
                </button>
            </form>
        </div>
    </div>
    <div class="login-footer">
        @await Html.PartialAsync("_SiteFooter")
    </div>
</body>
</html>
