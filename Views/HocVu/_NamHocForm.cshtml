@model eSchool.Models.NamHoc

<div class="mb-3"><label class="form-label">Tên năm học</label><input asp-for="TenNamHoc" class="form-control" placeholder="2026-2027" /></div>
<div class="row g-3">
    <div class="col-6"><label class="form-label">Ngày bắt đầu</label><input asp-for="NgayBatDau" type="date" class="form-control" /></div>
    <div class="col-6"><label class="form-label">Ngày kết thúc</label><input asp-for="NgayKetThuc" type="date" class="form-control" /></div>
</div>
<div class="form-check form-switch mt-3"><input asp-for="TrangThai" class="form-check-input" /><label asp-for="TrangThai" class="form-check-label">Đang hoạt động</label></div>
