@model List<eSchool.Models.LopHoc>

@{
    Layout = "~/Views/Shared/_AcademicLayout.cshtml";
    ViewData["Title"] = "Quản lý lớp";
    var editableYears = ViewBag.EditableYears as HashSet<string> ?? new HashSet<string>();
    var siSoMap = ViewBag.SiSoMap as IReadOnlyDictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="alert alert-info">Năm học đã kết thúc hoặc đã khóa chỉ được xem dữ liệu.</div>
<div class="page-card">
    <div class="page-tools">
        <form method="get">
            <input name="keyword" value="@ViewBag.Keyword" class="form-control" placeholder="Tìm theo tên lớp hoặc khối..." />
            <button class="btn btn-outline-secondary"><i class="bi bi-search"></i> Tìm</button>
        </form>
        <div class="d-flex gap-2 ms-auto">
            <button class="btn btn-success text-nowrap" type="button" data-bs-toggle="modal" data-bs-target="#importLopHocModal" @(!editableYears.Any() ? "disabled" : "")>
                <i class="bi bi-file-earmark-excel"></i> Nhập từ Excel
            </button>
            <button class="btn btn-primary text-nowrap" disabled="@(!editableYears.Any())" data-bs-toggle="modal" data-bs-target="#createClass">
                <i class="bi bi-plus-lg"></i> Thêm lớp
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead><tr><th>Mã lớp</th><th>Tên lớp</th><th>Khối</th><th>Năm học</th><th>Sĩ số</th><th>Chủ nhiệm</th><th class="text-end">Thao tác</th></tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">Chưa có lớp học</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="badge text-bg-light border font-monospace">@item.MaLop</span></td>
                        <td><strong>@item.TenLop</strong></td>
                        <td>@item.Khoi</td>
                        <td>@item.NamHoc</td>
                        <td><span class="badge text-bg-light border">@(siSoMap.TryGetValue(item.IdLop, out var siSo) ? siSo : 0) học sinh</span></td>
                        <td>@(item.GiaoVienChuNhiem?.HoTen ?? "Chưa phân công")</td>
                        <td class="text-end">
                            <a asp-action="DanhSachHocSinhLop" asp-route-id="@item.IdLop" class="btn btn-sm btn-outline-info" title="Xem danh sách học sinh">
                                <i class="bi bi-people"></i> Danh sách HS
                            </a>
                            <a asp-action="PhanCongGiaoVien" asp-route-lopId="@item.IdLop" class="btn btn-sm btn-outline-success" title="Phân công Giáo viên">
                                <i class="bi bi-person-lines-fill"></i> Phân công GV
                            </a>
                            @if (item.NamHoc != null && editableYears.Contains(item.NamHoc))
                            {
                            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editClass-@item.IdLop"><i class="bi bi-pencil"></i></button>
                            <form asp-action="XoaLop" asp-route-id="@item.IdLop" method="post" class="d-inline" onsubmit="return confirm('Xóa lớp này?');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Chỉ xem</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Import Excel -->
<div class="modal fade" id="importLopHocModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="ImportLopHocExcel" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Nhập danh sách lớp học từ Excel</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2 text-muted">Vui lòng tải file mẫu để xem định dạng chuẩn trước khi nhập dữ liệu.</p>
                    <div class="alert alert-light border py-2 px-3 mb-3 small text-muted">
                        <i class="bi bi-info-circle me-1 text-primary"></i> <strong>Quy tắc nhận diện:</strong> Khi nhập mã/tên lớp dạng <code>K27_6A1</code>, hệ thống sẽ tự động xác định <strong>Năm học 2027-2028</strong>, <strong>Tên lớp 6A1</strong> và <strong>Khối 6</strong>.
                    </div>
                    <a asp-action="DownloadLopHocTemplate" class="btn btn-outline-success mb-4">
                        <i class="bi bi-download me-1"></i> Tải file mẫu Excel
                    </a>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Chọn file Excel (.xlsx) <span class="text-danger">*</span></label>
                        <input type="file" name="file" class="form-control" accept=".xlsx" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-upload me-1"></i> Nhập dữ liệu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="createClass" tabindex="-1">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <form asp-action="TaoLop" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-header"><h5 class="modal-title">Thêm lớp học</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">@await Html.PartialAsync("_LopForm", new eSchool.ViewModels.LopHocFormViewModel())</div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary">Thêm lớp</button></div>
        </form>
    </div></div>
</div>

@foreach (var item in Model.Where(x => x.NamHoc != null && editableYears.Contains(x.NamHoc)))
{
    var phongHocMap = ViewBag.PhongHocMap as Dictionary<int, int>;
    int? mappedPhongId = phongHocMap != null && phongHocMap.ContainsKey(item.IdLop) ? phongHocMap[item.IdLop] : null;

    <div class="modal fade" id="editClass-@item.IdLop" tabindex="-1">
        <div class="modal-dialog modal-lg"><div class="modal-content">
            <form asp-action="SuaLop" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="IdLop" value="@item.IdLop" />
                <div class="modal-header"><h5 class="modal-title">Sửa lớp học</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                <div class="modal-body">
                    @await Html.PartialAsync("_LopForm", new eSchool.ViewModels.LopHocFormViewModel
                    {
                        IdLop = item.IdLop, MaLop = item.MaLop, TenLop = item.TenLop,
                        Khoi = item.Khoi, BuoiHoc = item.BuoiHoc, NamHoc = item.NamHoc, IdGiaoVienCN = item.IdGiaoVienCN,
                        IdPhongHoc = mappedPhongId
                    })
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary">Cập nhật</button></div>
            </form>
        </div></div>
    </div>
}
