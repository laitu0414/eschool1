@model eSchool.ViewModels.ThoiKhoaBieuHocVuViewModel

@{
    Layout = "~/Views/Shared/_AcademicLayout.cshtml";
    ViewData["Title"] = "Thời khóa biểu";
    var days = new Dictionary<int, string> { [2] = "Thứ Hai", [3] = "Thứ Ba", [4] = "Thứ Tư", [5] = "Thứ Năm", [6] = "Thứ Sáu", [7] = "Thứ Bảy" };

    var morningStartTimes = new Dictionary<int, string> { {1, "07:00"}, {2, "07:50"}, {3, "08:50"}, {4, "09:40"}, {5, "10:35"} };
    var morningEndTimes = new Dictionary<int, string> { {1, "07:45"}, {2, "08:35"}, {3, "09:35"}, {4, "10:25"}, {5, "11:20"} };

    var afternoonStartTimes = new Dictionary<int, string> { {1, "13:30"}, {2, "14:20"}, {3, "15:20"}, {4, "16:10"}, {5, "17:05"} };
    var afternoonEndTimes = new Dictionary<int, string> { {1, "14:15"}, {2, "15:05"}, {3, "16:05"}, {4, "16:55"}, {5, "17:50"} };
}

@if (ViewBag.FilterLopId == null || string.IsNullOrEmpty(ViewBag.FilterNamHoc) || string.IsNullOrEmpty(ViewBag.FilterHocKy))
{
    <div class="row align-items-center justify-content-center gap-4" style="min-height: 70vh; margin: 0;">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow border-0 w-100" style="border-radius: 1rem;">
                <div class="card-body p-4 p-md-5 text-center">
                    <div class="mb-4">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                            <i class="bi bi-calendar-week fs-1"></i>
                        </div>
                        <h4 class="fw-bold text-dark">Thời khóa biểu</h4>
                        <p class="text-muted small">Vui lòng chọn thông tin để hiển thị thời khóa biểu</p>
                    </div>

                    <form method="get">
                        <div class="mb-3 text-start">
                            <label class="form-label fw-medium">Năm học</label>
                            <select name="namHoc" asp-items="Model.NamHocs" class="form-select shadow-none border-secondary-subtle" required>
                                <option value="">-- Chọn năm học --</option>
                            </select>
                        </div>
                        
                        <div class="mb-3 text-start">
                            <label class="form-label fw-medium">Học kỳ</label>
                            <select name="hocKy" asp-items="Model.HocKys" class="form-select shadow-none border-secondary-subtle" required>
                                <option value="">-- Chọn học kỳ --</option>
                            </select>
                        </div>

                        <div class="mb-4 text-start">
                            <label class="form-label fw-medium">Lớp học</label>
                            <select name="lopId" asp-items="Model.LopHocs" class="form-select shadow-none border-secondary-subtle" required>
                                <option value="">-- Chọn lớp học --</option>
                            </select>
                        </div>
                        
                        <button type="submit" class="btn btn-primary w-100 rounded-3">
                            <i class="bi bi-search me-2"></i> Hiển thị thời khóa biểu
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-5 col-lg-4">
            <div class="card shadow border-0 w-100" style="border-radius: 1rem;">
                <div class="card-body p-4 p-md-5 text-start">
                    <h4 class="fw-bold text-dark mb-4"><i class="bi bi-calendar-x text-danger me-2"></i>Chỉnh lịch nghỉ</h4>
                    
                    <form asp-action="ThemLichNghiNangCao" method="post" id="formLichNghi">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label class="form-label fw-medium">Đối tượng</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="doiTuong" id="dtToanTruong" value="ToanTruong" checked>
                                    <label class="form-check-label" for="dtToanTruong">Toàn trường</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="doiTuong" id="dtKhoi" value="Khoi">
                                    <label class="form-check-label" for="dtKhoi">Khối</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="doiTuong" id="dtLop" value="Lop">
                                    <label class="form-check-label" for="dtLop">Lớp</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3 d-none" id="divChonKhoi">
                            <select name="khoi" class="form-select shadow-none border-secondary-subtle">
                                <option value="">-- Chọn khối --</option>
                                <option value="6">Khối 6</option>
                                <option value="7">Khối 7</option>
                                <option value="8">Khối 8</option>
                                <option value="9">Khối 9</option>
                            </select>
                        </div>

                        <div class="mb-3 d-none" id="divChonLop">
                            <select name="lopId" asp-items="Model.LopHocs" class="form-select shadow-none border-secondary-subtle">
                                <option value="">-- Chọn lớp --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Kiểu nghỉ</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="kieuNghi" id="knCaNgay" value="CaNgay" checked>
                                    <label class="form-check-label" for="knCaNgay">Cả ngày</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="kieuNghi" id="knTheoBuoi" value="TheoBuoi">
                                    <label class="form-check-label" for="knTheoBuoi">Theo buổi</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="kieuNghi" id="knTheoTiet" value="TheoTiet">
                                    <label class="form-check-label" for="knTheoTiet">Theo tiết</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3 d-none" id="divChonBuoi">
                            <select name="buoi" class="form-select shadow-none border-secondary-subtle">
                                <option value="Sáng">Sáng</option>
                                <option value="Chiều">Chiều</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Ngày</label>
                            <input type="date" name="ngayNghi" class="form-control shadow-none border-secondary-subtle" required value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="mb-3 d-none" id="divChonTiet">
                            <label class="form-label fw-medium d-block">Nếu theo tiết</label>
                            <div class="d-flex gap-2 flex-wrap">
                                @for(int t = 1; t <= 5; t++)
                                {
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="checkbox" name="tiets" id="tiet_@t" value="@t">
                                        <label class="form-check-label" for="tiet_@t">@t</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-medium">Lý do</label>
                            <select name="lyDo" class="form-select shadow-none border-secondary-subtle">
                                <option value="Nghỉ Lễ/Tết">Nghỉ Lễ/Tết</option>
                                <option value="Ngoại khóa">Ngoại khóa</option>
                                <option value="Họp hội đồng">Họp hội đồng</option>
                                <option value="Thi cử">Thi cử</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-medium">Ghi chú</label>
                            <input type="text" name="ghiChu" class="form-control shadow-none border-secondary-subtle" placeholder="Nhập ghi chú..." />
                        </div>

                        <button type="submit" class="btn btn-danger w-100 rounded-3">
                            <i class="bi bi-calendar-minus me-2"></i> Áp dụng lịch nghỉ
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const dtRadios = document.querySelectorAll('input[name="doiTuong"]');
            const divChonKhoi = document.getElementById('divChonKhoi');
            const divChonLop = document.getElementById('divChonLop');

            dtRadios.forEach(radio => {
                radio.addEventListener('change', function() {
                    divChonKhoi.classList.add('d-none');
                    divChonLop.classList.add('d-none');
                    if(this.value === 'Khoi') divChonKhoi.classList.remove('d-none');
                    if(this.value === 'Lop') divChonLop.classList.remove('d-none');
                });
            });

            const knRadios = document.querySelectorAll('input[name="kieuNghi"]');
            const divChonBuoi = document.getElementById('divChonBuoi');
            const divChonTiet = document.getElementById('divChonTiet');

            knRadios.forEach(radio => {
                radio.addEventListener('change', function() {
                    divChonBuoi.classList.add('d-none');
                    divChonTiet.classList.add('d-none');
                    if(this.value === 'TheoBuoi') divChonBuoi.classList.remove('d-none');
                    if(this.value === 'TheoTiet') divChonTiet.classList.remove('d-none');
                });
            });
        });
    </script>
}
else
{
    <div class="page-card mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="mb-1 text-dark fw-bold">Thời khóa biểu</h4>
            @{
                var selectedLop = Model.LopHocs.FirstOrDefault(x => x.Value == ViewBag.FilterLopId?.ToString());
                var selectedNamHoc = Model.NamHocs.FirstOrDefault(x => x.Value == ViewBag.FilterNamHoc);
                var selectedHocKy = Model.HocKys.FirstOrDefault(x => x.Value == ViewBag.FilterHocKy);
            }
            <p class="text-muted mb-0">
                Năm học: <span class="fw-medium text-primary">@(selectedNamHoc?.Text ?? "")</span>
                <span class="mx-2 text-secondary">|</span> 
                Học kỳ: <span class="fw-medium text-primary">@(selectedHocKy?.Text ?? "")</span>
                <span class="mx-2 text-secondary">|</span> 
                Lớp: <span class="fw-medium text-primary">@(selectedLop?.Text ?? "")</span> 
            </p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <form method="get" class="d-flex gap-2 align-items-center mb-0">
                <input type="hidden" name="namHoc" value="@ViewBag.FilterNamHoc" />
                <input type="hidden" name="hocKy" value="@ViewBag.FilterHocKy" />
                <input type="hidden" name="lopId" value="@ViewBag.FilterLopId" />
                <input type="date" name="tuan" value="@ViewBag.Tuan" class="form-control" title="Chọn ngày" onchange="this.form.submit()" />
            </form>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createSchedule">
                <i class="bi bi-plus-lg"></i> Thêm lịch
            </button>
            <a href="/HocVu/ThoiKhoaBieu" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-2"></i> Trở lại
            </a>
        </div>
    </div>

    @if (!Model.DanhSach.Any())
    {
        <div class="page-card text-center text-muted py-5">Chưa có dữ liệu thời khóa biểu cho bộ lọc này.</div>
    }
    else
    {
    var lops = Model.DanhSach
        .Where(x => x.LopHoc != null)
        .Select(x => x.LopHoc)
        .GroupBy(x => x.IdLop)
        .Select(g => g.First())
        .OrderBy(x => x.TenLop)
        .ToList();
    DateTime startOfWeek = ViewBag.StartOfWeek != null ? DateTime.Parse(ViewBag.StartOfWeek) : DateTime.Today;
    var thayDois = ViewBag.ThayDois as List<eSchool.Models.LichHocThayDoi> ?? new List<eSchool.Models.LichHocThayDoi>();
    
    <div class="table-responsive bg-white rounded shadow-sm">
        <table class="table table-bordered align-middle text-center mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 150px;" class="align-middle">Thời gian</th>
                    @for (int i = 2; i <= 7; i++)
                    {
                        var currentDate = startOfWeek.AddDays(i - 2);
                        var isHoliday = thayDois.Any(x => x.Ngay.Date == currentDate.Date && x.IsNghi && x.IdLop == null);
                        
                        <th class="align-middle">
                            <div>Thứ @i</div>
                            <small class="text-muted fw-normal d-block mb-1">@currentDate.ToString("dd/MM/yyyy")</small>
                            <form asp-action="ToggleNgayNghi" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ngay" value="@currentDate.ToString("yyyy-MM-dd")" />
                                <button type="submit" class="btn btn-sm @(isHoliday ? "btn-danger" : "btn-outline-secondary")" style="font-size: 0.7rem; padding: 2px 6px;">
                                    @(isHoliday ? "Đang nghỉ" : "Cho nghỉ")
                                </button>
                            </form>
                            @{
                                var isDoiPhong = thayDois.Any(x => x.Ngay.Date == currentDate.Date && !x.IsNghi && x.GhiChu != null && x.GhiChu.StartsWith("Đổi phòng: "));
                                if (isDoiPhong)
                                {
                                    <div class="mt-1"><span class="badge bg-warning text-dark"><i class="bi bi-arrow-left-right"></i> Đổi phòng</span></div>
                                }
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!lops.Any())
                {
                    <tr>
                        <td colspan="7" class="text-muted py-4">Chưa có dữ liệu thời khóa biểu cho bộ lọc này.</td>
                    </tr>
                }
                
                @foreach (var lop in lops)
                {
                    var isMorning = lop.BuoiHoc == "Sáng" || (string.IsNullOrEmpty(lop.BuoiHoc) && lop.Khoi != null && (lop.Khoi.Contains("6") || lop.Khoi.Contains("7")));
                    var startTimes = isMorning ? morningStartTimes : afternoonStartTimes;
                    var endTimes = isMorning ? morningEndTimes : afternoonEndTimes;
                    
                    <tr>
                        <td colspan="7" class="fw-bold bg-light text-start text-primary px-3 py-2">
                            Lớp @lop.TenLop <span class="badge bg-secondary ms-1">@(isMorning ? "Sáng" : "Chiều")</span>
                            @{
                                var pMap = ViewBag.PhongHocMap as Dictionary<int, string>;
                                if (pMap != null && pMap.ContainsKey(lop.IdLop))
                                {
                                    <span class="badge bg-info text-dark ms-2"><i class="bi bi-door-open me-1"></i>@pMap[lop.IdLop]</span>
                                }
                            }
                        </td>
                    </tr>
                    
                    for (int tiet = 1; tiet <= 5; tiet++)
                    {
                        <tr>
                            <td class="text-muted bg-light">
                                <div class="fw-bold">Tiết @tiet</div>
                                @if (startTimes.ContainsKey(tiet) && endTimes.ContainsKey(tiet))
                                {
                                    <small style="font-size: 0.75em;">@startTimes[tiet] - @endTimes[tiet]</small>
                                }
                            </td>
                            
                            @for (int thu = 2; thu <= 7; thu++)
                            {
                                var currentDateForCell = startOfWeek.AddDays(thu - 2);
                                var isHoliday = thayDois.Any(x => x.Ngay.Date == currentDateForCell.Date && x.IsNghi && (x.IdLop == null || x.IdLop == lop.IdLop));

                                if (isHoliday)
                                {
                                    if (tiet == 1)
                                    {
                                        <td rowspan="5" class="align-middle bg-danger bg-opacity-10 text-danger fw-bold" style="letter-spacing: 2px;">
                                            NGHỈ HỌC
                                        </td>
                                    }
                                    continue;
                                }

                                var item = Model.DanhSach.FirstOrDefault(x => x.IdLop == lop.IdLop && x.Thu == thu && x.TietBatDau <= tiet && (x.TietBatDau + (x.SoTiet ?? 1) - 1) >= tiet);
                                
                                if (item != null)
                                {
                                    if (item.TietBatDau == tiet)
                                    {
                                        <td rowspan="@(item.SoTiet ?? 1)" class="position-relative hover-show-actions" style="background-color: #f8f9fa;">
                                            <div class="fw-bold text-primary">@(item.MonHoc?.TenMon ?? "Trống")</div>
                                            <div class="text-muted small">@(item.GiaoVien?.HoTen ?? "Chưa phân GV")</div>
                                            @{
                                                var doiPhongThayDoi = thayDois.FirstOrDefault(x => x.Ngay.Date == currentDateForCell.Date && x.IdLop == lop.IdLop && !x.IsNghi && x.GhiChu != null && x.GhiChu.StartsWith("Đổi phòng: "));
                                                var roomCode = item.PhongHoc?.MaPhong;
                                                if (doiPhongThayDoi != null)
                                                {
                                                    roomCode = doiPhongThayDoi.GhiChu.Replace("Đổi phòng: ", "");
                                                }
                                            }
                                            @if (!string.IsNullOrEmpty(roomCode))
                                            {
                                                <div class="text-info small fw-bold mt-1"><i class="bi bi-geo-alt-fill"></i> @roomCode</div>
                                            }
                                            
                                            <form asp-action="XoaLich" asp-route-id="@item.IdPhanCong" method="post" class="position-absolute top-0 end-0 p-1 d-none action-btn" onsubmit="return confirm('Xóa lịch này?');">
                                                @Html.AntiForgeryToken()
                                                <button class="btn btn-sm text-danger p-0"><i class="bi bi-x-circle-fill"></i></button>
                                            </form>
                                        </td>
                                    }
                                }
                                else
                                {
                                    <td></td>
                                }
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    
    <style>
        .hover-show-actions:hover .action-btn {
            display: block !important;
        }
    </style>
    }
}

<div class="modal fade" id="createSchedule" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">
    <form asp-action="TaoLich" method="post">
        @Html.AntiForgeryToken()
        <div class="modal-header"><h5 class="modal-title">Thêm thời khóa biểu</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Giáo viên</label><select asp-for="IdGiaoVien" asp-items="Model.GiaoViens" class="form-select"><option value="">-- Chọn giáo viên --</option></select></div>
                <div class="col-md-3"><label class="form-label">Môn học</label><select asp-for="IdMonHoc" asp-items="Model.MonHocs" class="form-select"><option value="">-- Chọn môn --</option></select></div>
                <div class="col-md-3"><label class="form-label">Lớp học</label><select asp-for="IdLop" asp-items="Model.LopHocs" class="form-select"><option value="">-- Chọn lớp --</option></select></div>
                <div class="col-md-4"><label class="form-label">Năm học</label><select asp-for="NamHoc" asp-items="Model.NamHocs" class="form-select"><option value="">-- Chọn năm học --</option></select></div>
                <div class="col-md-4"><label class="form-label">Học kỳ</label><select asp-for="HocKy" asp-items="Model.HocKys" class="form-select"><option value="">-- Chọn học kỳ --</option></select></div>
                <div class="col-md-4"><label class="form-label">Thứ</label><select asp-for="Thu" class="form-select">@for (var i = 2; i <= 7; i++) { <option value="@i">Thứ @i</option> }</select></div>
                <div class="col-md-6"><label class="form-label">Tiết bắt đầu</label><input asp-for="TietBatDau" type="number" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">Số tiết</label><input asp-for="SoTiet" type="number" class="form-control" /></div>
            </div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button><button class="btn btn-primary">Thêm lịch</button></div>
    </form>
</div></div></div>
