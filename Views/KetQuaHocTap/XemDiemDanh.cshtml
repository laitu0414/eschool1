@model eSchool.ViewModels.HocSinhDiemDanhPageViewModel
@{
    Layout = Context.Session.GetInt32("RoleId") switch { SystemRoleIds.SystemAdmin => "~/Views/Shared/_AdminLayout.cshtml", 4 => "~/Views/Shared/_ParentLayout.cshtml", _ => "~/Views/Shared/_StudentLayout.cshtml" };
    ViewData["Title"] = "Điểm danh";
}

<div class="student-attendance-page">
    <div class="student-attendance-hero">
        <div>
            <span class="student-attendance-eyebrow">Điểm danh</span>
            <h2>Lịch sử điểm danh</h2>
            <p>Chọn ngày, môn học và tiết để xem kết quả đã điểm danh.</p>
        </div>
        <div class="student-attendance-current">
            <span>Môn đang xem</span>
            <strong>@Model.TenMonHocDangChon</strong>
        </div>
    </div>

    <form method="get" class="d-flex flex-wrap gap-2 mb-3">
        @if (ViewBag.Children is IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> children)
        {
            <select name="idHocSinh" asp-items="children" class="form-select w-auto" aria-label="Học sinh"></select>
        }        <select name="idMonHoc" class="form-select w-auto" aria-label="Môn học">
            <option value="">Tất cả môn học</option>
            @foreach (var subject in Model.MonHocs)
            {
                <option value="@subject.Value" selected="@(Model.IdMonHoc?.ToString() == subject.Value)">@subject.Text</option>
            }
        </select>
        <input type="date" name="ngayHoc" value="@ViewBag.NgayHoc" class="form-control w-auto" aria-label="Ngày học" />
        <input type="number" name="idTietHoc" value="@ViewBag.IdTietHoc" min="1" class="form-control w-auto" placeholder="Tất cả tiết" aria-label="Tiết học" />
        <button class="btn btn-primary">Xem theo tiết</button>
        <a asp-action="XemDiemDanh" asp-route-idHocSinh="@ViewBag.IdHocSinh" class="btn btn-outline-secondary">Xóa bộ lọc</a>
    </form>    <div class="student-attendance-subjects">
        @if (!Model.MonHocs.Any())
        {
            <div class="student-score-panel text-muted">Chưa có môn học nào để hiển thị điểm danh.</div>
        }
        else
        {
            @foreach (var item in Model.MonHocs)
            {
                var isActive = Model.IdMonHoc?.ToString() == item.Value;
                <a asp-action="XemDiemDanh"
                   asp-route-idHocSinh="@ViewBag.IdHocSinh" asp-route-idMonHoc="@item.Value" asp-route-ngayHoc="@ViewBag.NgayHoc" asp-route-idTietHoc="@ViewBag.IdTietHoc"
                   class="student-attendance-subject @(isActive ? "active" : null)">
                    @item.Text
                </a>
            }
        }
    </div>

    <div class="student-score-panel">
        <div class="student-score-panel-head">
            <div>
                <h3>Chi tiết điểm danh</h3>
                <p>Mỗi dòng là kết quả điểm danh của một tiết học.</p>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table student-score-table align-middle">
                <thead>
                    <tr>
                        <th>Ngày học</th>
                        <th>Môn học</th>
                        <th>Lớp</th>
                        <th>Tiết</th>
                        <th>Giáo viên</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.LichSuDiemDanh.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">Chưa có dữ liệu điểm danh cho môn học này.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.LichSuDiemDanh)
                        {
                            <tr>
                                <td>@item.NgayHoc.ToString("dd/MM/yyyy")</td>
                                <td><strong>@item.TenMonHoc</strong></td>
                                <td>@item.TenLop</td>
                                <td>@(item.IdTietHoc?.ToString() ?? "-")</td>
                                <td>@item.TenGiaoVien</td>
                                <td>
                                    <span class="student-score-badge @(eSchool.Services.AttendanceRules.IsPresent(item.TrangThai) ? "good" : "bad")">
                                        @(item.TrangThai == "Co mat" ? "Có mặt" : (item.TrangThai == "Vang" ? "Vắng" : item.TrangThai))
                                    </span>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.GhiChu) ? "-" : item.GhiChu)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
