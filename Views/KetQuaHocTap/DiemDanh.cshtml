@model eSchool.ViewModels.AdminDiemDanhPageViewModel
@{
    Layout = "~/Views/Shared/_ResultLayout.cshtml";
    ViewData["Title"] = "Tổng hợp điểm danh";
}

<style>
    .filter-wrapper {
        min-height: 70vh;
        background: radial-gradient(circle at top right, rgba(238, 242, 247, 0.6), transparent),
                    radial-gradient(circle at bottom left, rgba(226, 232, 240, 0.4), transparent);
        border-radius: 1.5rem;
        margin-bottom: 2rem;
    }
    .filter-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 20px 40px rgba(0,0,0,0.04), 0 1px 3px rgba(0,0,0,0.02);
        border-radius: 24px;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .filter-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 25px 50px rgba(0,0,0,0.07), 0 5px 15px rgba(0,0,0,0.03);
    }
    .icon-wrapper {
        width: 85px; 
        height: 85px; 
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 25px;
        box-shadow: 0 10px 25px rgba(118, 75, 162, 0.3);
        transform: rotate(-3deg);
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .filter-card:hover .icon-wrapper {
        transform: rotate(0deg) scale(1.05);
    }
    .icon-wrapper i {
        color: #fff;
        font-size: 2.2rem;
        text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }
    .custom-floating > .form-select, .custom-floating > .form-control {
        height: 3.8rem;
        border-radius: 14px;
        border: 2px solid #e2e8f0;
        background-color: #f8fafc;
        font-weight: 500;
        color: #334155;
        transition: all 0.3s ease;
        padding-top: 1.625rem;
        padding-bottom: 0.625rem;
    }
    .custom-floating > .form-select:focus, .custom-floating > .form-control:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.15);
        background-color: #ffffff;
    }
    .custom-floating > label {
        color: #64748b;
        font-weight: 500;
        padding-left: 1rem;
    }
    .btn-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        border-radius: 14px;
        padding: 14px 20px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        font-size: 0.95rem;
    }
    .btn-gradient:hover {
        background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
        box-shadow: 0 8px 20px rgba(118, 75, 162, 0.35);
        transform: translateY(-2px);
        color: white;
    }
    .btn-gradient:active {
        transform: translateY(0);
        box-shadow: 0 4px 10px rgba(118, 75, 162, 0.3);
    }
</style>

    <div class="d-flex align-items-center justify-content-center filter-wrapper py-5" style="@(ViewBag.NamHocId != null ? "min-height: auto;" : "")">
        <div class="filter-card p-5 text-center" style="max-width: 800px; width: 100%; margin: 0 15px;">
            <div class="icon-wrapper">
                <i class="bi bi-calendar-check-fill"></i>
            </div>
            <h3 class="fw-bolder text-dark mb-2" style="letter-spacing: -0.5px;">Tổng Hợp Điểm Danh</h3>
            <p class="text-muted mb-4 pb-2" style="font-size: 0.95rem;">Lựa chọn thông tin để hiển thị danh sách điểm danh của học sinh.</p>

            <form method="get" id="filterFormFull">
                <div class="row g-3 text-start mb-4">
                    <div class="col-md-4">
                        <div class="form-floating custom-floating">
                            <select name="namHocId" asp-items="Model.NamHocs" class="form-select" id="namHocSelectFull" required>
                                <option value="" disabled selected>-- Chọn năm học --</option>
                            </select>
                            <label for="namHocSelectFull"><i class="bi bi-clock-history me-1 text-primary"></i> Năm học</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating custom-floating">
                            <select name="lopId" asp-items="Model.LopHocs" class="form-select" id="lopSelectFull" required>
                                <option value="" disabled selected>-- Chọn lớp học --</option>
                            </select>
                            <label for="lopSelectFull"><i class="bi bi-people-fill me-1 text-primary"></i> Lớp học</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-floating custom-floating">
                            <input type="date" name="ngay" value="@(ViewBag.Ngay ?? DateTime.Today.ToString("yyyy-MM-dd"))" class="form-control" id="ngaySelectFull" required />
                            <label for="ngaySelectFull"><i class="bi bi-calendar-event me-1 text-primary"></i> Ngày học</label>
                        </div>
                    </div>
                </div>
                
                <button type="submit" class="btn btn-gradient btn-lg w-100 mt-2" id="btnFilterFull">
                    <i class="bi bi-search me-2"></i> Hiển thị danh sách
                </button>
            </form>
        </div>
    </div>
@if (ViewBag.NamHocId != null && ViewBag.LopId != null && ViewBag.Ngay != null)
{
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h4 class="mb-1 text-dark fw-bold">Danh sách điểm danh</h4>
            @{
                var selectedNamHoc = Model.NamHocs.FirstOrDefault(x => x.Value == ViewBag.NamHocId?.ToString());
                var selectedLop = Model.LopHocs.FirstOrDefault(x => x.Value == ViewBag.LopId?.ToString());
            }
            <p class="text-muted mb-0">
                Năm học: <span class="fw-medium text-primary">@(selectedNamHoc?.Text ?? "")</span> | 
                Lớp: <span class="fw-medium text-primary">@(selectedLop?.Text ?? "")</span> | 
                Ngày: <span class="fw-medium text-primary">@(ViewBag.Ngay != null ? DateTime.Parse(ViewBag.Ngay).ToString("dd/MM/yyyy") : "")</span>
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="/KetQuaHocTap/DiemDanh" class="btn btn-light px-4 border">
                <i class="bi bi-arrow-counterclockwise me-2"></i> Chọn lại
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3">Môn học</th>
                            <th>Tiết</th>
                            <th>Giáo viên</th>
                            <th class="text-center">Sĩ số</th>
                            <th class="text-center">Có mặt</th>
                            <th class="text-center">Vắng</th>
                            <th class="text-end pe-4">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.DanhSachBuoiHoc.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <div class="mb-3"><i class="bi bi-calendar-x text-secondary" style="font-size: 3rem;"></i></div>
                                    <span class="fs-5">Chưa có buổi điểm danh nào trong ngày này.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.DanhSachBuoiHoc)
                            {
                                <tr>
                                    <td class="ps-4 fw-medium text-dark">@item.TenMonHoc</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">Tiết @(item.IdTietHoc?.ToString() ?? "-")</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-2" style="width: 28px; height: 28px; font-size: 0.8rem; font-weight: bold;">
                                                @(!string.IsNullOrEmpty(item.TenGiaoVien) && item.TenGiaoVien != "Chua cap nhat" ? item.TenGiaoVien.Substring(0, 1).ToUpper() : "?")
                                            </div>
                                            <span>@(item.TenGiaoVien == "Chua cap nhat" ? "Chưa cập nhật" : item.TenGiaoVien)</span>
                                        </div>
                                    </td>
                                    <td class="text-center fw-medium">@item.TongHocSinh</td>
                                    <td class="text-center">
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 border border-success border-opacity-25">
                                            @item.SoHocSinhCoMat
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1 border border-danger border-opacity-25">
                                            @item.SoHocSinhVang
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="ChiTietDiemDanh"
                                           asp-route-lopId="@item.IdLop"
                                           asp-route-ngayHoc="@item.NgayHoc.ToString("yyyy-MM-dd")"
                                           asp-route-idTietHoc="@item.IdTietHoc"
                                           class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            Xem chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}


