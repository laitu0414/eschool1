@model eSchool.ViewModels.AdminDiemPageViewModel
@using Microsoft.AspNetCore.Http
@{ 
    var isTeacher = Context.Session.GetInt32("RoleId") == 2;
    Layout = isTeacher ? "~/Views/Shared/_TeacherLayout.cshtml" : "~/Views/Shared/_ResultLayout.cshtml"; 
    ViewData["Title"] = "Quản lý điểm"; 
}

<div class="mb-3"><a asp-controller="TongKet" asp-action="Index" class="btn btn-outline-primary">Điểm cả năm / Tổng kết</a></div><style>
    .filter-wrapper {
        min-height: 70vh;
        background: radial-gradient(circle at top right, rgba(238, 242, 247, 0.6), transparent),
                    radial-gradient(circle at bottom left, rgba(226, 232, 240, 0.4), transparent);
        border-radius: 1.5rem;
        margin-bottom: 2rem;
    }
    .filter-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 20px 40px rgba(0,0,0,0.04), 0 1px 3px rgba(0,0,0,0.02);
        border-radius: 24px;
        transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }
    .filter-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 25px 50px rgba(0,0,0,0.07), 0 5px 15px rgba(0,0,0,0.03);
    }
    .icon-wrapper {
        width: 85px; 
        height: 85px; 
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 25px;
        box-shadow: 0 10px 25px rgba(118, 75, 162, 0.3);
        transform: rotate(-3deg);
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .filter-card:hover .icon-wrapper {
        transform: rotate(0deg) scale(1.05);
    }
    .icon-wrapper i {
        color: #fff;
        font-size: 2.2rem;
        text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }
    .custom-floating > .form-select {
        height: 3.8rem;
        border-radius: 14px;
        border: 2px solid #e2e8f0;
        background-color: #f8fafc;
        font-weight: 500;
        color: #334155;
        transition: all 0.3s ease;
        padding-top: 1.625rem;
        padding-bottom: 0.625rem;
    }
    .custom-floating > .form-select:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.15);
        background-color: #ffffff;
    }
    .custom-floating > label {
        color: #64748b;
        font-weight: 500;
        padding-left: 1rem;
    }
    .btn-gradient {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        border-radius: 14px;
        padding: 14px 20px;
        font-weight: 600;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        font-size: 0.95rem;
    }
    .btn-gradient:hover {
        background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
        box-shadow: 0 8px 20px rgba(118, 75, 162, 0.35);
        transform: translateY(-2px);
        color: white;
    }
    .btn-gradient:active {
        transform: translateY(0);
        box-shadow: 0 4px 10px rgba(118, 75, 162, 0.3);
    }
</style>

    <div class="d-flex align-items-center justify-content-center filter-wrapper py-5" style="@(ViewBag.FilterLopId != null ? "min-height: auto;" : "")">
        <div class="filter-card p-5 text-center" style="max-width: 600px; width: 100%; margin: 0 15px;">
            <div class="icon-wrapper">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <h3 class="fw-bolder text-dark mb-2" style="letter-spacing: -0.5px;">Tra Cứu Điểm Số</h3>
            <p class="text-muted mb-4 pb-2" style="font-size: 0.95rem;">Lựa chọn lớp học và học kỳ để xem kết quả học tập chi tiết của học sinh.</p>

            <form method="get" id="filterFormFull">
                <div class="row g-3 text-start mb-4">
                    <div class="col-md-6">
                        <div class="form-floating custom-floating">
                            <select name="lopId" asp-items="Model.LopHocs" class="form-select" id="lopSelectFull" required>
                                <option value="" disabled>-- Chọn lớp học --</option>
                            </select>
                            <label for="lopSelectFull"><i class="bi bi-people-fill me-1 text-primary"></i> Lớp học</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating custom-floating">
                            <select name="hocKyId" asp-items="Model.HocKys" class="form-select" id="hocKySelectFull" required>
                                <option value="" disabled>-- Chọn học kỳ --</option>
                            </select>
                            <label for="hocKySelectFull"><i class="bi bi-calendar-check me-1 text-primary"></i> Học kỳ</label>
                        </div>
                    </div>
                </div>
                
                <button type="submit" class="btn btn-gradient btn-lg w-100 mt-2" id="btnFilterFull">
                    <i class="bi bi-search me-2"></i> Hiển thị danh sách
                </button>
            </form>
        </div>
    </div>
@if (ViewBag.FilterLopId != null && ViewBag.FilterHocKyId != null)
{
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h4 class="mb-1 text-dark fw-bold">Danh sách học sinh</h4>
            @{
                var selectedLop = Model.LopHocs.FirstOrDefault(x => x.Value == ViewBag.FilterLopId?.ToString());
                var selectedHocKy = Model.HocKys.FirstOrDefault(x => x.Value == ViewBag.FilterHocKyId?.ToString());
            }
            <p class="text-muted mb-0">
                Lớp: <span class="fw-medium text-primary">@(selectedLop?.Text ?? "")</span> 
                <span class="mx-2 text-secondary">|</span> 
                Học kỳ: <span class="fw-medium text-primary">@(selectedHocKy?.Text ?? "")</span>
            </p>
        </div>
        <div class="d-flex gap-2">
            @if (!isTeacher)
            {
                <a href="/KetQuaHocTap/NhatKySuaDiem" class="btn btn-outline-info px-4">
                    <i class="bi bi-journal-text me-2"></i> Lịch sử sửa điểm
                </a>
            }
            <button class="btn btn-outline-success px-4" data-bs-toggle="modal" data-bs-target="#importExcelModal">
                <i class="bi bi-file-earmark-excel me-2"></i> Nhập từ Excel
            </button>
            <a href="/KetQuaHocTap/Diem" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-2"></i> Chọn lớp khác
            </a>
        </div>
    </div>
    
    <div class="table-responsive bg-white rounded shadow-sm border border-light">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4">Học sinh</th>
                    <th>Lớp</th>
                    @foreach(var mon in Model.MonHocsList)
                    {
                        <th class="text-center" style="white-space: nowrap;">@mon.TenMon</th>
                    }
                    <th class="text-center" style="white-space: nowrap;">TB các môn có điểm</th>
                    <th class="text-end pe-4" style="white-space: nowrap;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.DanhSach.Any())
                {
                    <tr>
                        <td colspan="@(4 + Model.MonHocsList.Count)" class="text-center text-muted py-5">
                            <div class="mb-3"><i class="bi bi-folder-x text-secondary" style="font-size: 3rem;"></i></div>
                            <span class="fs-5">Chưa có dữ liệu học sinh cho lớp này</span>
                        </td>
                    </tr>
                }
                @foreach (var item in Model.DanhSach)
                {
                    <tr>
                        <td class="ps-4">
                            <strong>@item.HocSinh?.HoTen</strong>
                            <small class="d-block text-muted">@item.HocSinh?.MaHS</small>
                        </td>
                        <td>@item.HocSinh?.LopHoc?.TenLop</td>
                        @foreach(var mon in Model.MonHocsList)
                        {
                            <td class="text-center fw-medium">
                                @if (item.DiemTBMon.ContainsKey(mon.IdMonHoc) && item.DiemTBMon[mon.IdMonHoc].HasValue)
                                {
                                    <span class="@(item.DiemTBMon[mon.IdMonHoc] >= 8 ? "text-success" : item.DiemTBMon[mon.IdMonHoc] >= 5 ? "text-primary" : "text-danger")">@item.DiemTBMon[mon.IdMonHoc].Value.ToString("0.0")</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        }
                        <td class="text-center">
                            @if (item.DiemTBHocKy.HasValue)
                            {
                                <span class="badge @(item.DiemTBHocKy >= 8 ? "bg-success" : item.DiemTBHocKy >= 5 ? "bg-primary" : "bg-danger") px-3 py-2 fs-6 rounded-pill">@item.DiemTBHocKy.Value.ToString("0.00")</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <button class="btn btn-sm btn-outline-primary btn-nhap-diem px-3" 
                                    data-id="@item.IdHocSinh" 
                                    data-name="@item.HocSinh?.HoTen" 
                                    data-hocky="@ViewBag.FilterHocKyId">
                                <i class="bi bi-pencil-square"></i> Nhập điểm
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</div>

<!-- Modal Nhập từ Excel -->
<div class="modal fade" id="importExcelModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="ImportDiemExcel" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="lopId" value="@ViewBag.FilterLopId" />
                <input type="hidden" name="hocKyId" value="@ViewBag.FilterHocKyId" />
                
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title text-success"><i class="bi bi-file-earmark-excel me-2"></i>Nhập điểm từ Excel</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-3 text-muted">Tải mẫu của đúng lớp, nhập điểm trên trang NhapDiem rồi chọn môn học cần cập nhật.</p>
                    <a asp-action="DownloadDiemTemplate" asp-route-lopId="@ViewBag.FilterLopId" class="btn btn-outline-success mb-4 w-100">
                        <i class="bi bi-download me-1"></i> Tải file mẫu danh sách lớp
                    </a>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Môn học cần nhập điểm</label>
                        <select name="monHocId" class="form-select" required>
                            <option value="">-- Chọn môn học --</option>
                            @foreach(var item in (ViewBag.MonHocs as SelectList ?? new SelectList(new List<SelectListItem>())))
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <div class="alert alert-info small">
    Điểm từ <strong>0 đến 10</strong>; số thập phân dùng <strong>7.5 hoặc 7,5</strong>.
    Nhiều điểm trong một ô dùng dấu chấm phẩy: <strong>8; 7,5; 9</strong>.
    Ô trống giữ nguyên điểm cũ. Ô có điểm thay thế danh sách điểm của cột đó.
    Không sửa ID/mã học sinh hoặc dùng công thức. File có lỗi sẽ không lưu bất kỳ dòng nào.
</div>
<label class="form-label fw-bold">Chọn file Excel (.xlsx, tối đa 5 MB)</label>
                        <input type="file" name="file" class="form-control" accept=".xlsx" required />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-upload me-1"></i> Nhập dữ liệu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="scoreModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nhập điểm cho <span id="studentNameTitle" class="text-primary"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0"><div class="alert alert-info m-3 small">Điểm 0–10. Dùng dấu chấm phẩy cho nhiều điểm: 8; 7,5; 9. Trong bảng nhập tay, xóa trắng ô rồi lưu sẽ xóa điểm cũ. ĐTB môn được tính khi đủ 4 nhóm điểm theo trọng số 1–1–2–3.</div>
                <input type="hidden" id="modalStudentId" />
                <input type="hidden" id="modalHocKyId" />
                <input type="hidden" id="modalNamHocId" />
                <div class="table-responsive">
                    <table class="table table-bordered mb-0" id="gradesTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 5%" class="text-center">STT</th>
                                <th>Môn học</th>
                                <th style="width: 15%">15 phút</th>
                                <th style="width: 15%">1 tiết</th>
                                <th style="width: 15%">Giữa kỳ</th>
                                <th style="width: 15%">Cuối kỳ</th>
                            </tr>
                        </thead>
                        <tbody id="gradesTableBody">
                            <tr><td colspan="6" class="text-center py-4">Đang tải dữ liệu...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="btnSaveGrades">
                    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    Lưu tất cả
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {
    const element = document.getElementById('scoreModal');
    const modal = bootstrap.Modal.getOrCreateInstance(element);
    const tbody = document.getElementById('gradesTableBody');
    const save = document.getElementById('btnSaveGrades');
    const fields = ['diem15Phut', 'diem1Tiet', 'diemGiuaKy', 'diemCuoiKy'];
    let version = '', requestNumber = 0;
    let baseline = '';
    const readRows = () => Array.from(tbody.querySelectorAll('tr[data-subject]')).filter(tr => tr.dataset.editable === 'true').map(tr => {
        const item = { idMonHoc: Number(tr.dataset.subject) };
        fields.forEach(field => item[field] = tr.querySelector('input[data-field="' + field + '"]').value.trim() || null);
        return item;
    });
    const message = text => {
        tbody.replaceChildren();
        const td = document.createElement('td'); td.colSpan = 6; td.className = 'text-center py-4'; td.textContent = text;
        const tr = document.createElement('tr'); tr.append(td); tbody.append(tr);
    };
    const readResponse = async response => {
        if (response.redirected || !response.headers.get('content-type')?.includes('application/json'))
            throw new Error(response.status === 403 ? 'Bạn không có quyền thao tác.' : 'Phiên đăng nhập hết hạn hoặc không có quyền truy cập. Hãy tải lại trang.');
        const data = await response.json();
        if (!response.ok) throw new Error(data.message || 'Không xử lý được yêu cầu.');
        return data;
    };
    element.addEventListener('hidden.bs.modal', () => { requestNumber++; save.disabled = true; version = ''; });
    document.querySelectorAll('.btn-nhap-diem').forEach(button => button.addEventListener('click', async () => {
        const current = ++requestNumber;
        save.disabled = true; version = '';
        document.getElementById('studentNameTitle').textContent = button.dataset.name;
        document.getElementById('modalStudentId').value = button.dataset.id;
        document.getElementById('modalHocKyId').value = button.dataset.hocky;
        document.getElementById('modalNamHocId').value = '';
        message('Đang tải điểm...'); modal.show();
        try {
            const data = await readResponse(await fetch('/KetQuaHocTap/GetDiemHocSinh?' + new URLSearchParams({
                idHocSinh: button.dataset.id, idHocKy: button.dataset.hocky
            })));
            if (current !== requestNumber) return;
            version = data.version;
            document.getElementById('modalNamHocId').value = data.idNamHoc;
            tbody.replaceChildren();
            data.diemMonHocs.forEach((subject, index) => {
                const tr = document.createElement('tr');
                tr.dataset.subject = subject.idMonHoc; tr.dataset.editable = String(subject.isEditable);
                [index + 1, subject.tenMon].forEach(value => {
                    const td = document.createElement('td'); td.textContent = value; tr.append(td);
                });
                fields.forEach(field => {
                    const td = document.createElement('td'), input = document.createElement('input');
                    input.type = 'text'; input.className = 'form-control form-control-sm';
                    input.dataset.field = field; input.value = (subject[field] || '').replaceAll(',', '; ');
                    input.placeholder = '8; 7,5'; input.maxLength = 255; input.disabled = !subject.isEditable;
                    td.append(input); tr.append(td);
                });
                tbody.append(tr);
            });
            if (!data.diemMonHocs.length) message('Chưa có môn học được phân công.');
            save.disabled = !data.diemMonHocs.some(m => m.isEditable);
            baseline = JSON.stringify(readRows());
        } catch (error) { if (current === requestNumber) message(error.message); }
    }));
    save.addEventListener('click', async () => {
        if (save.disabled || !version) return;
        const rows = readRows();
        if (JSON.stringify(rows) === baseline) { modal.hide(); return; }
        if (!rows.length) return;
        const oldRows = JSON.parse(baseline);
        const clearsScores = rows.some(row => fields.some(field => !row[field] && oldRows.find(old => old.idMonHoc === row.idMonHoc)?.[field]));
        if (clearsScores && !confirm('Một số ô điểm đã được xóa trắng. Lưu sẽ xóa điểm cũ ở các ô này. Tiếp tục?')) return;
        save.disabled = true;
        const spinner = save.querySelector('.spinner-border'); spinner.classList.remove('d-none');
        try {
            const data = await readResponse(await fetch('/KetQuaHocTap/LuuDiemHocSinh', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                body: JSON.stringify({
                    idHocSinh: Number(document.getElementById('modalStudentId').value),
                    idHocKy: Number(document.getElementById('modalHocKyId').value),
                    idNamHoc: Number(document.getElementById('modalNamHocId').value), version, diemMonHocs: rows
                })
            }));
            if (data.success) window.location.reload();
        } catch (error) { alert(error.message); }
        finally { save.disabled = false; spinner.classList.add('d-none'); }
    });
});
</script>
}