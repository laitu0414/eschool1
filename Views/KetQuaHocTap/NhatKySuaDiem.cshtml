@model List<eSchool.Models.NhatKyHoatDong>
@{
    Layout = "~/Views/Shared/_ResultLayout.cshtml";
    ViewData["Title"] = "Lịch sử sửa điểm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 text-dark fw-bold">Nhật ký sửa điểm</h4>
        <p class="text-muted mb-0">Theo dõi các lịch sử thay đổi bảng điểm từ Admin</p>
    </div>
    <a href="/KetQuaHocTap/Diem" class="btn btn-outline-secondary px-4">
        <i class="bi bi-arrow-left me-2"></i> Quay lại
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 20%;">Thời gian</th>
                        <th style="width: 15%;">Hành động</th>
                        <th style="width: 20%;">Người thực hiện</th>
                        <th style="width: 45%;">Nội dung chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">
                                <div class="mb-3"><i class="bi bi-journal-x text-secondary" style="font-size: 3rem;"></i></div>
                                <span class="fs-5">Chưa có lịch sử thay đổi điểm nào.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="text-muted"><i class="bi bi-clock me-1"></i> @log.ThoiGian.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                </td>
                                <td>
                                    @if(log.HanhDong == "Nhập điểm")
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-2">@log.HanhDong</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">@log.HanhDong</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary text-white rounded-circle d-flex justify-content-center align-items-center me-2" style="width: 32px; height: 32px; font-weight: bold;">
                                            @log.TenDangNhap.Substring(0, 1).ToUpper()
                                        </div>
                                        <span class="fw-medium">@log.TenDangNhap</span>
                                    </div>
                                </td>
                                <td class="text-secondary pe-4">
                                    @log.NoiDung
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
