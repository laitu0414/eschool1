@using eSchool.Models
@using Microsoft.AspNetCore.Http
@model eSchool.ViewModels.HocPhiPageViewModel
@{
    Layout = Context.Session.GetInt32("RoleId") switch { 1 => "~/Views/Shared/_AdminLayout.cshtml", 4 => "~/Views/Shared/_ParentLayout.cshtml", _ => "~/Views/Shared/_StudentLayout.cshtml" };
    ViewData["Title"] = "Học phí";

    var hocSinh = ViewBag.HocSinh as HocSinh;
    int tongKhoan = Model.DanhSach.Count;
    int daDong = Model.DanhSach.Count(x => x.TrangThai == 1);
    int chuaDong = Model.DanhSach.Count(x => x.TrangThai == 0);
    int quaHan = Model.DanhSach.Count(x => x.TrangThai == 2);

    string Status(int value) => value == 1 ? "Đã đóng" : value == 2 ? "Quá hạn" : "Chưa đóng";
}

<div class="student-fee-page">
    <div class="student-fee-hero">
        <div>
            <span class="student-fee-eyebrow">Tài chính</span>
            <h2>Học phí của bạn</h2>
            <p>Theo dõi các khoản học phí và thanh toán trực tiếp ngay trên hệ thống.</p>
        </div>
        <div class="student-fee-hero-meta">
            <strong>@(hocSinh?.HoTen ?? "Học sinh")</strong>
            <small>@(hocSinh?.LopHoc?.TenLop ?? "Chưa xếp lớp")</small>
        </div>
    </div>

    <div class="student-fee-stats">
        <div class="student-fee-stat-card">
            <span>Tổng khoản</span>
            <strong>@tongKhoan</strong>
        </div>
        <div class="student-fee-stat-card success">
            <span>Đã đóng</span>
            <strong>@daDong</strong>
        </div>
        <div class="student-fee-stat-card warning">
            <span>Chưa đóng</span>
            <strong>@chuaDong</strong>
        </div>
        <div class="student-fee-stat-card danger">
            <span>Quá hạn</span>
            <strong>@quaHan</strong>
        </div>
    </div>

    <div class="student-fee-panel">
        <div class="student-fee-panel-head">
            <div>
                <h3>Danh sách học phí</h3>
                <p>Bạn có thể lọc nhanh theo trạng thái hoặc năm học.</p>
            </div>
        </div>

        <form method="get" class="student-fee-filter">
            <select name="trangThai" class="form-select">
                <option value="">Tất cả trạng thái</option>
                <option value="0" selected="@(ViewBag.TrangThai?.ToString() == "0" ? "selected" : null)">Chưa đóng</option>
                <option value="1" selected="@(ViewBag.TrangThai?.ToString() == "1" ? "selected" : null)">Đã đóng</option>
                <option value="2" selected="@(ViewBag.TrangThai?.ToString() == "2" ? "selected" : null)">Quá hạn</option>
            </select>
            <select name="namHocId" asp-items="Model.NamHocs" class="form-select">
                <option value="">Tất cả năm học</option>
            </select>
            <button class="btn btn-primary" type="submit">
                <i class="bi bi-funnel me-1"></i>Lọc
            </button>
            <a asp-action="XemHocPhi" class="btn btn-light">Đặt lại</a>
        </form>

        <div class="table-responsive">
            <table class="table student-fee-table align-middle">
                <thead>
                    <tr>
                        <th>Năm học</th>
                        <th>Học kỳ</th>
                        @if (Context.Session.GetInt32("RoleId") == 4)
                        {
                            <th>Số tiền</th>
                            <th class="text-end">Thanh toán</th>
                        }
                        else
                        {
                            <th>Trạng thái</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.DanhSach.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">Chưa có khoản học phí nào.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.DanhSach)
                        {
                            <tr>
                                <td>@item.NamHoc?.TenNamHoc</td>
                                <td>@(item.HocKyInfo?.TenHocKy ?? item.HocKy)</td>
                                @if (Context.Session.GetInt32("RoleId") == 4)
                                {
                                    <td class="student-fee-money">@item.SoTien.ToString("N0") đ</td>
                                    <td class="text-end">
                                        @if (item.TrangThai == 1)
                                        {
                                            <span class="student-fee-paid-label text-success"><i class="bi bi-check-circle-fill me-1"></i>Đã thanh toán</span>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#payModal_@item.IdHocPhi">
                                                <i class="bi bi-credit-card me-1"></i>Thanh toán
                                            </button>
                                        }
                                    </td>
                                }
                                else
                                {
                                    <td>
                                        <span class="student-fee-badge @(item.TrangThai == 1 ? "success" : item.TrangThai == 2 ? "danger" : "warning")">
                                            @Status(item.TrangThai)
                                        </span>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Context.Session.GetInt32("RoleId") == 4)
{
    @foreach (var item in Model.DanhSach.Where(x => x.TrangThai != 1))
    {
        <div class="modal fade" id="payModal_@item.IdHocPhi" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow" style="border-radius: 12px; overflow: hidden;">
                    <div class="modal-header text-white" style="background: linear-gradient(90deg, #ff5722 0%, #f44336 100%); border-bottom: none;">
                        <h5 class="modal-title fw-bold">Chọn phương thức thanh toán</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="p-3 mb-4" style="background: #fffcf5; border: 1px solid #ffecb3; border-radius: 8px;">
                            <div class="mb-3">
                                <small class="text-muted d-block">Năm học</small>
                                <strong class="fs-6 text-dark">@item.NamHoc?.TenNamHoc</strong>
                            </div>
                            <div class="mb-3">
                                <small class="text-muted d-block">Học kỳ</small>
                                <strong class="fs-6 text-dark">@(item.HocKyInfo?.TenHocKy ?? item.HocKy)</strong>
                            </div>
                            <div class="pt-2" style="border-top: 1px dashed #e0e0e0;">
                                <small class="text-muted d-block">Số tiền thanh toán</small>
                                <strong class="fs-3" style="color: #d32f2f;">@item.SoTien.ToString("N0") <span class="fs-5 text-decoration-underline">đ</span></strong>
                            </div>
                        </div>

                        <form asp-action="DongHocPhi" asp-route-id="@item.IdHocPhi" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="phuongThuc" value="VNPAY" />
                            <button type="submit" class="btn w-100 mb-3 py-3 fw-bold text-white shadow-sm" style="background: linear-gradient(90deg, #1976d2 0%, #7b1fa2 100%); border: none; border-radius: 8px;">
                                <i class="bi bi-credit-card me-2"></i>Thanh toán Online (VNPAY)
                            </button>
                        </form>

                        <div class="alert mb-0" style="background-color: #f5f8fc; border: none; color: #5c728e; border-radius: 8px;">
                            <i class="bi bi-info-circle me-1 text-primary"></i> <strong>Thanh toán Online:</strong> Bạn sẽ được chuyển đến trang VNPAY để chọn ngân hàng và hoàn tất thanh toán.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
